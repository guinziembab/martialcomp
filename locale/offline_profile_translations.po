# Templates - offline_profile.html
msgid "Profil hors-ligne"
msgstr "Offline profile"

msgid "Ce QR code contient toutes les informations de votre profil de pratiquant. Il peut être scanné sans connexion internet pour vérifier votre identité lors des événements."
msgstr "This QR code contains all your practitioner profile information. It can be scanned without an internet connection to verify your identity during events."

msgid "Informations sur le profil hors-ligne"
msgstr "Offline profile information"

msgid "Ce QR code contient un token sécurisé avec vos informations de profil pour une utilisation hors-ligne."
msgstr "This QR code contains a secure token with your profile information for offline use."

msgid "Copier"
msgstr "Copy"

msgid "Copié!"
msgstr "Copied!"

msgid "Généré le"
msgstr "Generated on"

msgid "Valable jusqu'au"
msgstr "Valid until"

msgid "Retour au QR code standard"
msgstr "Back to standard QR code"

msgid "Prévisualiser"
msgstr "Preview"

msgid "Télécharger QR Code"
msgstr "Download QR Code"

