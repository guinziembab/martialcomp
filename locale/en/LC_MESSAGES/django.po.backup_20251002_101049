msgid "Comment la sécurité de mes données est-elle assurée ?"
msgstr "How is the security of my data ensured?"

#: .\competitions\templates\competitions\welcome.html:1353
msgid ""
"Vos données sont hébergées en Europe, chiffrées et sauvegardées quotidiennement. L'accès est protégé par "
"authentification forte."
msgstr ""
"Your data is hosted in Europe, encrypted and backed up daily. Access is protected by strong authentication."

