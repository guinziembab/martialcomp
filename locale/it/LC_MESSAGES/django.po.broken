msgid 'Vous n'avez pas encore d'?l?ves. Commencez par ajouter votre premier ?l?ve.'
msgstr 'You don't have any students yet. Start by adding your first student.'

#. # TODO: Translate this string
msgid 'Vous n'avez pas encore de clients enregistr?s.'
msgstr 'You do not yet have any registered customers.'

#. # TODO: Translate this string
