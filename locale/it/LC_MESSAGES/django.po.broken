msgstr 'Generare'

msgid 'Cliquez sur Générer pour obtenir un numéro unique selon la discipline, le club et la date de naissance.'
msgstr 'Clicca su Genera per ottenere un numero unico in base alla disciplina, al club e alla data di nascita.'

msgid 'Veuillez sélectionner au moins une discipline pour le pratiquant.'
msgstr 'Seleziona almeno una disciplina per il praticante.'

msgid 'Un ou plusieurs champs nécessaires sont introuvables dans le formulaire (date de naissance, disciplines, nom de famille).'
msgstr 'Uno o più campi necessari non sono stati trovati nel modulo (data di nascita, discipline, cognome).'

msgid 'Veuillez renseigner la date de naissance, sélectionner au moins une discipline et indiquer le nom de famille.'
msgstr 'Inserisci la data di nascita, seleziona almeno una disciplina e indica il cognome.'

msgid 'Génération...'
msgstr 'Generazione...'

msgid 'Généré'
msgstr 'Generato'

msgid 'Erreur lors de la génération du numéro :'
msgstr 'Errore durante la generazione del numero:'

msgid 'Réponse inattendue du serveur'
msgstr 'Risposta inattesa del server'

msgid 'Erreur lors de la génération du numéro de licence :'
msgstr 'Errore durante la generazione del numero di licenza:'

#~ msgid 'Les résultats ont été publiés.'
#~ msgstr 'I risultati sono stati pubblicati.'
