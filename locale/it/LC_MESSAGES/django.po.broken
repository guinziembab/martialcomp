msgstr 'Non ci sono ancora soci nel tuo club. Inizia ad aggiungere il tuo primo socio!'

#. # TODO: Translate this string
msgid 'Vous n'avez pas encore de profil coach configur?.'
msgstr 'Non hai ancora configurato il tuo profilo di coach?'

