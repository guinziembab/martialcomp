"""
Fichier de configuration Passenger pour Plesk
Ce fichier doit être placé à la racine du projet en production
Renommer en passenger_wsgi.py lors du déploiement
"""
import sys
import os

# Ajouter le chemin du projet au PYTHONPATH
sys.path.insert(0, os.path.dirname(__file__))

# Définir la variable d'environnement pour les settings Django
os.environ['DJANGO_SETTINGS_MODULE'] = 'config.settings.production'

# Importer l'application WSGI
from config.wsgi import application

# Passenger cherche une variable 'application'
# Elle est déjà définie par l'import ci-dessus