# URGENT FIX - Redirection Apache pour bloquer l'accès aux practitioners
# À ajouter dans /var/www/vhosts/martialcomp.com/httpdocs/.htaccess

# Redirection immédiate des URLs practitioner vers l'admin général
RedirectMatch 301 ^/fr/admin/competitions/practitioner/?.*$ /fr/admin/
RedirectMatch 301 ^/en/admin/competitions/practitioner/?.*$ /en/admin/
RedirectMatch 301 ^/admin/competitions/practitioner/?.*$ /admin/

# Redirection pour toutes les variantes possibles
RedirectMatch 301 ^/.*admin.*practitioner.*$ /fr/admin/

# Log des accès bloqués (optionnel)
RewriteEngine On
RewriteCond %{REQUEST_URI} practitioner
RewriteRule ^(.*)$ /fr/admin/ [R=301,L]