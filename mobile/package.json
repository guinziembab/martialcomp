  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@types/jest": "^29.5.4",
    "@types/react": "~18.2.14",
    "@types/react-native": "~0.72.2",
    "@types/react-native-vector-icons": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
