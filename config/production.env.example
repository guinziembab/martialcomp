# Configuration d'environnement pour la production MartialComp
# Copiez ce fichier vers production.env et remplissez les valeurs

# ================================
# DJANGO CONFIGURATION
# ================================
SECRET_KEY=your-very-long-random-secret-key-here-change-this-in-production
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings_production

# ================================
# SERVEUR ET DOMAINE
# ================================
DOMAIN_NAME=martialcomp.com
SERVER_IP=your-digitalocean-droplet-ip
SITE_URL=https://martialcomp.com

# ================================
# BASE DE DONNÉES POSTGRESQL
# ================================
DB_NAME=martialcomp_prod
DB_USER=martialcomp_user
DB_PASSWORD=your-very-strong-database-password
DB_HOST=localhost
DB_PORT=5432

# ================================
# REDIS CACHE (OPTIONNEL)
# ================================
REDIS_URL=redis://127.0.0.1:6379/1

# ================================
# EMAIL CONFIGURATION
# ================================
# Configuration Gmail (exemple)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@martialcomp.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=MartialComp <noreply@martialcomp.com>

# Email administrateur pour les erreurs
ADMIN_EMAIL=admin@martialcomp.com

# ================================
# SÉCURITÉ
# ================================
# Générez une clé forte avec: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data

# ================================
# STOCKAGE ET FICHIERS
# ================================
# Limite de taille pour les uploads (en bytes)
MAX_UPLOAD_SIZE=5242880

# ================================
# MONITORING ET LOGS
# ================================
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# ================================
# INTÉGRATIONS TIERCES
# ================================
# Stripe pour les paiements (si utilisé)
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# SMS API (si utilisé)
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# ================================
# BACKUP ET MAINTENANCE
# ================================
BACKUP_RETENTION_DAYS=30
MAINTENANCE_MODE=False

# ================================
# ANALYTICS (OPTIONNEL)
# ================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ================================
# SOCIAL AUTH (SI UTILISÉ)
# ================================
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret