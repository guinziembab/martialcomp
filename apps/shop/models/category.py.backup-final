from django.db import models
from django.utils.translation import gettext_lazy as _
from django.utils.text import slugify


class Category(models.Model):
    """
    Catégorie de produits hiérarchique.
    Implémentation simplifiée de la hiérarchie sans MPTT.
    """
    name = models.CharField(_("Nom"), max_length=100)
    slug = models.SlugField(_("Slug"), max_length=120, unique=True)
    description = models.TextField(_("Description"), blank=True)
    
    # Structure hiérarchique
    parent = models.ForeignKey(
        'self', 
        on_delete=models.CASCADE, 
        null=True, 
        blank=True, 
        related_name='children',
        verbose_name=_("Catégorie parente")
    )
    
    # Relations avec les disciplines
    disciplines = models.ManyToManyField(
        'competitions.Discipline', 
        blank=True,
        related_name='product_categories',
        verbose_name=_("Disciplines associées")
    )
    
    # Métadonnées
    is_active = models.BooleanField(_("Active"), default=True)
    meta_title = models.CharField(_("Meta titre"), max_length=150, blank=True)
    meta_description = models.TextField(_("Meta description"), blank=True)
    
    # Images
    image = models.ImageField(
        _("Image"), 
        upload_to='shop/categories/', 
        blank=True, 
        null=True
    )
    
    # Ordre d'affichage
    order = models.PositiveIntegerField(_("Ordre d'affichage"), default=0)
    
    # Dates
    created_at = models.DateTimeField(_("Créé le"), auto_now_add=True)
    updated_at = models.DateTimeField(_("Mis Ã  jour le"), auto_now=True)
    
    class Meta:
        verbose_name = _("Catégorie")
        verbose_name_plural = _("Catégories")
        ordering = ['order', 'name']
    
    def __str__(self):
        return self.name
    
    def save(self, *args, **kwargs):
        # Générer le slug automatiquement si non fourni
        if not self.slug:
            self.slug = slugify(self.name)
        super().save(*args, **kwargs)
    
    @property
    def full_name(self):
        """Retourne le chemin complet de la catégorie."""
        parts = [self.name]
        parent = self.parent
        
        while parent:
            parts.insert(0, parent.name)
            parent = parent.parent
            
        return ' > '.join(parts)
    
    def get_ancestors(self, include_self=False):
        """Retourne toutes les catégories parentes."""
        ancestors = []
        parent = self.parent
        
        while parent:
            ancestors.insert(0, parent)
            parent = parent.parent
        
        if include_self:
            ancestors.append(self)
            
        return ancestors
    
    def get_descendants(self):
        """Retourne toutes les sous-catégories."""
        descendants = list(self.children.all())
        
        for child in self.children.all():
            descendants.extend(child.get_descendants())
            
        return descendants
    
    def get_products(self):
        """Retourne tous les produits de cette catégorie et de ses sous-catégories."""
        from .product import Product  # Import ici pour éviter les imports circulaires
        
        # Récupérer toutes les sous-catégories
        descendants = self.get_descendants()
        category_ids = [self.id] + [category.id for category in descendants]
        
        # Filtrer les produits par catégories
        return Product.objects.filter(
            categories__id__in=category_ids,
            is_active=True
        )

