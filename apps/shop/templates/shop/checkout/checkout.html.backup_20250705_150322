{% extends 'shop/base.html' %}
{% load i18n %}

{% block shop_title %}{% trans "Finaliser votre commande" %}{% endblock %}
{% block shop_subtitle %}{% trans "Complétez vos informations pour valider votre commande" %}{% endblock %}

{% block shop_content %}
<div class="row">
    <div class="col-lg-8">
        <!-- Checkout form -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">{% trans "Informations de livraison" %}</h5>
            </div>
            <div class="card-body">
                <form method="post" id="checkout-form">
                    {% csrf_token %}
                    
                    <!-- Address information -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="{{ form.first_name.id_for_label }}" class="form-label">
                                {% trans "Prénom" %} *
                            </label>
                            {{ form.first_name }}
                            {% if form.first_name.errors %}
                            <div class="text-danger">
                                {% for error in form.first_name.errors %}
                                    {{ error }}
                                {% endfor %}
                            </div>
                            {% endif %}
                        </div>
                        <div class="col-md-6">
                            <label for="{{ form.last_name.id_for_label }}" class="form-label">
                                {% trans "Nom" %} *
                            </label>
                            {{ form.last_name }}
                            {% if form.last_name.errors %}
                            <div class="text-danger">
                                {% for error in form.last_name.errors %}
                                    {{ error }}
                                {% endfor %}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="{{ form.email.id_for_label }}" class="form-label">
                            {% trans "Email" %} *
                        </label>
                        {{ form.email }}
                        {% if form.email.errors %}
                        <div class="text-danger">
                            {% for error in form.email.errors %}
                                {{ error }}
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    
                    <div class="mb-3">
                        <label for="{{ form.phone.id_for_label }}" class="form-label">
                            {% trans "Téléphone" %} *
                        </label>
                        {{ form.phone }}
                        {% if form.phone.errors %}
                        <div class="text-danger">
                            {% for error in form.phone.errors %}
                                {{ error }}
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    
                    <div class="mb-3">
                        <label for="{{ form.address_line1.id_for_label }}" class="form-label">
                            {% trans "Adresse" %} *
                        </label>
                        {{ form.address_line1 }}
                        {% if form.address_line1.errors %}
                        <div class="text-danger">
                            {% for error in form.address_line1.errors %}
                                {{ error }}
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    
                    <div class="mb-3">
                        <label for="{{ form.address_line2.id_for_label }}" class="form-label">
                            {% trans "Complément d'adresse" %}
                        </label>
                        {{ form.address_line2 }}
                        {% if form.address_line2.errors %}
                        <div class="text-danger">
                            {% for error in form.address_line2.errors %}
                                {{ error }}
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="{{ form.postal_code.id_for_label }}" class="form-label">
                                {% trans "Code postal" %} *
                            </label>
                            {{ form.postal_code }}
                            {% if form.postal_code.errors %}
                            <div class="text-danger">
                                {% for error in form.postal_code.errors %}
                                    {{ error }}
                                {% endfor %}
                            </div>
                            {% endif %}
                        </div>
                        <div class="col-md-6">
                            <label for="{{ form.city.id_for_label }}" class="form-label">
                                {% trans "Ville" %} *
                            </label>
                            {{ form.city }}
                            {% if form.city.errors %}
                            <div class="text-danger">
                                {% for error in form.city.errors %}
                                    {{ error }}
                                {% endfor %}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="{{ form.country.id_for_label }}" class="form-label">
                            {% trans "Pays" %} *
                        </label>
                        {{ form.country }}
                        {% if form.country.errors %}
                        <div class="text-danger">
                            {% for error in form.country.errors %}
                                {{ error }}
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    
                    <div class="mb-3">
                        <label for="{{ form.notes.id_for_label }}" class="form-label">
                            {% trans "Notes de commande" %}
                        </label>
                        {{ form.notes }}
                        {% if form.notes.errors %}
                        <div class="text-danger">
                            {% for error in form.notes.errors %}
                                {{ error }}
                            {% endfor %}
                        </div>
                        {% endif %}
                        <div class="form-text">
                            {% trans "Instructions spéciales pour la livraison ou toute autre information utile." %}
                        </div>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Shipping options -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">{% trans "Mode de livraison" %}</h5>
            </div>
            <div class="card-body">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="shipping_method" 
                           id="shipping_standard" value="standard" checked>
                    <label class="form-check-label" for="shipping_standard">
                        <div class="fw-bold">{% trans "Livraison standard" %}</div>
                        <div class="text-muted">{% trans "3-5 jours ouvrés" %}</div>
                        <div class="price">{{ shipping_standard_price }}</div>
                    </label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="shipping_method" 
                           id="shipping_express" value="express">
                    <label class="form-check-label" for="shipping_express">
                        <div class="fw-bold">{% trans "Livraison express" %}</div>
                        <div class="text-muted">{% trans "1-2 jours ouvrés" %}</div>
                        <div class="price">{{ shipping_express_price }}</div>
                    </label>
                </div>
                {% if pickup_available %}
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="shipping_method" 
                           id="shipping_pickup" value="pickup">
                    <label class="form-check-label" for="shipping_pickup">
                        <div class="fw-bold">{% trans "Retrait en club" %}</div>
                        <div class="text-muted">{% trans "Gratuit - Selon horaires d'ouverture" %}</div>
                        <div class="price">0,00 €</div>
                    </label>
                </div>
                {% endif %}
            </div>
        </div>
        
        <!-- Payment options -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">{% trans "Mode de paiement" %}</h5>
            </div>
            <div class="card-body">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="payment_method" 
                           id="payment_card" value="card" checked>
                    <label class="form-check-label" for="payment_card">
                        <div class="fw-bold">{% trans "Carte bancaire" %}</div>
                        <div class="d-flex align-items-center mt-1">
                            <i class="fab fa-cc-visa fa-2x me-2"></i>
                            <i class="fab fa-cc-mastercard fa-2x me-2"></i>
                            <i class="fab fa-cc-amex fa-2x"></i>
                        </div>
                    </label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="payment_method" 
                           id="payment_paypal" value="paypal">
                    <label class="form-check-label" for="payment_paypal">
                        <div class="fw-bold">PayPal</div>
                        <div class="d-flex align-items-center mt-1">
                            <i class="fab fa-paypal fa-2x"></i>
                        </div>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="payment_method" 
                           id="payment_bank_transfer" value="bank_transfer">
                    <label class="form-check-label" for="payment_bank_transfer">
                        <div class="fw-bold">{% trans "Virement bancaire" %}</div>
                        <div class="text-muted">{% trans "Les coordonnées bancaires vous seront communiquées par email" %}</div>
                    </label>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <!-- Order summary -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">{% trans "Résumé de commande" %}</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>{% trans "Sous-total" %}</span>
                    <span>{{ cart_subtotal_display }}</span>
                </div>
                
                {% if cart.discount_amount %}
                <div class="d-flex justify-content-between mb-2 text-success">
                    <span>{% trans "Remise" %}</span>
                    <span>-{{ cart.discount_amount_display }}</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span>{% trans "Code promo" %}</span>
                    <span>{{ cart.coupon_code }}</span>
                </div>
                {% endif %}
                
                <div class="d-flex justify-content-between mb-2">
                    <span>{% trans "Frais de livraison" %}</span>
                    <span id="shipping-cost">{{ cart.shipping_cost_display|default:"À calculer" }}</span>
                </div>
                
                <hr>
                
                <div class="d-flex justify-content-between mb-3 fw-bold">
                    <span>{% trans "Total" %}</span>
                    <span class="h5 mb-0" id="order-total">{{ cart_total_display }}</span>
                </div>
                
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="terms_agreed" 
                           id="terms_agreed" required>
                    <label class="form-check-label" for="terms_agreed">
                        {% trans "J'accepte les" %} <a href="#" target="_blank">{% trans "conditions générales de vente" %}</a>
                    </label>
                </div>
                
                <div class="d-grid">
                    <button type="button" id="place-order-btn" class="btn btn-primary btn-lg">
                        <i class="fas fa-lock me-2"></i> {% trans "Valider ma commande" %}
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Order items -->
        <div class="card">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">{% trans "Articles" %} ({{ cart_count }})</h5>
                    <a class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" 
                       href="#collapseOrderItems" role="button" aria-expanded="false">
                        <i class="fas fa-chevron-down"></i>
                    </a>
                </div>
            </div>
            <div class="collapse show" id="collapseOrderItems">
                <ul class="list-group list-group-flush">
                    {% for item in cart_items %}
                    <li class="list-group-item py-2">
                        <div class="row align-items-center">
                            <div class="col-3">
                                {% if item.product.main_image %}
                                <img src="{{ item.product.main_image.url }}" alt="{{ item.product.name }}" 
                                     class="img-fluid rounded">
                                {% else %}
                                <img src="{{ MEDIA_URL }}shop/images/placeholder.png" alt="{{ item.product.name }}" 
                                     class="img-fluid rounded">
                                {% endif %}
                            </div>
                            <div class="col-6">
                                <h6 class="mb-0">{{ item.product.name }}</h6>
                                {% if item.variation %}
                                <p class="mb-0 small text-muted">{{ item.variation.get_full_name }}</p>
                                {% endif %}
                                <span class="badge bg-secondary">{{ item.quantity }}</span>
                            </div>
                            <div class="col-3 text-end">
                                <span class="fw-bold">{{ item.total_price_display }}</span>
                            </div>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
{{ block.super }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle shipping method change
        const shippingMethods = document.querySelectorAll('input[name="shipping_method"]');
        const shippingCost = document.getElementById('shipping-cost');
        const orderTotal = document.getElementById('order-total');
        const standardPrice = {{ shipping_standard_price_value }};
        const expressPrice = {{ shipping_express_price_value }};
        const subtotal = {{ cart_subtotal_value }};
        const discount = {{ cart.discount_amount|default:0 }};
        
        shippingMethods.forEach(method => {
            method.addEventListener('change', function() {
                let shippingValue = 0;
                
                if (this.value === 'standard') {
                    shippingValue = standardPrice;
                    shippingCost.textContent = '{{ shipping_standard_price }}';
                } else if (this.value === 'express') {
                    shippingValue = expressPrice;
                    shippingCost.textContent = '{{ shipping_express_price }}';
                } else if (this.value === 'pickup') {
                    shippingValue = 0;
                    shippingCost.textContent = '0,00 €';
                }
                
                const total = subtotal - discount + shippingValue;
                orderTotal.textContent = new Intl.NumberFormat('fr-FR', { 
                    style: 'currency', 
                    currency: 'EUR' 
                }).format(total);
            });
        });
        
        // Handle place order button
        const checkoutForm = document.getElementById('checkout-form');
        const placeOrderBtn = document.getElementById('place-order-btn');
        const termsCheckbox = document.getElementById('terms_agreed');
        
        placeOrderBtn.addEventListener('click', function() {
            if (!termsCheckbox.checked) {
                alert('{% trans "Veuillez accepter les conditions générales de vente." %}');
                return;
            }
            
            // Add shipping and payment methods to form
            const shippingMethod = document.querySelector('input[name="shipping_method"]:checked').value;
            const paymentMethod = document.querySelector('input[name="payment_method"]:checked').value;
            
            const shippingInput = document.createElement('input');
            shippingInput.type = 'hidden';
            shippingInput.name = 'shipping_method';
            shippingInput.value = shippingMethod;
            
            const paymentInput = document.createElement('input');
            paymentInput.type = 'hidden';
            paymentInput.name = 'payment_method';
            paymentInput.value = paymentMethod;
            
            const termsInput = document.createElement('input');
            termsInput.type = 'hidden';
            termsInput.name = 'terms_agreed';
            termsInput.value = 'on';
            
            checkoutForm.appendChild(shippingInput);
            checkoutForm.appendChild(paymentInput);
            checkoutForm.appendChild(termsInput);
            
            checkoutForm.submit();
        });
    });
</script>
{% endblock %}