{% extends 'shop/base.html' %}
{% load i18n %}

{% block shop_title %}{% trans "Simulateur PayPal" %}{% endblock %}
{% block shop_subtitle %}{% trans "Pour démonstration uniquement" %}{% endblock %}

{% block extra_css %}
{{ block.super }}
<style>
    .paypal-header {
        background-color: #003087;
        color: white;
        padding: 15px 0;
    }
    .paypal-logo {
        font-size: 24px;
        font-weight: bold;
        color: white;
        text-decoration: none;
    }
    .paypal-logo span:first-child {
        color: #0070e0;
    }
    .paypal-logo span:last-child {
        color: #1546a0;
    }
    .paypal-container {
        max-width: 500px;
        margin: 0 auto;
    }
    .payment-summary {
        background-color: #f5f7fa;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }
    .paypal-button {
        background-color: #0070ba;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 10px 20px;
        font-weight: bold;
        width: 100%;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .paypal-button:hover {
        background-color: #003087;
    }
    .paypal-cancel {
        text-align: center;
        margin-top: 15px;
    }
</style>
{% endblock %}

{% block content %}
<div class="paypal-header">
    <div class="container">
        <div class="d-flex justify-content-center">
            <a href="#" class="paypal-logo">
                <i class="fab fa-paypal me-2"></i> PayPal
            </a>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="paypal-container">
        <div class="text-center mb-4">
            <h2 class="mb-3">{% trans "Finaliser le paiement" %}</h2>
            <p class="text-muted">{% trans "Ceci est une simulation de paiement PayPal à des fins de démonstration" %}</p>
        </div>
        
        <div class="payment-summary">
            <h5 class="mb-3">{% trans "Résumé de la transaction" %}</h5>
            
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-2">
                    <span>{% trans "Marchand" %}:</span>
                    <span>{{ order.club.name|default:order.federation.name|default:"MartialComp" }}</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>{% trans "Commande" %}:</span>
                    <span>#{{ order.reference }}</span>
                </div>
                <div class="d-flex justify-content-between mb-0">
                    <span>{% trans "Date" %}:</span>
                    <span>{{ order.created_at|date:"d/m/Y H:i" }}</span>
                </div>
            </div>
            
            <hr>
            
            <div class="d-flex justify-content-between align-items-center mb-0">
                <span class="h5 mb-0">{% trans "Total" %}</span>
                <span class="h4 mb-0">{{ order.total_display }}</span>
            </div>
        </div>
        
        <form method="post">
            {% csrf_token %}
            <button type="submit" class="paypal-button btn-lg">
                {% trans "Payer maintenant" %}
            </button>
        </form>
        
        <div class="paypal-cancel">
            <a href="{% url 'shop:order_detail' order.reference %}" class="text-decoration-none">
                {% trans "Annuler et revenir à la boutique" %}
            </a>
        </div>
    </div>
</div>
{% endblock %}