<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Résumé hebdomadaire - {{ family_name }}</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: #95E1D3; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0; }
        .content { background: #f9f9f9; padding: 20px; border-radius: 0 0 8px 8px; }
        .stats { display: flex; justify-content: space-around; margin: 20px 0; }
        .stat-card { background: white; padding: 15px; border-radius: 8px; text-align: center; flex: 1; margin: 0 5px; }
        .stat-number { font-size: 24px; font-weight: bold; color: #4ECDC4; }
        .event-list { background: white; padding: 15px; margin: 15px 0; border-radius: 8px; }
        .event-item { padding: 10px; margin: 5px 0; border-left: 3px solid #4ECDC4; padding-left: 15px; }
        .footer { text-align: center; color: #666; font-size: 12px; margin-top: 20px; }
        .btn { display: inline-block; background: #4ECDC4; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📊 {{ family_name }}</h1>
            <p>Résumé hebdomadaire</p>
            <p>{{ week_start|date:"d/m/Y" }} - {{ week_end|date:"d/m/Y" }}</p>
        </div>
        
        <div class="content">
            <h2>Bonjour {{ member.user.first_name }},</h2>
            
            <p>Voici le résumé de la semaine écoulée pour votre famille :</p>
            
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-number">{{ stats.total_events }}</div>
                    <div>Événements</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ stats.competitions }}</div>
                    <div>Compétitions</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ stats.family_events }}</div>
                    <div>Événements familiaux</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ stats.upcoming_payments }}</div>
                    <div>Paiements en attente</div>
                </div>
            </div>
            
            {% if upcoming_events %}
            <div class="event-list">
                <h3>🔮 Événements à venir (7 prochains jours)</h3>
                {% for event in upcoming_events %}
                <div class="event-item">
                    <strong>{{ event.title }}</strong><br>
                    <small>
                        📅 {{ event.start_date|date:"d/m/Y" }}
                        {% if event.start_time %} à {{ event.start_time|time:"H:i" }}{% endif %}
                        {% if event.location %} - 📍 {{ event.location }}{% endif %}
                        <br>
                        <span style="color: #666;">{{ event.type|title }}</span>
                        {% if event.days_until == 0 %}
                            <span style="color: #FF6B6B; font-weight: bold;">- Aujourd'hui !</span>
                        {% elif event.days_until == 1 %}
                            <span style="color: #FF6B6B;">- Demain</span>
                        {% else %}
                            <span style="color: #666;">- Dans {{ event.days_until }} jours</span>
                        {% endif %}
                    </small>
                </div>
                {% endfor %}
            </div>
            {% endif %}
            
            <div style="background: #d4edda; padding: 15px; border-radius: 8px; margin: 15px 0;">
                <h4>✨ Cette semaine en chiffres</h4>
                <ul>
                    <li>{{ family.get_active_members.count }} membres actifs dans la famille</li>
                    <li>{{ stats.total_events }} événements au total</li>
                    {% if stats.competitions > 0 %}
                    <li>{{ stats.competitions }} compétition{% if stats.competitions > 1 %}s{% endif %} - Bonne chance ! 🏆</li>
                    {% endif %}
                    {% if stats.upcoming_payments > 0 %}
                    <li>{{ stats.upcoming_payments }} paiement{% if stats.upcoming_payments > 1 %}s{% endif %} en attente</li>
                    {% endif %}
                </ul>
            </div>
            
            <div style="text-align: center; margin: 20px 0;">
                <a href="#" class="btn">Voir le calendrier complet</a>
            </div>
            
            <p style="text-align: center; color: #666; font-style: italic;">
                Bon début de semaine à toute la famille ! 👨‍👩‍👧‍👦
            </p>
        </div>
        
        <div class="footer">
            <p>Résumé généré le {{ timestamp|date:"d/m/Y à H:i" }}</p>
            <p>{{ family_name }} - MartialComp</p>
            <p><a href="#" style="color: #666;">Se désabonner</a> | <a href="#" style="color: #666;">Modifier les préférences</a></p>
        </div>
    </div>
</body>
</html>