"""
URLs spécifiques au processus d'onboarding
"""
from django.urls import path
from ..views import onboarding

app_name = 'onboarding'

urlpatterns = [
    # URL de démarrage d'onboarding
    path('', onboarding.onboarding_start, name='start'),
    
    # Sélection du rôle (URL PROBLÉMATIQUE DANS L'ERREUR 404)
    path('role/', onboarding.handle_role_selection, name='role_selection'),
    
    # Configuration selon le rôle
    path('club/creation/', onboarding.handle_club_creation, name='club_creation'),
    path('club/details/', onboarding.handle_club_details, name='club_details'),
    path('federation/', onboarding.handle_federation_creation, name='federation'),
    path('judge/', onboarding.handle_judge_profile, name='judge_profile'),
    path('participant/', onboarding.handle_participant_profile, name='participant_profile'),
    
    # Configuration des catégories et finalisation
    path('categories/setup/', onboarding.handle_categories_setup, name='categories_setup'),
    path('final/', onboarding.handle_final_setup, name='final_setup'),
    
    # Coach simplifié
    path('coach/simplified/', onboarding.handle_coach_simplified, name='coach_simplified'),
    path('coach/profile/', onboarding.coach_profile_simplified, name='coach_profile_simplified'),
]
