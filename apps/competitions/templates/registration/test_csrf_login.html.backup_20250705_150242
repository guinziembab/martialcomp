{% load i18n %}
<!DOCTYPE html>
<html>
<head>
    <title>{% trans "Test CSRF Login" %}</title>
</head>
<body>
    <h1>{% trans "Test CSRF Login Simple" %}</h1>
    
    <form method="post" action="/accounts/login/">
        {% csrf_token %}
        <p>
            <label>Username: <input type="text" name="username" required></label>
        </p>
        <p>
            <label>Password: <input type="password" name="password" required></label>
        </p>
        <p>
            <button type="submit">{% trans "Login" %}</button>
        </p>
    </form>
    
    <hr>
    
    <h2>{% trans "Test sans CSRF (pour vérification)" %}</h2>
    <form method="post" action="/auth/test-login-no-csrf/">
        <p>
            <label>Username: <input type="text" name="username" required></label>
        </p>
        <p>
            <label>Password: <input type="password" name="password" required></label>
        </p>
        <p>
            <button type="submit">{% trans "Login sans CSRF" %}</button>
        </p>
    </form>
</body>
</html>