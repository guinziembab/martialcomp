{% extends "base.html" %}
{% load i18n static %}

{% block title %}{% trans "Connexion" %} - MartialComp{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{% static 'css/auth.css' %}">
{% endblock %}

{% block content %}
<div class="auth-container">
    <div class="auth-header">
        <img src="{% static 'img/logo.png' %}" alt="MartialComp" class="auth-logo">
        <h1>{% trans "Connexion à MartialComp" %}</h1>
    </div>
    
    <!-- Section pour informations de profil contextuel -->
    {% if profile_info %}
    <div class="profile-info">
        <h2>{{ profile_info.role }}</h2>
        <div class="profile-meta">
            <span class="profile-location">{{ profile_info.location }}</span>
            <span class="profile-badge {{ profile_info.status_class }}">{{ profile_info.status }}</span>
        </div>
        {% if profile_info.valid_dates %}
        <div class="profile-dates">
            <span>{% trans "Valide du" %} {{ profile_info.valid_dates.start }} {% trans "au" %} {{ profile_info.valid_dates.end }}</span>
        </div>
        {% endif %}
    </div>
    {% endif %}
    
    {% if messages %}
        {% for message in messages %}
        <div class="alert {% if message.tags == 'error' %}alert-error{% else %}alert-success{% endif %}">
            {{ message }}
        </div>
        {% endfor %}
    {% endif %}
    
    {% if form.errors %}
    <div class="alert alert-error">
        {% trans "Nom d'utilisateur ou mot de passe incorrect. Veuillez réessayer." %}
    </div>
    {% endif %}
    
    <form method="post" class="auth-form">
        {% csrf_token %}
        <div class="form-group">
            <label for="id_username" class="form-label">{% trans "Nom d'utilisateur ou email" %}</label>
            <input type="text" name="username" id="id_username" class="form-control" 
                   placeholder="{% trans 'Votre nom d\'utilisateur ou email...' %}" required>
        </div>
        <div class="form-group">
            <label for="id_password" class="form-label">{% trans "Mot de passe" %}</label>
            <input type="password" name="password" id="id_password" class="form-control" 
                   placeholder="{% trans 'Votre mot de passe...' %}" required>
        </div>
        <button type="submit" class="btn-primary">{% trans "Se connecter" %}</button>
        <input type="hidden" name="next" value="{{ next|default:'/dashboard/' }}">
    </form>
    
    <div class="separator">{% trans "ou" %}</div>
    
    <div class="social-auth">
        <a href="/accounts/google/login/?process=login" class="btn-social btn-google">
            <svg width="18" height="18" viewBox="0 0 24 24">
                <path fill="#4285f4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34a853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#fbbc05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#ea4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            <span>{% trans "Continuer avec Google" %}</span>
        </a>
        
        <a href="/accounts/facebook/login/?process=login" class="btn-social btn-facebook">
            <svg width="18" height="18" viewBox="0 0 24 24">
                <path fill="#1877f2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>{% trans "Continuer avec Facebook" %}</span>
        </a>
        
        <a href="/accounts/apple/login/?process=login" class="btn-social btn-apple">
            <svg width="18" height="18" viewBox="0 0 24 24">
                <path fill="currentColor" d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            <span>{% trans "Continuer avec Apple" %}</span>
        </a>
    </div>
    
    <div class="auth-footer">
        <a href="{% url 'terms_of_service' %}">{% trans "Conditions d'utilisation" %}</a> &amp; 
        <a href="{% url 'privacy_policy' %}">{% trans "Politique de confidentialité" %}</a>
    </div>
    
    <div class="auth-register-link">
        <p>{% trans "Pas encore de compte ?" %} <a href="/accounts/signup/">{% trans "Créer un compte" %}</a></p>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Ajout d'un gestionnaire d'événements pour détecter les problèmes de soumission du formulaire
    document.querySelector('form').addEventListener('submit', function(e) {
        console.log('Formulaire soumis');
        
        // Si vous avez besoin de débogage supplémentaire
        localStorage.setItem('login_attempt', 'true');
    });
    
    // Vérifier si on vient d'une tentative de connexion précédente
    if (localStorage.getItem('login_attempt') === 'true') {
        console.log('Tentative de connexion précédente détectée');
        localStorage.removeItem('login_attempt');
    }
});
</script>
{% endblock %}