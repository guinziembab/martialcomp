{% extends "base.html" %}
{% load i18n %}

{% block title %}Login Debug - MartialComp{% endblock %}

{% block content %}
<div class="login-container" style="max-width: 600px; margin: 50px auto; padding: 20px; background-color: #1a1a1a; border-radius: 8px;">
    <h2 style="color: #d4af37; text-align: center;">{% trans "Login avec Débogage CSRF" %}</h2>
    
    <div style="background-color: #333; padding: 15px; margin: 20px 0; border-radius: 5px;">
        <h3 style="color: #d4af37;">{% trans "Informations de débogage:" %}</h3>
        <ul style="color: #f5f5f5;">
            <li>CSRF Token: {{ csrf_token|slice:":20" }}...</li>
            <li>CSRF Cookie: {{ debug_info.csrf_cookie|slice:":20" }}...</li>
            <li>Session ID: {{ debug_info.session_id }}</li>
            <li>Host: {{ debug_info.host }}</li>
            <li>Secure: {{ debug_info.is_secure }}</li>
        </ul>
    </div>
    
    <form method="post" action="{% url 'debug_login' %}">
        {% csrf_token %}
        <div style="margin-bottom: 15px;">
            <label for="username" style="color: #f5f5f5;">{% trans "Nom d'utilisateur" %}</label>
            <input type="text" name="username" id="username" required style="width: 100%; padding: 10px; margin-top: 5px;">
        </div>
        <div style="margin-bottom: 15px;">
            <label for="password" style="color: #f5f5f5;">{% trans "Mot de passe" %}</label>
            <input type="password" name="password" id="password" required style="width: 100%; padding: 10px; margin-top: 5px;">
        </div>
        <button type="submit" style="width: 100%; background-color: #c41e3a; color: white; padding: 12px; border: none; border-radius: 4px;">{% trans "Se connecter (Debug)" %}</button>
    </form>
    
    <div style="margin-top: 20px; text-align: center;">
        <a href="/accounts/login/" style="color: #d4af37;">{% trans "Retour au login normal" %}</a>
    </div>
</div>

<script>
console.log('CSRF Token from Django:', '{{ csrf_token }}');
console.log('Cookies:', document.cookie);
</script>
{% endblock %}