{% extends 'base.html' %}
{% load i18n %}
{% load account socialaccount %}
{% load custom_filters %}

{% block title %}{% trans "Créer un compte" %} - MartialComp{% endblock %}

{% block extra_css %}
<style>
    :root {
        --primary: #c41e3a;
        --accent: #d4af37;
        --dark: #121212;
        --light: #f8f9fa;
    }
    
    .auth-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(196, 30, 58, 0.1), rgba(212, 175, 55, 0.1));
    }
    
    .auth-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        padding: 2.5rem;
        width: 100%;
        max-width: 450px;
        border: 1px solid rgba(196, 30, 58, 0.1);
    }
    
    .auth-header {
        text-align: center;
        margin-bottom: 2rem;
    }
    
    .auth-header h1 {
        color: var(--primary);
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    
    .auth-header p {
        color: #6c757d;
        font-size: 1.1rem;
    }
    
    .form-group {
        margin-bottom: 1.5rem;
    }
    
    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: #333;
        font-weight: 500;
    }
    
    .form-control {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.3s ease;
    }
    
    .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 0.2rem rgba(196, 30, 58, 0.1);
        outline: none;
    }
    
    .btn-auth {
        width: 100%;
        padding: 0.875rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 1rem;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }
    
    .btn-primary-auth {
        background: var(--primary);
        color: white;
    }
    
    .btn-primary-auth:hover {
        background: #a01729;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(196, 30, 58, 0.3);
    }
    
    .social-divider {
        text-align: center;
        margin: 2rem 0;
        position: relative;
        color: #6c757d;
    }
    
    .social-divider::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background: #e9ecef;
        z-index: 1;
    }
    
    .social-divider span {
        background: white;
        padding: 0 1rem;
        position: relative;
        z-index: 2;
    }
    
    .btn-google {
        background: #4285f4;
        color: white;
    }
    
    .btn-google:hover {
        background: #357ae8;
        color: white;
    }
    
    .btn-facebook {
        background: #1877f2;
        color: white;
    }
    
    .btn-facebook:hover {
        background: #166fe5;
        color: white;
    }
    
    .auth-links {
        text-align: center;
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid #e9ecef;
    }
    
    .auth-links a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
        margin: 0 1rem;
    }
    
    .auth-links a:hover {
        color: var(--accent);
        text-decoration: underline;
    }
    
    .errorlist {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.2);
        border-radius: 6px;
        padding: 0.75rem;
        margin-bottom: 1rem;
        list-style: none;
    }
    
    .errorlist li {
        color: #dc3545;
        margin: 0;
    }
    
    .field-error {
        color: #dc3545;
        margin-top: 0.3rem;
        font-size: 0.9rem;
        display: block;
    }
    
    .form-control.error {
        border-color: #dc3545;
    }
    
    .alert {
        padding: 1rem;
        margin-bottom: 1.5rem;
        border-radius: 8px;
    }
    
    .alert-danger {
        background-color: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.2);
        color: #dc3545;
    }
    
    .alert-success {
        background-color: rgba(40, 167, 69, 0.1);
        border: 1px solid rgba(40, 167, 69, 0.2);
        color: #28a745;
    }
</style>
{% endblock %}

{% block content %}
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1>{% trans "MartialComp" %}</h1>
            <p>{% trans "Créer votre compte" %}</p>
        </div>
        
        {% if messages %}
        <div class="messages">
            {% for message in messages %}
            <div class="alert {% if message.tags %}alert-{{ message.tags }}{% else %}alert-info{% endif %}">
                {{ message }}
            </div>
            {% endfor %}
        </div>
        {% endif %}
        
        {% if form.non_field_errors %}
        <div class="alert alert-danger">
            {% for error in form.non_field_errors %}
                {{ error }}
            {% endfor %}
        </div>
        {% endif %}
        
        <form method="post" action="{% url 'account_signup' %}">
            {% csrf_token %}
            
            <div class="form-group">
                <label for="{{ form.username.id_for_label }}">{% trans "Nom d'utilisateur" %}</label>
                {{ form.username|add_class:"form-control"|add_error_class:"error" }}
                {% if form.username.errors %}
                    <span class="field-error">
                        {% for error in form.username.errors %}
                            {{ error }}
                        {% endfor %}
                    </span>
                {% endif %}
                {% if form.username.help_text %}
                    <small class="text-muted">{{ form.username.help_text }}</small>
                {% endif %}
            </div>
            
            <div class="form-group">
                <label for="{{ form.email.id_for_label }}">{% trans "Adresse email" %}</label>
                {{ form.email|add_class:"form-control"|add_error_class:"error" }}
                {% if form.email.errors %}
                    <span class="field-error">
                        {% for error in form.email.errors %}
                            {{ error }}
                        {% endfor %}
                    </span>
                {% endif %}
            </div>
            
            <div class="form-group">
                <label for="{{ form.password1.id_for_label }}">{% trans "Mot de passe" %}</label>
                {{ form.password1|add_class:"form-control"|add_error_class:"error" }}
                {% if form.password1.errors %}
                    <span class="field-error">
                        {% for error in form.password1.errors %}
                            {{ error }}
                        {% endfor %}
                    </span>
                {% endif %}
                {% if form.password1.help_text %}
                    <small class="text-muted">{{ form.password1.help_text }}</small>
                {% endif %}
            </div>
            
            <div class="form-group">
                <label for="{{ form.password2.id_for_label }}">{% trans "Confirmer le mot de passe" %}</label>
                {{ form.password2|add_class:"form-control"|add_error_class:"error" }}
                {% if form.password2.errors %}
                    <span class="field-error">
                        {% for error in form.password2.errors %}
                            {{ error }}
                        {% endfor %}
                    </span>
                {% endif %}
            </div>
            
            <button type="submit" class="btn-auth btn-primary-auth">
                <i class="fas fa-user-plus me-2"></i>
                {% trans "Créer mon compte" %}
            </button>
            
            {% if redirect_field_value %}
                <input type="hidden" name="{{ redirect_field_name }}" value="{{ redirect_field_value }}" />
            {% endif %}
        </form>
        
        <div class="social-divider">
            <span>{% trans "Ou inscrivez-vous avec" %}</span>
        </div>
        
        {% get_providers as socialaccount_providers %}
        {% for provider in socialaccount_providers %}
            {% if provider.id == "google" %}
                <a href="{% provider_login_url 'google' %}" class="btn-auth btn-google">
                    <i class="fab fa-google me-2"></i>
                    {% trans "S'inscrire avec Google" %}
                </a>
            {% elif provider.id == "facebook" %}
                <a href="{% provider_login_url 'facebook' %}" class="btn-auth btn-facebook">
                    <i class="fab fa-facebook-f me-2"></i>
                    {% trans "S'inscrire avec Facebook" %}
                </a>
            {% endif %}
        {% endfor %}
        
        <div class="auth-links">
            <a href="{% url 'account_login' %}">
                <i class="fas fa-sign-in-alt me-1"></i>
                {% trans "J'ai déjà un compte" %}
            </a>
            <a href="{% url 'welcome' %}">
                <i class="fas fa-home me-1"></i>
                {% trans "Retour à l'accueil" %}
            </a>
        </div>
    </div>
</div>
{% endblock %}