{% extends "organizations/sites/base_template.html" %}
{% load i18n %}

{% block title %}{{ organization.name }} - Club d'Arts Martiaux{% endblock %}

{% block extra_css %}
<style>
    .discipline-badge {
        background: linear-gradient(45deg, var(--primary-color), var(--accent-color));
        color: white;
        border: none;
    }
    
    .instructor-card {
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }
    
    .instructor-card:hover {
        transform: translateY(-5px);
    }
</style>
{% endblock %}

{% block hero_actions %}
<div class="d-flex gap-3 flex-wrap">
    <a href="#disciplines" class="btn btn-light btn-lg">
        <i class="fas fa-fist-raised me-2"></i>{% trans "Nos Disciplines" %}</a>
    <a href="#qr-codes" class="btn btn-warning btn-lg">
        <i class="fas fa-qrcode me-2"></i>{% trans "S'inscrire" %}</a>
    <a href="#contact" class="btn btn-outline-light btn-lg">
        <i class="fas fa-phone me-2"></i>{% trans "Contact" %}</a>
</div>
{% endblock %}

{% block main_content %}
<!-- Disciplines Section -->
<section id="disciplines" class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold">{% trans "Nos Disciplines" %}</h2>
                <p class="lead text-muted">{% trans "Découvrez les arts martiaux enseignés dans notre club" %}</p>
            </div>
        </div>
        
        <div class="row g-4">
            {% for discipline in disciplines %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ discipline.name }}</h5>
                        <p class="card-text">{{ discipline.description|truncatewords:20 }}</p>
                        <span class="badge discipline-badge">{% trans "Arts Martiaux" %}</span>
                    </div>
                </div>
            </div>
            {% empty %}
            <div class="col-12">
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>{% trans "Les disciplines seront bientôt affichées ici." %}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- QR Codes Section (from base template) -->
{{ block.super }}

<!-- Club Features -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold">{% trans "Pourquoi Choisir Notre Club ?" %}</h2>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-md-6 col-lg-3 text-center">
                <i class="fas fa-medal fa-3x text-primary mb-3"></i>
                <h5>{% trans "Instructeurs Qualifiés" %}</h5>
                <p class="text-muted">{% trans "Équipe d'instructeurs certifiés et expérimentés" %}</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <i class="fas fa-users fa-3x text-primary mb-3"></i>
                <h5>{% trans "Communauté" %}</h5>
                <p class="text-muted">{% trans "Rejoignez une communauté passionnée et bienveillante" %}</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <i class="fas fa-dumbbell fa-3x text-primary mb-3"></i>
                <h5>{% trans "Équipements" %}</h5>
                <p class="text-muted">{% trans "Installations modernes et équipements de qualité" %}</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <i class="fas fa-calendar-check fa-3x text-primary mb-3"></i>
                <h5>{% trans "Horaires Flexibles" %}</h5>
                <p class="text-muted">{% trans "Planning adapté à tous les emplois du temps" %}</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block extra_sections %}
<!-- Call to Action -->
<section class="py-5" style="background: linear-gradient(135deg, var(--primary-color), var(--accent-color));">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center text-white">
                <h2 class="display-5 fw-bold mb-4">{% trans "Prêt à Commencer ?" %}</h2>
                <p class="lead mb-4">{% trans "Rejoignez notre club et commencez votre parcours dans les arts martiaux" %}</p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a href="#qr-codes" class="btn btn-light btn-lg">
                        <i class="fas fa-qrcode me-2"></i>{% trans "S'inscrire Maintenant" %}</a>
                    <a href="#contact" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-phone me-2"></i>{% trans "Nous Appeler" %}</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}