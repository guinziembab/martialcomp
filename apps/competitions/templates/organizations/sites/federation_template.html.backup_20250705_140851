{% extends "organizations/sites/base_template.html" %}

{% block title %}{{ organization.name }} - Fédération d'Arts Martiaux{% endblock %}

{% block hero_actions %}
<div class="d-flex gap-3 flex-wrap">
    <a href="#clubs" class="btn btn-light btn-lg">
        <i class="fas fa-building me-2"></i>Nos Clubs
    </a>
    <a href="#competitions" class="btn btn-outline-light btn-lg">
        <i class="fas fa-trophy me-2"></i>Compétitions
    </a>
    <a href="#qr-codes" class="btn btn-warning btn-lg">
        <i class="fas fa-qrcode me-2"></i>Adhérer
    </a>
</div>
{% endblock %}

{% block main_content %}
<!-- Federation Stats -->
<section class="py-5" style="background: linear-gradient(135deg, var(--primary-color), var(--accent-color)); color: white;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-4">
                <h2 class="display-5 fw-bold text-white">Notre Fédération en Chiffres</h2>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-md-6 col-lg-3 text-center">
                <div class="p-4 rounded" style="background: rgba(255,255,255,0.1);">
                    <i class="fas fa-building fa-2x mb-3"></i>
                    <h3 class="fw-bold">50+</h3>
                    <p class="mb-0">Clubs Affiliés</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <div class="p-4 rounded" style="background: rgba(255,255,255,0.1);">
                    <i class="fas fa-users fa-2x mb-3"></i>
                    <h3 class="fw-bold">2000+</h3>
                    <p class="mb-0">Pratiquants</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <div class="p-4 rounded" style="background: rgba(255,255,255,0.1);">
                    <i class="fas fa-trophy fa-2x mb-3"></i>
                    <h3 class="fw-bold">25+</h3>
                    <p class="mb-0">Compétitions/An</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <div class="p-4 rounded" style="background: rgba(255,255,255,0.1);">
                    <i class="fas fa-award fa-2x mb-3"></i>
                    <h3 class="fw-bold">20+</h3>
                    <p class="mb-0">Années d'Expérience</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- QR Codes Section (from base template) -->
{{ block.super }}

<!-- Federation Services -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold">Services de la Fédération</h2>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-md-6 col-lg-3 text-center">
                <i class="fas fa-certificate fa-3x text-primary mb-3"></i>
                <h5>Certifications</h5>
                <p class="text-muted">Grades et certifications officielles</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <i class="fas fa-chalkboard-teacher fa-3x text-primary mb-3"></i>
                <h5>Formation</h5>
                <p class="text-muted">Formation des instructeurs et arbitres</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                <h5>Assurance</h5>
                <p class="text-muted">Protection et assurance des membres</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center">
                <i class="fas fa-handshake fa-3x text-primary mb-3"></i>
                <h5>Partenariats</h5>
                <p class="text-muted">Réseau national et international</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block extra_sections %}
<!-- Call to Action -->
<section class="py-5" style="background: linear-gradient(135deg, var(--primary-color), var(--accent-color));">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center text-white">
                <h2 class="display-5 fw-bold mb-4">Rejoignez Notre Fédération</h2>
                <p class="lead mb-4">Faites partie d'un réseau national d'excellence en arts martiaux</p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a href="#qr-codes" class="btn btn-light btn-lg">
                        <i class="fas fa-qrcode me-2"></i>Adhérer Maintenant
                    </a>
                    <a href="#contact" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-info-circle me-2"></i>Plus d'Infos
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}