{% endblock %}

{% block extra_js %}
<script>
// Mode simulation (depuis le contexte Django)
const SIMULATION_MODE = {{ simulation_mode|yesno:"true,false" }};

// État du combat (valeurs réelles depuis la base de données)
let combatState = {
  scoreRouge: {{ combat.score_rouge|default:0 }},
  scoreBlanc: {{ combat.score_blanc|default:0 }},
  kyongGoRouge: 0,
  gamJeomRouge: 0,
  kyongGoBlanc: 0,
  gamJeomBlanc: 0,
  currentRound: 1,
  timeRemaining: {{ combat.duree_combat|default:120 }}, // secondes
  isPaused: {% if combat.status == 'planifie' %}true{% else %}false{% endif %},
  timerInterval: null
};

// Initialisation
document.addEventListener('DOMContentLoaded', function() {
  initializeInterface();
  setupEventHandlers();
  setupKeyboardShortcuts();
  if (SIMULATION_MODE) {
    startTimer();
    simulateActions();
  }
});

// Ouvrir les paramètres de durée
function openTimerSettings() {
  const modal = new bootstrap.Modal(document.getElementById('timerSettingsModal'));
  modal.show();
}

// Sauvegarder les paramètres de durée
function saveTimerSettings() {
  const formData = new FormData(document.getElementById('timerSettingsForm'));
  const combatId = {{ combat.id }};
  
  // Créer l'objet de données
  const data = {
    duree_combat: formData.get('duree_combat'),
    duree_prolongation: formData.get('duree_prolongation') || null
  };
  
  // Envoyer la requête AJAX
  fetch(`/competitions/combat/combats/${combatId}/update-duree/`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRFToken': getCookie('csrftoken')
    },
    body: JSON.stringify(data)
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Mettre à jour l'affichage
      document.getElementById('mainTimer').textContent = formatTime(data.duree_combat);
      
      // Fermer la modal
      const modal = bootstrap.Modal.getInstance(document.getElementById('timerSettingsModal'));
      modal.hide();
      
      // Afficher un message de succès
      showNotification('Durées mises à jour avec succès', 'success');
    } else {
      showNotification('Erreur lors de la mise à jour', 'error');
    }
  })
  .catch(error => {
    console.error('Erreur:', error);
    showNotification('Erreur de connexion', 'error');
  });
}

// Initialiser l'interface
function initializeInterface() {
  updateScoreDisplay();
  updatePenaltiesDisplay();
}

// Mettre à jour l'affichage des scores
function updateScoreDisplay() {
  // Formater les scores pour TOUJOURS afficher au moins 1 décimale
  // Exemples: 0 → "0.0", 0.5 → "0.5", 1.25 → "1.25", 5.5 → "5.5", -0.5 → "-0.5"
  function formatScore(score) {
    // Convertir en nombre et formater avec 2 décimales max
    const num = Number(score).toFixed(2);
    // Si le nombre se termine par .00, afficher .0
    // Si le nombre se termine par .X0, afficher .X
    // Sinon afficher .XX
    if (num.endsWith('00')) {
      return num.slice(0, -1); // "1.00" → "1.0"
    } else if (num.endsWith('0')) {
      return num.slice(0, -1); // "1.50" → "1.5"
    } else {
      return num; // "1.25" → "1.25"
    }
  }
  
  document.getElementById('scoreRouge').textContent = formatScore(combatState.scoreRouge);
  document.getElementById('scoreBlanc').textContent = formatScore(combatState.scoreBlanc);
}

// Mettre à jour l'affichage des pénalités
function updatePenaltiesDisplay() {
  document.getElementById('kyongGoRouge').textContent = combatState.kyongGoRouge;
  document.getElementById('gamJeomRouge').textContent = combatState.gamJeomRouge;
  document.getElementById('kyongGoBlanc').textContent = combatState.kyongGoBlanc;
  document.getElementById('gamJeomBlanc').textContent = combatState.gamJeomBlanc;
}

// Configuration des gestionnaires d'événements
function setupEventHandlers() {
  // Boutons de score
  document.querySelectorAll('.score-button').forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const action = this.dataset.action;
      const value = parseFloat(this.dataset.value);
      const color = this.dataset.color;
      
      console.log('Bouton cliqué:', {action, value, color}); // Debug
      
      if (!isNaN(value) && color) {
        addScore(color, value, this.querySelector('div').textContent);
      } else {
        console.error('Valeurs invalides:', {action, value, color});
      }
    });
  });
  
  // Contrôles
  const pauseBtn = document.getElementById('pauseBtn');
  const resetBtn = document.getElementById('resetBtn');
  const endRoundBtn = document.getElementById('endRoundBtn');
  const stopMatchBtn = document.getElementById('stopMatchBtn');
  
  if (pauseBtn) pauseBtn.addEventListener('click', togglePause);
  if (resetBtn) resetBtn.addEventListener('click', resetTimer);
  if (endRoundBtn) endRoundBtn.addEventListener('click', endRound);
  if (stopMatchBtn) stopMatchBtn.addEventListener('click', medicalStop);
}

// Ajouter un score
function addScore(color, value, description) {
  if (color === 'rouge') {
    // Utiliser Math.round pour éviter les problèmes de précision avec les décimales
    combatState.scoreRouge = Math.round((combatState.scoreRouge + value) * 100) / 100;
    if (value < 0) {
      combatState.kyongGoRouge += 1;
    }
  } else {
    // Utiliser Math.round pour éviter les problèmes de précision avec les décimales
    combatState.scoreBlanc = Math.round((combatState.scoreBlanc + value) * 100) / 100;
    if (value < 0) {
      combatState.kyongGoBlanc += 1;
    }
  }
  
  // Animation flash
  const scoreElement = document.getElementById(color === 'rouge' ? 'scoreRouge' : 'scoreBlanc');
  scoreElement.classList.add('flash');
  setTimeout(() => scoreElement.classList.remove('flash'), 800);
  
  // Mettre à jour l'affichage
  updateScoreDisplay();
  updatePenaltiesDisplay();
  
  // Ajouter à l'historique
  addActionToHistory(color, description, value);
  
  // Vérifier les conditions de victoire
  checkVictoryConditions();
}

// Ajouter une action à l'historique
function addActionToHistory(color, description, value) {
  const actionsList = document.getElementById('actionsList');
  const actionItem = document.createElement('div');
  actionItem.className = 'action-item';
  
  const time = formatTime(combatState.timeRemaining);
  const colorClass = color === 'rouge' ? 'rouge' : 'blanc';
  const pointsClass = value >= 0 ? 'positive' : 'negative';
  const pointsText = value >= 0 ? `+${value}` : `${value}`;
  
  actionItem.innerHTML = `
    <span class="action-time">${time}</span>
    <span class="action-fighter ${colorClass}">${color.toUpperCase()}</span>
    <span class="action-description">${description}</span>
    <span class="action-points ${pointsClass}">${pointsText}</span>
  `;
  
  actionsList.insertBefore(actionItem, actionsList.firstChild);
  
  // Limiter l'historique à 10 actions
  while (actionsList.children.length > 10) {
    actionsList.removeChild(actionsList.lastChild);
  }
}

// Timer
function startTimer() {
  if (!combatState.timerInterval) {
    combatState.timerInterval = setInterval(updateTimer, 1000);
  }
}

function updateTimer() {
  if (!combatState.isPaused && combatState.timeRemaining > 0) {
    combatState.timeRemaining--;
    document.getElementById('mainTimer').textContent = formatTime(combatState.timeRemaining);
    
    if (combatState.timeRemaining === 10) {
      playSound('countdown');
    } else if (combatState.timeRemaining === 0) {
      endRound();
    }
  }
}

function formatTime(seconds) {
  const minutes = Math.floor(seconds / 60);
  const remainingSeconds = seconds % 60;
  return `${minutes.toString().padStart(2, '0')}:${remainingSeconds.toString().padStart(2, '0')}`;
}

function togglePause() {
  combatState.isPaused = !combatState.isPaused;
  const pauseBtn = document.getElementById('pauseBtn');
  if (combatState.isPaused) {
    pauseBtn.innerHTML = '<i class="fas fa-play"></i> REPRENDRE';
    pauseBtn.classList.replace('btn-warning', 'btn-success');
  } else {
    pauseBtn.innerHTML = '<i class="fas fa-pause"></i> PAUSE';
    pauseBtn.classList.replace('btn-success', 'btn-warning');
  }
}

function resetTimer() {
  if (confirm('Réinitialiser le chronomètre à 2:00 ?')) {
    combatState.timeRemaining = 120;
    document.getElementById('mainTimer').textContent = '02:00';
  }
}

function endRound() {
  playSound('gong');
  alert(`Fin du round ${combatState.currentRound} !`);
  if (combatState.currentRound < 3) {
    combatState.currentRound++;
    combatState.timeRemaining = 120;
    document.getElementById('currentRound').textContent = combatState.currentRound;
  } else {
    endMatch();
  }
}

function medicalStop() {
  combatState.isPaused = true;
  alert('Arrêt médical en cours...');
}

// Vérifier les conditions de victoire
function checkVictoryConditions() {
  // Victoire par écart de 20 points
  if (Math.abs(combatState.scoreRouge - combatState.scoreBlanc) >= 20) {
    const winner = combatState.scoreRouge > combatState.scoreBlanc ? 'rouge' : 'blanc';
    declareWinner(winner, 'Victoire par écart de points');
  }
  
  // Disqualification pour pénalités
  if (combatState.kyongGoRouge >= 10 || combatState.gamJeomRouge >= 5) {
    declareWinner('blanc', 'Disqualification Rouge');
  }
  if (combatState.kyongGoBlanc >= 10 || combatState.gamJeomBlanc >= 5) {
    declareWinner('rouge', 'Disqualification Blanc');
  }
}

function declareWinner(winner, reason) {
  clearInterval(combatState.timerInterval);
  playSound('victory');
  
  const winnerColumn = document.getElementById(winner === 'rouge' ? 'redColumn' : 'whiteColumn');
  winnerColumn.classList.add('winner');
  
  setTimeout(() => {
    alert(`Victoire ${winner.toUpperCase()} ! ${reason}`);
  }, 500);
}

function endMatch() {
  clearInterval(combatState.timerInterval);
  const winner = combatState.scoreRouge > combatState.scoreBlanc ? 'rouge' : 
                 combatState.scoreBlanc > combatState.scoreRouge ? 'blanc' : 'egalite';
  
  if (winner === 'egalite') {
    alert('Match nul !');
  } else {
    declareWinner(winner, 'Victoire aux points');
  }
}

// Raccourcis clavier
function setupKeyboardShortcuts() {
  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    
    switch(e.key.toUpperCase()) {
      // Rouge
      case 'Q': addScore('rouge', 1, 'Poing'); break;
      case 'W': addScore('rouge', 2, 'Pied Corps'); break;
      case 'E': addScore('rouge', 3, 'Pied Tête'); break;
      case 'R': addScore('rouge', 4, 'Retourné Corps'); break;
      case 'T': addScore('rouge', 5, 'Retourné Tête'); break;
      case 'A': addScore('rouge', -0.5, 'Avertissement'); break;
      
      // Blanc
      case 'U': addScore('blanc', 1, 'Poing'); break;
      case 'I': addScore('blanc', 2, 'Pied Corps'); break;
      case 'O': addScore('blanc', 3, 'Pied Tête'); break;
      case 'P': addScore('blanc', 4, 'Retourné Corps'); break;
      case '[': addScore('blanc', 5, 'Retourné Tête'); break;
      case 'J': addScore('blanc', -0.5, 'Avertissement'); break;
      
      // Contrôles
      case ' ': 
        e.preventDefault();
        togglePause(); 
        break;
      case 'ESCAPE': resetTimer(); break;
      case 'ENTER': endRound(); break;
    }
  });
}

// Simulation d'actions (pour démo)
function simulateActions() {
  if (!SIMULATION_MODE) return;
  
  // Simuler des actions aléatoires toutes les 5-10 secondes
  setInterval(() => {
    if (!combatState.isPaused && Math.random() > 0.5) {
      const actions = [
        {color: 'rouge', value: 2, desc: 'Pied Corps'},
        {color: 'blanc', value: 3, desc: 'Pied Tête'},
        {color: 'rouge', value: 1, desc: 'Poing'},
        {color: 'blanc', value: 2, desc: 'Pied Corps'},
      ];
      
      const action = actions[Math.floor(Math.random() * actions.length)];
      addScore(action.color, action.value, action.desc);
    }
  }, 7000);
}

// Sons (simulation)
function playSound(type) {
  console.log(`Son joué : ${type}`);
  // Dans une vraie implémentation, utilisez l'API Web Audio
}

// Plein écran
function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen();
  } else {
    if (document.exitFullscreen) {
      document.exitFullscreen();
    }
  }
}

// Fonction pour récupérer le cookie CSRF
function getCookie(name) {
  let cookieValue = null;
  if (document.cookie && document.cookie !== '') {
    const cookies = document.cookie.split(';');
    for (let i = 0; i < cookies.length; i++) {
      const cookie = cookies[i].trim();
      if (cookie.substring(0, name.length + 1) === (name + '=')) {
        cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
        break;
      }
    }
  }
  return cookieValue;
}

// Fonction pour afficher les notifications
function showNotification(message, type = 'info') {
  // Créer un élément de notification
  const notification = document.createElement('div');
  notification.className = `alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3`;
  notification.style.zIndex = '9999';
  notification.innerHTML = `
    ${message}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  `;
  
  document.body.appendChild(notification);
  
  // Supprimer après 3 secondes
  setTimeout(() => {
    notification.remove();
  }, 3000);
}
</script>
{% endblock %}