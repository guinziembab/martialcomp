    </div>
  </div>
  
  <!-- Raccourcis clavier -->
  <div class="keyboard-shortcuts">
    <h6 class="text-warning mb-2">Raccourcis Clavier</h6>
    <div class="shortcut-item">
      <span>Rouge +1</span>
