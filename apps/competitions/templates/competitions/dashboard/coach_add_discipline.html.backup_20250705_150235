{% extends "competitions/dashboard/base.html" %}
{% load i18n %}

{% block title %}{% translate "Nouvelle discipline" %} - MartialComp{% endblock %}

{% block user_role %}{% translate "Coach Multi-Disciplines" %}{% endblock %}

{% block page_title %}{% translate "Nouvelle discipline" %}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-karate me-2"></i>
                        {% translate "Ajouter une expertise en discipline" %}
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        {% csrf_token %}
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Discipline" %}</label>
                                <select class="form-select" name="discipline" required>
                                    <option value="">{% translate "Sélectionner une discipline" %}</option>
                                    <option value="karate">{% translate "Karaté" %}</option>
                                    <option value="judo">{% translate "Judo" %}</option>
                                    <option value="taekwondo">{% translate "Taekwondo" %}</option>
                                    <option value="aikido">{% translate "Aïkido" %}</option>
                                    <option value="kendo">{% translate "Kendo" %}</option>
                                    <option value="boxing">{% translate "Boxe" %}</option>
                                    <option value="mma">{% translate "MMA" %}</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Niveau d'expertise" %}</label>
                                <select class="form-select" name="level" required>
                                    <option value="">{% translate "Sélectionner un niveau" %}</option>
                                    <option value="assistant">{% translate "Assistant instructeur" %}</option>
                                    <option value="instructor">{% translate "Instructeur" %}</option>
                                    <option value="expert">{% translate "Expert" %}</option>
                                    <option value="master">{% translate "Maître" %}</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Années d'expérience" %}</label>
                                <input type="number" class="form-control" name="years_experience" min="0" max="50" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Années d'enseignement" %}</label>
                                <input type="number" class="form-control" name="years_teaching" min="0" max="50">
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{% translate "Grade actuel" %}</label>
                            <input type="text" class="form-control" name="current_grade" placeholder="{% trans "Ex: 3ème Dan, Ceinture noire" %}">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{% translate "Fédération" %}</label>
                            <select class="form-select" name="federation">
                                <option value="">{% translate "Sélectionner une fédération" %}</option>
                                <option value="ffk">{% translate "Fédération Française de Karaté" %}</option>
                                <option value="ffjda">{% translate "Fédération Française de Judo" %}</option>
                                <option value="ffet">{% translate "Fédération Française de Taekwondo" %}</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{% translate "Description publique" %}</label>
                            <textarea class="form-control" name="public_description" rows="3" 
                                      placeholder="{% trans "Décrivez votre expertise dans cette discipline..." %}"></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="teaching_certification" id="teaching_cert">
                                <label class="form-check-label" for="teaching_cert">
                                    {% translate "J'ai une certification d'enseignement officielle dans cette discipline" %}
                                </label>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="is_primary" id="is_primary">
                                <label class="form-check-label" for="is_primary">
                                    {% translate "Définir comme discipline principale" %}
                                </label>
                            </div>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>{% translate "Ajouter la discipline" %}
                            </button>
                            <a href="{% url 'competitions:dashboard:coach_disciplines' %}" class="btn btn-secondary">
                                {% translate "Annuler" %}
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}