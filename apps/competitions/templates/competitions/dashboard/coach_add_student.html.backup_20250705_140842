{% extends "competitions/dashboard/base.html" %}
{% load i18n %}

{% block title %}{% translate "Nouvel élève" %} - MartialComp{% endblock %}

{% block user_role %}{% translate "Coach Multi-Disciplines" %}{% endblock %}

{% block page_title %}{% translate "Nouvel élève" %}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-plus me-2"></i>
                        {% translate "Ajouter un nouvel élève" %}
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        {% csrf_token %}
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Prénom" %}</label>
                                <input type="text" class="form-control" name="first_name" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Nom" %}</label>
                                <input type="text" class="form-control" name="last_name" required>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Email" %}</label>
                                <input type="email" class="form-control" name="email" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Téléphone" %}</label>
                                <input type="tel" class="form-control" name="phone">
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Date de naissance" %}</label>
                                <input type="date" class="form-control" name="birth_date" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Genre" %}</label>
                                <select class="form-select" name="gender" required>
                                    <option value="">{% translate "Sélectionner" %}</option>
                                    <option value="M">{% translate "Masculin" %}</option>
                                    <option value="F">{% translate "Féminin" %}</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Discipline principale" %}</label>
                                <select class="form-select" name="primary_discipline">
                                    <option value="">{% translate "Sélectionner une discipline" %}</option>
                                    <option value="karate">{% translate "Karaté" %}</option>
                                    <option value="judo">{% translate "Judo" %}</option>
                                    <option value="taekwondo">{% translate "Taekwondo" %}</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{% translate "Niveau actuel" %}</label>
                                <input type="text" class="form-control" name="current_grade" placeholder="Ex: Ceinture blanche">
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{% translate "Contact d'urgence" %}</label>
                            <input type="text" class="form-control" name="emergency_contact_name" placeholder="Nom du contact d'urgence">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{% translate "Téléphone contact d'urgence" %}</label>
                            <input type="tel" class="form-control" name="emergency_contact_phone">
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>{% translate "Ajouter l'élève" %}
                            </button>
                            <a href="{% url 'competitions:dashboard:coach_students' %}" class="btn btn-secondary">
                                {% translate "Annuler" %}
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}