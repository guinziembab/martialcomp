// Variables globales pour l'import
let selectedFile = null;
let importModal = null;

// Fonction directe pour upload CSV - VERSION TEMPLATE PRINCIPAL
function directFileUpload() {
    console.log('🚀 Direct file upload called - Version template principal');
    console.log(' Browser info:', navigator.userAgent.split(' ').slice(-2).join(' '));
    
    // Vérifier que cette fonction n'est pas déjà en cours d'exécution
    if (window.uploadInProgress) {
        console.log('⚠️ Upload déjà en cours, abandon...');
        return;
    }
    
    window.uploadInProgress = true;
    
    // Créer un input file temporaire
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.csv,.xlsx,.xls';
    input.style.display = 'none';
    
    input.onchange = function(e) {
        const file = e.target.files[0];
        if (!file) {
            console.log('No file selected');
            window.uploadInProgress = false;
            return;
        }
        
        console.log('File selected:', file.name, 'Size:', file.size);
        
        // Vérifier le format
        const validExtensions = ['.csv', '.xlsx', '.xls'];
        const fileExtension = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
        
        if (!validExtensions.includes(fileExtension)) {
            alert('Format non supporté. Utilisez CSV ou Excel.');
            window.uploadInProgress = false;
            return;
        }
        
        // Confirmer l'upload
        if (!confirm(`Voulez-vous importer le fichier "${file.name}" ?`)) {
            window.uploadInProgress = false;
            return;
        }
        
        // Créer FormData
        const formData = new FormData();
        formData.append('file', file);
        formData.append('csrfmiddlewaretoken', '{{ csrf_token }}');
        
        // Afficher message de chargement
        const loadingMsg = document.createElement('div');
        loadingMsg.id = 'loading-import';
        loadingMsg.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;padding:20px;border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,0.3);z-index:9999;text-align:center;';
        loadingMsg.innerHTML = '<h4><i class="fas fa-spinner fa-spin me-2"></i>Import en cours...</h4><p>Veuillez patienter, traitement du fichier ' + file.name + '</p>';
        document.body.appendChild(loadingMsg);
        
        // Désactiver tous les boutons
        document.querySelectorAll('button').forEach(btn => btn.disabled = true);
        
        // Envoyer la requête
        fetch('{% url "competitions:club:import_export_ajax" %}', {
            method: 'POST',
            body: formData,
            credentials: 'same-origin'
        })
        .then(response => {
            console.log('Response status:', response.status);
            if (!response.ok) {
                throw new Error('HTTP error! status: ' + response.status);
            }
            const contentType = response.headers.get('content-type');
            if (!contentType || !contentType.includes('application/json')) {
                throw new Error('Réponse non-JSON reçue du serveur');
            }
            return response.json();
        })
        .then(data => {
            console.log('Import response:', data);
            
            // Supprimer le message de chargement
            const loading = document.getElementById('loading-import');
            if (loading) loading.remove();
            
            if (data.success) {
                alert('[OK] Import réussi!

' + data.message + '

La page va se recharger.');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                alert('[ERREUR] Erreur lors de l'import:

' + (data.error || 'Erreur inconnue'));
            }
        })
        .catch(error => {
            console.error('Import error:', error);
            
            // Supprimer le message de chargement
            const loading = document.getElementById('loading-import');
            if (loading) loading.remove();
            
            alert('[ERREUR] Erreur de connexion:\n\n' + error.message);
        })
        .finally(() => {
            // Réactiver tous les boutons
            document.querySelectorAll('button').forEach(btn => btn.disabled = false);
            
            // IMPORTANT: Remettre uploadInProgress à false
            window.uploadInProgress = false;
        });
    };
    
    // Gestionnaire d'erreur pour l'input
    input.onerror = function() {
        console.error('Error with file input');
        window.uploadInProgress = false;
    };
    
    // Ajouter à la page et déclencher
    document.body.appendChild(input);
    console.log('About to trigger file selector');
    
    // Déclencher le sélecteur de fichier avec plusieurs méthodes
    try {
        console.log(' Tentative 1: input.click()');
        input.click();
        
        // Si ça ne marche pas, essayer avec un délai
        setTimeout(() => {
            if (!input.value) {
                console.log(' Tentative 2: input.click() avec délai');
                try {
                    input.click();
                } catch (e) {
                    console.error('Tentative 2 échouée:', e);
                }
            }
        }, 100);
        
    } catch (error) {
        console.error('[ERREUR] Toutes les tentatives ont échoué:', error);
        console.log(' Navigateur:', navigator.userAgent);
        console.log(' Input element:', input);
        
        // Cleanup en cas d'erreur
        window.uploadInProgress = false;
        if (input.parentNode) {
            document.body.removeChild(input);
        }
        
        // Message d'erreur utilisateur
        alert('[ERREUR] Impossible d'ouvrir le sélecteur de fichier.

Ceci peut être dû aux restrictions de sécurité de votre navigateur.
Essayez de refresher la page (F5) ou utilisez un autre navigateur.');
        return;
    }
    
    // Cleanup après un délai si aucun fichier n'est sélectionné
    setTimeout(() => {
        if (input.parentNode) {
            try {
                document.body.removeChild(input);
            } catch (e) {
                // Input déjà supprimé
            }
        }
        if (window.uploadInProgress) {
            console.log('Timeout cleanup - resetting uploadInProgress');
            window.uploadInProgress = false;
        }
    }, 30000); // 30 secondes de timeout
}

