function processBulkRegistration() {
    const selectedPractitioners = document.querySelectorAll('.practitioner-checkbox:checked');
    const competitionId = document.getElementById('competitionSelect').value;
    const competitionTitle = document.getElementById('competitionSelect').selectedOptions[0]?.getAttribute('data-title') || '';
    
    if (!competitionId) {
        alert(TRANS.pleaseSelectCompetition || 'Veuillez sélectionner une compétition');
        return;
    }
    
    if (selectedPractitioners.length === 0) {
        alert('Veuillez sélectionner au moins un pratiquant');
        return;
    }
    
    // Créer les données à envoyer
    const practitionerIds = Array.from(selectedPractitioners).map(cb => cb.value);
    
    const confirmBtn = document.getElementById('confirmRegistrationBtn');
    confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> {% trans "Inscription en cours..." %}';
    confirmBtn.disabled = true;
    
    // Créer FormData pour envoyer les données
    const formData = new FormData();
    formData.append('csrfmiddlewaretoken', '{{ csrf_token }}');
    practitionerIds.forEach(id => formData.append('practitioners', id));
    
    // Faire un appel AJAX réel vers la vue d'inscription en masse
    fetch(`{% url 'competitions:club:competition_registration_form' competition_id=0 %}`.replace('0', competitionId), {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'X-CSRFToken': '{{ csrf_token }}'
        },
        credentials: 'same-origin'
    })
    .then(response => {
        if (response.redirected) {
            // Redirection après succès
            window.location.reload();
            return;
        }
        if (!response.ok) {
            throw new Error('HTTP error! status: ' + response.status);
        }
        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
            // Si ce n'est pas du JSON, essayer de lire comme texte
            return response.text().then(text => {
                throw new Error('Réponse non-JSON reçue: ' + text.substring(0, 100));
            });
        }
        return response.json();
    })
    .then(data => {
        // Fermer le modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('bulkRegistrationModal'));
        if (modal) modal.hide();
        
        // Décocher toutes les cases
        selectedPractitioners.forEach(cb => cb.checked = false);
        const selectAll = document.getElementById('select-all-practitioners');
        if (selectAll) selectAll.checked = false;
        updateBulkRegistrationButton();
        
        // Recharger la page pour voir les changements
        window.location.reload();
    })
    .catch(error => {
        console.error('Erreur lors de l\'inscription en masse:', error);
        alert('Une erreur est survenue lors de l\'inscription en masse. Veuillez réessayer.');
        confirmBtn.innerHTML = '<i class="fas fa-check"></i> Confirmer les inscriptions';
        confirmBtn.disabled = false;
    });
}

// ============== CALCUL D'ÂGE ET GÉNÉRATION DE LICENCE ==============

function calculateAge(birthDate) {
    const today = new Date();
    const birth = new Date(birthDate);
    let age = today.getFullYear() - birth.getFullYear();
    const monthDiff = today.getMonth() - birth.getMonth();
    
    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) {
        age--;
    }
    
    return age;
}

function generateLicenseNumber(practitionerId, birthDate) {
    // Format: YYYY-MMDD-ID (ex: 2010-0315-00042)
    const birth = new Date(birthDate);
    const year = birth.getFullYear();
    const month = String(birth.getMonth() + 1).padStart(2, '0');
    const day = String(birth.getDate()).padStart(2, '0');
    const id = String(practitionerId).padStart(5, '0');
    
    return `${year}-${month}${day}-${id}`;
}

function updateAgesAndLicenses() {
    // Calculer et afficher les âges
    const ageDisplays = document.querySelectorAll('.age-display');
    console.log(` Trouvé ${ageDisplays.length} éléments .age-display`);
    
    ageDisplays.forEach((span, index) => {
        const birthDate = span.getAttribute('data-birth-date');
        console.log(`  [${index}] birth_date: ${birthDate}`);
        
        if (birthDate) {
            const age = calculateAge(birthDate);
            console.log(`  [${index}] Âge calculé: ${age} ans`);
            span.innerHTML = `<span class="badge bg-info">${age} ans</span>`;
        }
    });
    
    // Générer les numéros de licence si nécessaire
    const licenseDisplays = document.querySelectorAll('.license-display');
    console.log(` Trouvé ${licenseDisplays.length} éléments .license-display`);
    
    licenseDisplays.forEach((span, index) => {
        const practitionerId = span.getAttribute('data-practitioner-id');
        const birthDate = span.getAttribute('data-birth-date');
        const existingLicense = span.getAttribute('data-existing-license');
        
        console.log(`  [${index}] practitioner: ${practitionerId}, birth: ${birthDate}, existing: ${existingLicense}`);
        
        if (!existingLicense && practitionerId && birthDate) {
            const license = generateLicenseNumber(practitionerId, birthDate);
            console.log(`  [${index}] Licence générée: ${license}`);
            span.innerHTML = `<code class="text-muted">${license}</code>`;
        }
    });
}

// Exécuter au chargement de la page
document.addEventListener('DOMContentLoaded', function() {
    console.log(' Calcul des âges - DOMContentLoaded');
    updateAgesAndLicenses();
    
    // Réexécuter après un court délai pour les éléments chargés dynamiquement
    setTimeout(function() {
        console.log(' Calcul des âges - Delayed execution');
        updateAgesAndLicenses();
    }, 500);
});

// Exécuter aussi après le chargement des onglets
document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(tab => {
    tab.addEventListener('shown.bs.tab', function() {
        console.log(' Calcul des âges - Tab changed');
        setTimeout(updateAgesAndLicenses, 100);
    });
});

// Observer pour détecter les nouveaux éléments .age-display ajoutés dynamiquement
const ageObserver = new MutationObserver(function(mutations) {
    let hasNewAgeDisplay = false;
    mutations.forEach(function(mutation) {
        mutation.addedNodes.forEach(function(node) {
            if (node.nodeType === 1) { // Element node
                if (node.classList && node.classList.contains('age-display')) {
                    hasNewAgeDisplay = true;
                } else if (node.querySelectorAll) {
                    const ageDisplays = node.querySelectorAll('.age-display');
                    if (ageDisplays.length > 0) {
                        hasNewAgeDisplay = true;
                    }
                }
            }
        });
    });
    
    if (hasNewAgeDisplay) {
        console.log(' Calcul des âges - New elements detected');
        updateAgesAndLicenses();
    }
});

// Démarrer l'observation
if (document.body) {
    ageObserver.observe(document.body, {
        childList: true,
        subtree: true
    });
}


