// ============== GESTION LOGO ET BANNIÈRE ==============

function uploadLogo() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.onchange = function(e) {
        const file = e.target.files[0];
        if (file) {
            // Vérifier la taille (max 5MB)
            if (file.size > 5 * 1024 * 1024) {
                alert(TRANS.fileTooLarge5MB);
                return;
            }
            
            // Vérifier le type
            if (!file.type.startsWith('image/')) {
                alert(TRANS.pleaseSelectImage);
                return;
            }
            
            // Créer FormData pour l'upload
            const formData = new FormData();
            formData.append('logo', file);
            formData.append('csrfmiddlewaretoken', '{{ csrf_token }}');
            
            // Afficher un indicateur de chargement
            const loadingMsg = document.createElement('div');
            loadingMsg.id = 'loading-logo';
            loadingMsg.innerHTML = '<div class="d-flex align-items-center"><div class="spinner-border spinner-border-sm me-2" role="status"></div>{% trans "Upload du logo en cours..." %}</div>';
            loadingMsg.className = 'alert alert-info mt-2';
            document.body.appendChild(loadingMsg);
            
            // Envoyer la requête
            fetch('/fr/competitions/club/api/upload-logo/', {
                method: 'POST',
                body: formData,
                credentials: 'same-origin'
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('HTTP error! status: ' + response.status);
                }
                const contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    throw new Error('Réponse non-JSON reçue du serveur');
                }
                return response.json();
            })
            .then(data => {
                // Supprimer le message de chargement
                const loading = document.getElementById('loading-logo');
                if (loading) loading.remove();
                
                if (data.success) {
                    alert(TRANS.logoUploadedSuccess);
                    window.location.reload();
                } else {
                    alert(TRANS.error + " " + (data.error || TRANS.unknownError));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                const loading = document.getElementById('loading-logo');
                if (loading) loading.remove();
                alert(TRANS.uploadError);
            });
        }
    };
    input.click();
}

