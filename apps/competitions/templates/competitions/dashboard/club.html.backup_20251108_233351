// Initialisation robuste du système d'inscription en masse
document.addEventListener('DOMContentLoaded', function() {
    console.log('📋 DOM loaded, initializing mass registration system (UNIQUE)...');
    
    // Fonction pour initialiser les événements
    function initializeBulkRegistration() {
        const bulkButton = document.getElementById('bulk-registration-btn');
        
        if (bulkButton) {
            console.log(' Bulk button found:', bulkButton.textContent.trim());
            
            // Supprimer l'ancien onclick pour éviter les conflits
            bulkButton.removeAttribute('onclick');
            
            // Ajouter l'événement click moderne
            bulkButton.addEventListener('click', handleBulkRegistrationClick);
            console.log('[OK] Event listener attached to bulk registration button');
            
            // Marquer comme initialisé
            bulkButton.setAttribute('data-initialized', 'true');
        } else {
            console.warn('Bulk registration button not found!');
        }
        
        const selectAllBox = document.getElementById('select-all-practitioners');
        if (selectAllBox && !selectAllBox.hasAttribute('data-initialized')) {
            selectAllBox.setAttribute('data-initialized', 'true');
            selectAllBox.addEventListener('change', function() {
                toggleAllPractitioners(this);
            });
            console.log('Select all checkbox initialized');
        }
        
        updateBulkRegistrationButton();
    }
    
    // Fonction de gestion du clic
    function handleBulkRegistrationClick(e) {
        e.preventDefault();
        console.log('Bulk registration button clicked!');
        showBulkRegistrationModal();
    }
    
    // Initialiser UNE SEULE FOIS
    initializeBulkRegistration();
    
    // Si l'onglet Pratiquants devient visible, réinitialiser si nécessaire
    const membersTab = document.getElementById('members-tab');
    if (membersTab) {
        membersTab.addEventListener('shown.bs.tab', function() {
            // Seulement si le bouton n'est pas déjà initialisé
            const bulkButton = document.getElementById('bulk-registration-btn');
            if (bulkButton && !bulkButton.hasAttribute('data-initialized')) {
                console.log('🔄 Re-initialisation bulk registration pour onglet Pratiquants');
                initializeBulkRegistration();
            }
        });
    }
});

