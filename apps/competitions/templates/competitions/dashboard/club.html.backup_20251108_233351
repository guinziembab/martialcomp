                </button>
                <button type="button" class="btn btn-info btn-sm me-2" id="bulk-registration-btn">
                  <i class="fas fa-trophy"></i> {% trans "Inscription en masse" %}
                </button>
                <a href="{% url 'competitions:club:practitioner_add' %}" class="btn btn-primary btn-sm">
                  <i class="fas fa-plus"></i> {% trans "Ajouter" %}
                </a>
              </div>
            </div>
            <div class="card-body">
              {% if all_practitioners %}
                {% comment %}
                <!-- MESSAGE DÉVELOPPEMENT: Si vous voyez ce message, le club n'a pas d'organisation -->
                <!-- En production, chaque club doit avoir une organisation associée -->
                {% if not club.organization %}
                  <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Mode développement:</strong> Ce club utilise des données de démonstration car il n'a pas d'organisation associée.
                    <br><small>En production, créez une organisation pour ce club via l'admin Django.</small>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                  </div>
                {% endif %}
                {% endcomment %}
                <div class="table-responsive">
                  <table class="modern-table table table-sm">
                    <thead>
                      <tr>
                        <th style="width: 40px;">
                          <input type="checkbox" id="select-all-practitioners" class="form-check-input" onchange="toggleAllPractitioners(this)">
