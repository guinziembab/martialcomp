// Fonction pour calculer et afficher les âges - VERSION CORRIGÉE
function calculateAges() {
    const ageDisplays = document.querySelectorAll('.age-display');
    
    if (ageDisplays.length === 0) {
        return;
    }
    
    ageDisplays.forEach(function(element) {
        // Éviter de recalculer si déjà calculé
        if (element.getAttribute('data-calculated') === 'true') {
            return;
        }
        
        const birthDateStr = element.getAttribute('data-birth-date');
        
        if (birthDateStr && birthDateStr !== '') {
            try {
                const birthDate = new Date(birthDateStr);
                
                // Vérifier que la date est valide
                if (isNaN(birthDate.getTime())) {
                    element.innerHTML = '<span class="text-muted">-</span>';
                    element.setAttribute('data-calculated', 'true');
                    return;
                }
                
                const today = new Date();
                let age = today.getFullYear() - birthDate.getFullYear();
                const monthDiff = today.getMonth() - birthDate.getMonth();
                
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }
                
                // Vérifier que l'âge est raisonnable (entre 0 et 120 ans)
                if (age >= 0 && age <= 120) {
                    element.innerHTML = `<span class="text-info fw-bold">${age} ans</span>`;
                } else {
                    element.innerHTML = '<span class="text-muted">-</span>';
                }
                
                // Marquer comme calculé pour éviter les recalculs
                element.setAttribute('data-calculated', 'true');
                
            } catch (error) {
                console.error('Error calculating age:', error);
                element.innerHTML = '<span class="text-muted">-</span>';
                element.setAttribute('data-calculated', 'true');
            }
        } else {
            element.innerHTML = '<span class="text-muted">-</span>';
            element.setAttribute('data-calculated', 'true');
        }
    });
}

// Recalculer les âges quand l'onglet Pratiquants est activé
document.addEventListener('shown.bs.tab', function (event) {
    if (event.target.getAttribute('data-bs-target') === '#members') {
        // Réinitialiser les attributs calculated pour forcer le recalcul
        document.querySelectorAll('.age-display').forEach(el => {
            el.removeAttribute('data-calculated');
        });
        setTimeout(calculateAges, 100);
    }
});

// Calculer les âges immédiatement si on est déjà sur l'onglet
document.addEventListener('DOMContentLoaded', function() {
    // Attendre que le DOM soit complètement chargé
    setTimeout(function() {
        const membersTab = document.querySelector('#members');
        if (membersTab && membersTab.classList.contains('show')) {
            calculateAges();
        }
    }, 500);
});

// ==== INSCRIPTION EN MASSE - VERSION OPTIMISÉE ====

function toggleAllPractitioners(checkbox) {
    const practitionerCheckboxes = document.querySelectorAll('.practitioner-checkbox');
    practitionerCheckboxes.forEach(cb => {
        cb.checked = checkbox.checked;
    });
    updateBulkRegistrationButton();
}

function updateBulkRegistrationButton() {
    const selectedPractitioners = document.querySelectorAll('.practitioner-checkbox:checked');
    const bulkButton = document.getElementById('bulk-registration-btn');
    
    if (bulkButton) {
        if (selectedPractitioners.length > 0) {
            const count = String(selectedPractitioners.length);
            bulkButton.innerHTML = '<i class="fas fa-trophy"></i> Register (' + count + ')';
            bulkButton.classList.remove('btn-info');
            bulkButton.classList.add('btn-success');
            bulkButton.disabled = false;
        } else {
            bulkButton.innerHTML = '<i class="fas fa-trophy"></i> Bulk Registration';
            bulkButton.classList.remove('btn-success');
            bulkButton.classList.add('btn-info');
            bulkButton.disabled = false;
        }
    }
}

// Listen to checkbox changes
document.addEventListener('change', function(e) {
    if (e.target.classList.contains('practitioner-checkbox')) {
        updateBulkRegistrationButton();
        const allCheckboxes = document.querySelectorAll('.practitioner-checkbox');
        const checkedBoxes = document.querySelectorAll('.practitioner-checkbox:checked');
        const selectAllBox = document.getElementById('select-all-practitioners');
        
        if (selectAllBox) {
            if (checkedBoxes.length === 0) {
                selectAllBox.indeterminate = false;
                selectAllBox.checked = false;
            } else if (checkedBoxes.length === allCheckboxes.length) {
                selectAllBox.indeterminate = false;
                selectAllBox.checked = true;
            } else {
                selectAllBox.indeterminate = true;
            }
        }
    }
});

