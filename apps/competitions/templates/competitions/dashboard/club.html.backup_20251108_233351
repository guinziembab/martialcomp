                        <th class="d-none d-md-table-cell">{% trans "N° Licence" %}</th>
                        <th class="d-none d-sm-table-cell">{% trans "Date naissance" %}</th>
                        <th>{% trans "Âge" %}</th>
                        <th class="d-none d-lg-table-cell">{% trans "Grade" %}</th>
                        <th class="d-none d-sm-table-cell">{% trans "Statut" %}</th>
                        <th>{% trans "Actions" %}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for practitioner in all_practitioners %}
                      <tr>
                        <td>
                          <input type="checkbox" class="form-check-input practitioner-checkbox" value="{{ practitioner.id }}" data-name="{{ practitioner.first_name }} {{ practitioner.last_name }}">
                        </td>
                        <td>
                          <div class="d-flex align-items-center">
                            {% if practitioner.photo %}
                              <img src="{{ practitioner.photo.url }}" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;">
                            {% else %}
                              <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                {{ practitioner.first_name|first }}{{ practitioner.last_name|first }}
                              </div>
                            {% endif %}
                            <div>
                              <strong>{{ practitioner.first_name }} {{ practitioner.last_name }}</strong>
                              {% if practitioner.email %}
                                <div class="text-muted small">{{ practitioner.email }}</div>
                              {% endif %}
                            </div>
                          </div>
                        </td>
                        <td class="d-none d-md-table-cell">
                          {% if practitioner.license_number %}
                            <code class="bg-light text-dark px-2 py-1 rounded">{{ practitioner.license_number }}</code>
                          {% else %}
                            <span class="text-muted">-</span>
                          {% endif %}
                        </td>
                        <td class="d-none d-sm-table-cell">
                          <small>{{ practitioner.birth_date|date:"d/m/Y"|default:"-" }}</small>
                        </td>
                        <td>
                          {% if practitioner.birth_date %}
                            <span class="text-info fw-bold">{{ practitioner.age }} ans</span>
                          {% else %}
                            <span class="text-muted">-</span>
                          {% endif %}
                        </td>
                        <td class="d-none d-lg-table-cell">
                          {% if practitioner.computed_grade_display %}
                            <span class="grade-badge {{ practitioner.computed_grade_css_class|default:'grade-cap-blanc' }}"
                                  data-color="{{ practitioner.computed_grade_color|default:'#6c757d' }}"
                                  style="--grade-color: {{ practitioner.computed_grade_color|default:'#6c757d' }};">
                              {{ practitioner.computed_grade_display }}
                            </span>
                          {% elif practitioner.grade %}
                            <span class="badge bg-info">{{ practitioner.grade }}</span>
                          {% elif practitioner.grade_text %}
                            <span class="badge bg-secondary">{{ practitioner.grade_text }}</span>
                          {% else %}
                            <span class="text-muted">-</span>
                          {% endif %}
                        </td>
                        <td class="d-none d-sm-table-cell">
                          {% if practitioner.status == 'active' %}
                            <span class="badge bg-success">{% trans "Actif" %}</span>
                          {% elif practitioner.status == 'inactive' %}
                            <span class="badge bg-secondary">{% trans "Inactif" %}</span>
                          {% elif practitioner.status == 'suspended' %}
                            <span class="badge bg-warning">{% trans "Suspendu" %}</span>
                          {% elif practitioner.status == 'archived' %}
                            <span class="badge bg-dark">{% trans "Archivé" %}</span>
                          {% else %}
                            <span class="badge bg-success">{% trans "Actif" %}</span>
                          {% endif %}
                        </td>
                        <td>
                          <div class="btn-group btn-group-sm">
                            <a href="{% url 'competitions:club:practitioner_detail' pk=practitioner.pk %}" 
                               class="btn btn-outline-primary btn-sm" 
                               title="{% trans 'Voir le profil' %}">
                              <i class="fas fa-eye"></i>
                            </a>
                            <a href="{% url 'competitions:club:practitioner_edit' pk=practitioner.pk %}" 
                               class="btn btn-outline-secondary btn-sm"
                               title="{% trans 'Modifier' %}">
                              <i class="fas fa-edit"></i>
                            </a>
                            <a href="{% url 'competitions:club:qualification_add' practitioner_id=practitioner.pk %}" 
                               class="btn btn-outline-info btn-sm"
                               title="{% trans 'Qualifications' %}">
                              <i class="fas fa-award"></i>
                            </a>
                            <button type="button" 
                                    class="btn btn-outline-{{ practitioner.is_active|yesno:'success,warning' }} btn-sm toggle-status-btn"
                                    data-practitioner-id="{{ practitioner.pk }}"
                                    data-current-status="{{ practitioner.is_active|lower }}"
