{% block dashboard_content %}
<div class="stats-container">
    <div class="stat-card">
        <div class="stat-icon">🏆</div>
        <div class="stat-value">{{ competitions_count|default:"0" }}</div>
        <div class="stat-label">Compétitions</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">🥋</div>
        <div class="stat-value">{{ practitioners_count|default:"0" }}</div>
        <div class="stat-label">Pratiquants</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">👥</div>
        <div class="stat-value">{{ clubs_count|default:"0" }}</div>
        <div class="stat-label">Clubs</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">📅</div>
        <div class="stat-value">{{ upcoming_count|default:"0" }}</div>
        <div class="stat-label">Événements à venir</div>
    </div>
</div>

<div class="row">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Compétitions à venir</h2>
            <a href="{% url 'competitions:list' %}" class="btn btn-secondary btn-sm">Voir tout</a>
        </div>
        <div class="card-body">
            <table>
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Date</th>
                        <th>Lieu</th>
                        <th>Discipline</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if upcoming_competitions %}
                        {% for comp in upcoming_competitions %}
                        <tr>
                            <td>{{ comp.title }}</td>
                            <td>{{ comp.start_date }}</td>
                            <td>{{ comp.city }}</td>
                            <td>{{ comp.discipline.name }}</td>
                            <td>
                                <span class="badge {% if comp.status == 'draft' %}badge-warning{% elif comp.status == 'published' %}badge-info{% elif comp.status == 'ongoing' %}badge-success{% else %}badge-danger{% endif %}">
                                    {{ comp.get_status_display }}
                                </span>
                            </td>
                            <td>
                                <a href="{% url 'competitions:detail' pk=comp.pk %}" class="btn btn-secondary btn-sm">Détails</a>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">Aucune compétition à venir</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Dernières activités</h2>
        </div>
        <div class="card-body">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Utilisateur</th>
                        <th>Action</th>
                        <th>Détails</th>
                    </tr>
                </thead>
                <tbody>
                    {% if activities %}
                        {% for activity in activities %}
                        <tr>
                            <td>{{ activity.date }}</td>
                            <td>{{ activity.user }}</td>
                            <td>{{ activity.action }}</td>
                            <td>{{ activity.details }}</td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center">Aucune activité récente</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}