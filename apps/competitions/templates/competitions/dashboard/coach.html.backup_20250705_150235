{% extends 'competitions/dashboard/unified_base.html' %}
{% load i18n %}

{% block dashboard_title %}{% trans "Tableau de bord Coach" %}{% endblock %}
{% block dashboard_subtitle %}{% trans "Gestion des entraînements et élèves" %}{% endblock %}

{% block page_title %}{% trans "Tableau de bord Coach" %}{% endblock %}
{% block page_subtitle %}{% trans "Gérez vos entraînements, suivez vos élèves et organisez vos cours" %}{% endblock %}

{% block user_role %}{% trans "Entraîneur" %}{% endblock %}

{% block sidebar_nav %}
<div class="nav-item">
    <a href="{% url 'competitions:dashboard:index' %}" class="nav-link active">
        <i class="fas fa-tachometer-alt nav-icon"></i>
        {% trans "Accueil" %}
    </a>
</div>
<div class="nav-item">
    <a href="#" class="nav-link">
        <i class="fas fa-users nav-icon"></i>
        {% trans "Mes élèves" %}
    </a>
</div>
<div class="nav-item">
    <a href="#" class="nav-link">
        <i class="fas fa-calendar-alt nav-icon"></i>
        {% trans "Entraînements" %}
    </a>
</div>
<div class="nav-item">
    <a href="#" class="nav-link">
        <i class="fas fa-trophy nav-icon"></i>
        {% trans "Compétitions" %}
    </a>
</div>
<div class="nav-item">
    <a href="#" class="nav-link">
        <i class="fas fa-graduation-cap nav-icon"></i>
        {% trans "Examens de grade" %}
    </a>
</div>
<div class="nav-item">
    <a href="#" class="nav-link">
        <i class="fas fa-chart-line nav-icon"></i>
        {% trans "Progression" %}
    </a>
</div>
<div class="nav-item">
    <a href="{% url 'profile' %}" class="nav-link">
        <i class="fas fa-user nav-icon"></i>
        {% trans "Mon profil" %}
    </a>
</div>
{% endblock %}

{% block dashboard_stats %}
<div class="stat-card">
    <div class="stat-icon">
        <i class="fas fa-users"></i>
    </div>
    <div class="stat-number">{{ students_count|default:0 }}</div>
    <div class="stat-label">{% trans "Élèves actifs" %}</div>
</div>

<div class="stat-card">
    <div class="stat-icon">
        <i class="fas fa-calendar-check"></i>
    </div>
    <div class="stat-number">{{ trainings_this_week|default:0 }}</div>
    <div class="stat-label">{% trans "Entraînements cette semaine" %}</div>
</div>

<div class="stat-card">
    <div class="stat-icon">
        <i class="fas fa-trophy"></i>
    </div>
    <div class="stat-number">{{ competitions_count|default:0 }}</div>
    <div class="stat-label">{% trans "Compétitions à venir" %}</div>
</div>

<div class="stat-card">
    <div class="stat-icon">
        <i class="fas fa-graduation-cap"></i>
    </div>
    <div class="stat-number">{{ pending_exams|default:0 }}</div>
    <div class="stat-label">{% trans "Examens en attente" %}</div>
</div>
{% endblock %}

{% block dashboard_main_content %}
<div class="row">
    <!-- Prochains entraînements -->
    <div class="col-lg-8">
        <div class="dashboard-card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-calendar-alt me-2"></i>{% trans "Prochains entraînements" %}
                </h3>
                <a href="#" class="btn-dashboard">
                    <i class="fas fa-plus"></i>{% trans "Nouvel entraînement" %}
                </a>
            </div>
            
            {% if upcoming_trainings %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>{% trans "Date" %}</th>
                                <th>{% trans "Heure" %}</th>
                                <th>{% trans "Groupe" %}</th>
                                <th>{% trans "Lieu" %}</th>
                                <th>{% trans "Participants" %}</th>
                                <th>{% trans "Actions" %}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for training in upcoming_trainings %}
                            <tr>
                                <td>{{ training.date|date:"d/m/Y" }}</td>
                                <td>{{ training.start_time|time:"H:i" }} - {{ training.end_time|time:"H:i" }}</td>
                                <td>{{ training.group|default:"Tous niveaux" }}</td>
                                <td>{{ training.location|default:"Dojo principal" }}</td>
                                <td>
                                    <span class="badge bg-info">{{ training.participants_count|default:0 }}</span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-users"></i>
                                    </button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-4">
                    <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">{% trans "Aucun entraînement programmé" %}</h5>
                    <p class="text-muted">{% trans "Planifiez votre prochain entraînement" %}</p>
                    <a href="#" class="btn-dashboard">
                        <i class="fas fa-plus"></i>{% trans "Programmer un entraînement" %}
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Mes élèves récents -->
    <div class="col-lg-4">
        <div class="dashboard-card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-users me-2"></i>{% trans "Mes élèves" %}
                </h3>
                <a href="#" class="btn btn-sm btn-outline-primary">{% trans "Voir tous" %}</a>
            </div>
            
            {% if recent_students %}
                {% for student in recent_students %}
                <div class="d-flex align-items-center mb-3">
                    <div class="profile-avatar me-3">
                        {% if student.avatar %}
                            <img src="{{ student.avatar.url }}" alt="{% trans "Avatar" %}">
                        {% else %}
                            <i class="fas fa-user"></i>
                        {% endif %}
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-1">{{ student.get_full_name }}</h6>
                        <small class="text-muted">
                            {% if student.current_grade %}
                                {{ student.current_grade.name }}
                            {% else %}
                                {% trans "Débutant" %}
                            {% endif %}
                        </small>
                    </div>
                    <div>
                        <small class="text-muted">{{ student.last_training|timesince }}</small>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="text-center py-3">
                    <i class="fas fa-user-plus fa-2x text-muted mb-2"></i>
                    <p class="text-muted">{% trans "Aucun élève enregistré" %}</p>
                </div>
            {% endif %}
        </div>
        
        <!-- Actions rapides -->
        <div class="dashboard-card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-bolt me-2"></i>{% trans "Actions rapides" %}
                </h3>
            </div>
            
            <div class="d-grid gap-2">
                <a href="#" class="btn btn-outline-success">
                    <i class="fas fa-plus me-2"></i>{% trans "Ajouter un élève" %}
                </a>
                <a href="#" class="btn btn-outline-warning">
                    <i class="fas fa-graduation-cap me-2"></i>{% trans "Organiser un examen" %}
                </a>
                <a href="#" class="btn btn-outline-info">
                    <i class="fas fa-trophy me-2"></i>{% trans "Inscrire à une compétition" %}
                </a>
                <a href="#" class="btn btn-outline-primary">
                    <i class="fas fa-chart-line me-2"></i>{% trans "Voir les progressions" %}
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Statistiques détaillées -->
<div class="row mt-4">
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-chart-bar me-2"></i>{% trans "Statistiques de performance" %}
                </h3>
            </div>
            
            <div class="row">
                <div class="col-md-3 text-center">
                    <h4 class="text-success">{{ success_rate|default:0 }}%</h4>
                    <small class="text-muted">{% trans "Taux de réussite aux examens" %}</small>
                </div>
                <div class="col-md-3 text-center">
                    <h4 class="text-info">{{ average_attendance|default:0 }}%</h4>
                    <small class="text-muted">{% trans "Assiduité moyenne" %}</small>
                </div>
                <div class="col-md-3 text-center">
                    <h4 class="text-warning">{{ pending_evaluations|default:0 }}</h4>
                    <small class="text-muted">{% trans "Évaluations en attente" %}</small>
                </div>
                <div class="col-md-3 text-center">
                    <h4 class="text-primary">{{ monthly_hours|default:0 }}h</h4>
                    <small class="text-muted">{% trans "Heures d'enseignement ce mois" %}</small>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}