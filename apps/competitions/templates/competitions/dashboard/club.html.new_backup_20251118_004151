<script src="{% static 'js/dashboard/club_dashboard_import.js' %}"></script>

<!-- Initialisation des modules -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('🚀 Initialisation Dashboard Club v2.0.0');
    
    try {
        // Initialiser le module principal
        if (typeof ClubDashboard !== 'undefined') {
            ClubDashboard.init(DJANGO_URLS, DJANGO_TRANS);
        } else {
            console.error('❌ Module ClubDashboard non chargé');
        }
        
        // Initialiser le module d'inscription en masse
        if (typeof BulkRegistration !== 'undefined') {
            BulkRegistration.init(DJANGO_URLS, DJANGO_TRANS);
        } else {
            console.warn('⚠️ Module BulkRegistration non chargé');
        }
        
        // Initialiser le module d'import CSV
        if (typeof CSVImport !== 'undefined') {
            CSVImport.init(DJANGO_URLS, DJANGO_TRANS);
        } else {
            console.warn('⚠️ Module CSVImport non chargé');
        }
        
        // Calculer les âges au chargement initial
        setTimeout(function() {
            if (typeof ClubDashboard !== 'undefined' && ClubDashboard.calculateAges) {
                ClubDashboard.calculateAges();
            }
        }, 500);
        
        console.log('✅ Dashboard Club v2.0.0 initialisé avec succès');
        
    } catch (error) {
        console.error('❌ Erreur lors de l\'initialisation:', error);
    }
});

// Cache buster pour forcer le rechargement en production
// Version: 20241117-v2.0.0
</script>
