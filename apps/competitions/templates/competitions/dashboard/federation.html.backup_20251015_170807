function saveContent() {
    const form = document.getElementById('manageContentModal');
    const formData = new FormData();
    formData.append('csrfmiddlewaretoken', document.querySelector('[name=csrfmiddlewaretoken]').value);
    
    // Collecter tous les champs de contenu
    const contentFields = form.querySelectorAll('input, textarea, select');
    contentFields.forEach(field => {
        if (field.name) {
            formData.append(field.name, field.value);
        }
    });
    
    fetch(`{% url 'competitions:federations:manage_content' federation_id=federation.id %}`, {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert('success', 'Contenu mis à jour avec succès!');
            bootstrap.Modal.getInstance(document.getElementById('manageContentModal')).hide();
        } else {
            showAlert('danger', data.error || 'Erreur lors de la mise à jour du contenu');
        }
    })
    .catch(error => {
        showAlert('danger', 'Erreur technique: ' + error.message);
    });
}

function previewContent() {
    showAlert('info', 'Fonctionnalité d\'aperçu en cours de développement');
}

function generateQrCodes() {
    const selectedTypes = [];
    const checkboxes = document.querySelectorAll('input[name="qr_types"]:checked');
    checkboxes.forEach(cb => selectedTypes.push(cb.value));
    
    if (selectedTypes.length === 0) {
        showAlert('warning', 'Veuillez sélectionner au moins un type de QR code');
        return;
    }
    
    const size = document.getElementById('qr_size').value;
    const format = document.getElementById('qr_format').value;
    const includeLogo = document.getElementById('include_logo').checked;
    
    const formData = new FormData();
    formData.append('csrfmiddlewaretoken', document.querySelector('[name=csrfmiddlewaretoken]').value);
    formData.append('qr_types', JSON.stringify(selectedTypes));
    formData.append('size', size);
    formData.append('format', format);
    formData.append('include_logo', includeLogo);
    
    fetch(`{% url 'competitions:federations:generate_qr' federation_id=federation.id %}`, {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert('success', 'QR codes générés avec succès!');
            if (data.download_url) {
                window.open(data.download_url, '_blank');
            }
            bootstrap.Modal.getInstance(document.getElementById('generateQrModal')).hide();
        } else {
            showAlert('danger', data.error || 'Erreur lors de la génération des QR codes');
        }
    })
    .catch(error => {
        showAlert('danger', 'Erreur technique: ' + error.message);
    });
}

function previewQrCodes() {
    showAlert('info', 'Fonctionnalité d\'aperçu en cours de développement');
