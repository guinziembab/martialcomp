<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialisation des onglets Bootstrap
  var triggerTabList = [].slice.call(document.querySelectorAll('#federationTabs button[data-bs-toggle="tab"]'));
  triggerTabList.forEach(function (triggerEl) {
    var tabTrigger = new bootstrap.Tab(triggerEl);
    
    triggerEl.addEventListener('click', function (event) {
      event.preventDefault();
      tabTrigger.show();
    });
  });

  // Sauvegarde de l'onglet actif dans localStorage
  var activeTab = localStorage.getItem('federationActiveTab');
  if (activeTab) {
    var tab = document.querySelector('#federationTabs button[data-bs-target="' + activeTab + '"]');
    if (tab) {
      var tabInstance = new bootstrap.Tab(tab);
      tabInstance.show();
    }
  }

  // Sauvegarde lors du changement d'onglet
  document.addEventListener('shown.bs.tab', function(event) {
    var activeTabId = event.target.getAttribute('data-bs-target');
    localStorage.setItem('federationActiveTab', activeTabId);
  });

  // Gestion responsive des onglets
  function handleResponsiveNavigation() {
    var navTabs = document.querySelector('.nav-tabs');
    var windowWidth = window.innerWidth;
    
    if (windowWidth <= 768) {
      navTabs.classList.add('mobile-nav');
    } else {
      navTabs.classList.remove('mobile-nav');
    }
  }

  // Écouter le redimensionnement
  window.addEventListener('resize', handleResponsiveNavigation);
  handleResponsiveNavigation(); // Appel initial

  // Animation des cartes statistiques
  function animateStatCards() {
    var statCards = document.querySelectorAll('.stat-card');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.style.animation = 'fadeIn 0.6s ease forwards';
          observer.unobserve(entry.target);
        }
      });
    });

    statCards.forEach(function(card) {
      observer.observe(card);
    });
  }

  animateStatCards();

  // Amélioration de l'UX des boutons
  document.querySelectorAll('.btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      // Petit effet de feedback
      this.style.transform = 'scale(0.98)';
      setTimeout(() => {
        this.style.transform = '';
      }, 100);
    });
  });

  // Gestion des tooltips (si Bootstrap est disponible)
  if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl);
    });
  }

  // Gestion du formulaire d'invitation de membre
  document.getElementById('addFederationMemberForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    var email = document.getElementById('memberEmail').value;
    var role = document.getElementById('memberRole').value;
    var message = document.getElementById('memberMessage').value;
    
    if (!email || !role) {
      alert('{% trans "Veuillez remplir tous les champs obligatoires" %}');
      return;
    }
    
    // TODO: Implémenter l'envoi de l'invitation via AJAX
    // Pour l'instant, afficher un message de confirmation
    alert('{% trans "Invitation envoyée à" %} ' + email + ' {% trans "avec le rôle" %} ' + role);
    
    // Fermer le modal
    var modal = bootstrap.Modal.getInstance(document.getElementById('addFederationMemberModal'));
    modal.hide();
    
    // Réinitialiser le formulaire
    this.reset();
  });
});
</script>

