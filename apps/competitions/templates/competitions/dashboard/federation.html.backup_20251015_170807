<!-- JavaScript pour les filtres des pratiquants -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchPractitioner = document.getElementById('searchPractitioner');
    const filterClub = document.getElementById('filterClub');
    const filterGrade = document.getElementById('filterGrade');
    const practitionersTable = document.getElementById('practitionersTable');
    
    if (searchPractitioner && practitionersTable) {
        function filterPractitioners() {
            const searchTerm = searchPractitioner.value.toLowerCase();
            const selectedClub = filterClub ? filterClub.value : '';
            const selectedGrade = filterGrade ? filterGrade.value : '';
            const rows = practitionersTable.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
            
            let visibleCount = 0;
            
            for (let row of rows) {
                const name = row.querySelector('td:first-child .fw-semibold').textContent.toLowerCase();
                const club = row.dataset.club;
                const grade = row.dataset.grade;
                
                const matchesSearch = name.includes(searchTerm);
                const matchesClub = !selectedClub || club === selectedClub;
                const matchesGrade = !selectedGrade || grade.includes(selectedGrade);
                
                if (matchesSearch && matchesClub && matchesGrade) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            }
            
            // Mettre à jour le compteur
            const counter = document.querySelector('.text-muted');
            if (counter) {
                counter.innerHTML = `<i class="fas fa-users me-1"></i>${visibleCount} pratiquant(s) affiché(s)`;
            }
        }
        
        searchPractitioner.addEventListener('input', filterPractitioners);
        if (filterClub) filterClub.addEventListener('change', filterPractitioners);
        if (filterGrade) filterGrade.addEventListener('change', filterPractitioners);
    }
});
</script>

