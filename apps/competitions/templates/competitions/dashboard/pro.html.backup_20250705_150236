{% block dashboard_content %}
<div class="stats-container">
    <div class="stat-card">
        <div class="stat-icon">👥</div>
        <div class="stat-value">{{ athletes_count|default:"0" }}</div>
        <div class="stat-label">{% trans "Athlètes" %}</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">🏆</div>
        <div class="stat-value">{{ medals_count|default:"0" }}</div>
        <div class="stat-label">{% trans "Médailles" %}</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">📅</div>
        <div class="stat-value">{{ upcoming_competitions_count|default:"0" }}</div>
        <div class="stat-label">{% trans "Compétitions à venir" %}</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">📝</div>
        <div class="stat-value">{{ pending_registrations_count|default:"0" }}</div>
        <div class="stat-label">{% trans "Inscriptions en attente" %}</div>
    </div>
</div>

<div class="row">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">{% trans "Mes athlètes" %}</h2>
            <a href="#" class="btn btn-secondary btn-sm">{% trans "Voir tout" %}</a>
        </div>
        <div class="card-body">
            <table>
                <thead>
                    <tr>
                        <th>{% trans "Nom" %}</th>
                        <th>{% trans "Âge" %}</th>
                        <th>{% trans "Grade" %}</th>
                        <th>Compétitions</th>
                        <th>{% trans "Médailles" %}</th>
                        <th>{% trans "Actions" %}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if athletes %}
                        {% for athlete in athletes %}
                        <tr>
                            <td>{{ athlete.full_name }}</td>
                            <td>{{ athlete.age }}</td>
                            <td>{{ athlete.grade }}</td>
                            <td>{{ athlete.competitions_count|default:"0" }}</td>
                            <td>{{ athlete.medals_count|default:"0" }}</td>
                            <td>
                                <a href="#" class="btn btn-secondary btn-sm">{% trans "Profil" %}</a>
                                <a href="#" class="btn btn-primary btn-sm">{% trans "Inscrire" %}</a>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">{% trans "Aucun athlète pour le moment" %}</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">{% trans "Prochaines compétitions" %}</h2>
            <a href="#" class="btn btn-secondary btn-sm">{% trans "Voir tout" %}</a>
        </div>
        <div class="card-body">
            <table>
                <thead>
                    <tr>
                        <th>{% trans "Titre" %}</th>
                        <th>{% trans "Date" %}</th>
                        <th>{% trans "Lieu" %}</th>
                        <th>{% trans "Discipline" %}</th>
                        <th>{% trans "Athlètes inscrits" %}</th>
                        <th>{% trans "Actions" %}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if upcoming_competitions %}
                        {% for comp in upcoming_competitions %}
                        <tr>
                            <td>{{ comp.title }}</td>
                            <td>{{ comp.start_date }}</td>
                            <td>{{ comp.city }}</td>
                            <td>{{ comp.discipline.name }}</td>
                            <td>{{ comp.athlete_count|default:"0" }}</td>
                            <td>
                                <a href="#" class="btn btn-secondary btn-sm">{% trans "Détails" %}</a>
                                <a href="#" class="btn btn-primary btn-sm">{% trans "Inscrire" %}</a>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">{% trans "Aucune compétition à venir" %}</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">{% trans "Performances récentes" %}</h2>
        </div>
        <div class="card-body">
            {% if recent_performances %}
                <div class="performance-chart">
                    <!-- Placeholder for chart -->
                    <div class="chart-container" style="height: 300px; background-color: rgba(255,255,255,0.05); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <p>{% trans "Graphique des performances des athlètes" %}</p>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-info">{% trans "Aucune donnée de performance disponible." %}</div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}