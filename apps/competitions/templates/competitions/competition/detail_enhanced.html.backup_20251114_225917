{% block extra_js %}
<script>
// Charger les types de compétition disponibles pour la discipline
function loadAvailableTypes() {
    const disciplineId = {{ competition.discipline.id }};
    const typeSelect = document.getElementById('typeSelect');
    
    console.log('🔄 Chargement des types pour discipline ID:', disciplineId);
    
    fetch(`{% url 'competitions:get_competition_types' %}?discipline_id=${disciplineId}`)
        .then(response => {
            console.log('📡 Réponse API types:', response.status);
            return response.json();
        })
        .then(data => {
            console.log('📊 Données types reçues:', data);
            typeSelect.innerHTML = '<option value="">{% trans "Sélectionnez un type" %}</option>';
            
            if (data.competition_types && data.competition_types.length > 0) {
                data.competition_types.forEach(type => {
                    const option = document.createElement('option');
                    option.value = type.id;
                    option.textContent = type.name;
                    typeSelect.appendChild(option);
                });
                console.log('✅ Types chargés:', data.competition_types.length);
            } else {
                console.log('⚠️ Aucun type trouvé');
            }
        })
        .catch(error => {
            console.error('❌ Erreur lors du chargement des types:', error);
        });
}

// Ajouter un type de compétition
function addCompetitionType() {
    const typeId = document.getElementById('typeSelect').value;
    if (!typeId) {
        alert('{% trans "Veuillez sélectionner un type de compétition" %}');
        return;
    }
    
    fetch(`{% url 'competitions:competitions:add_type' competition.pk %}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
        },
        body: JSON.stringify({
            competition_type_id: typeId
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert(data.message || '{% trans "Erreur lors de l'ajout du type" %}');
        }
    })
    .catch(error => {
        console.error('Erreur:', error);
        alert('{% trans "Erreur lors de l'ajout du type" %}');
    });
}

// Supprimer un type de compétition
function removeCompetitionType(typeId) {
    if (confirm('{% trans "Êtes-vous sûr de vouloir supprimer ce type de compétition ?" %}')) {
        fetch(`{% url 'competitions:competitions:remove_type' competition.pk %}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
            },
            body: JSON.stringify({
                competition_type_id: typeId
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || '{% trans "Erreur lors de la suppression du type" %}');
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            alert('{% trans "Erreur lors de la suppression du type" %}');
        });
    }
}

// Ajouter une catégorie
function addCategory() {
    const formData = new FormData(document.getElementById('addCategoryForm'));
    
    fetch(`{% url 'competitions:competitions:add_category' competition.pk %}`, {
        method: 'POST',
        headers: {
            'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
        },
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert(data.message || '{% trans "Erreur lors de l\'ajout de la catégorie" %}');
        }
    })
    .catch(error => {
        console.error('Erreur:', error);
        alert('{% trans "Erreur lors de l\'ajout de la catégorie" %}');
    });
}

// Supprimer une catégorie
function removeCategory(categoryId) {
    if (confirm('{% trans "Êtes-vous sûr de vouloir supprimer cette catégorie ?" %}')) {
        fetch(`{% url 'competitions:competitions:remove_category' competition.pk %}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
            },
            body: JSON.stringify({
                category_id: categoryId
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || '{% trans "Erreur lors de la suppression de la catégorie" %}');
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            alert('{% trans "Erreur lors de la suppression de la catégorie" %}');
        });
    }
}

// Charger les types disponibles quand le modal s'ouvre (seulement si le modal existe)
const addTypeModal = document.getElementById('addTypeModal');
if (addTypeModal) {
    addTypeModal.addEventListener('show.bs.modal', function () {
        loadAvailableTypes();
    });
}

// Initialisation
document.addEventListener('DOMContentLoaded', function() {
    console.log('Page de détail de compétition chargée');
    
    // Initialiser les onglets Bootstrap
    console.log('🎯 Initialisation des onglets Bootstrap');
    
    // Vérifier que Bootstrap est chargé
    if (typeof bootstrap === 'undefined') {
        console.error('❌ Bootstrap n\'est pas chargé !');
        return;
    }
    
    // Initialiser tous les onglets
    const triggerTabList = document.querySelectorAll('#competitionTabs button[data-bs-toggle="tab"]');
    console.log('📋 Nombre d\'onglets trouvés:', triggerTabList.length);
    
    triggerTabList.forEach(function(triggerEl) {
        const tabTrigger = new bootstrap.Tab(triggerEl);
        
        triggerEl.addEventListener('click', function(event) {
            event.preventDefault();
            console.log('🖱️ Clic sur onglet:', triggerEl.id);
            tabTrigger.show();
        });
    });
    
    console.log('✅ Onglets Bootstrap initialisés');
});
</script>
{% endblock %}