{% extends "base.html" %}
{% load i18n %}
{% load static %}

{% block title %}{% trans "Inscription" %} - {{ event.title }} | MartialComp{% endblock %}

{% block extra_css %}
<style>
  .registration-container {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .event-header {
    background-color: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    margin-bottom: 2rem;
    overflow: hidden;
  }
  
  .event-banner {
    height: 150px;
    background-size: cover;
    background-position: center;
    position: relative;
  }
  
  .event-banner-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    color: white;
  }
  
  .event-type-badge {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border-radius: 30px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  
  .event-type-badge.competition {
    background-color: #ff9800;
  }
  
  .event-type-badge.training {
    background-color: #3366ff;
  }
  
  .event-type-badge.seminar {
    background-color: #9c27b0;
  }
  
  .event-type-badge.exam {
    background-color: #e91e63;
  }
  
  .event-type-badge.meeting {
    background-color: #607d8b;
  }
  
  .event-type-badge.social {
    background-color: #4caf50;
  }
  
  .event-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0;
  }
  
  .event-info-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    background-color: #fff;
  }
  
  .event-info-item {
    display: flex;
    align-items: center;
  }
  
  .event-info-icon {
    width: 24px;
    margin-right: 0.5rem;
    color: #3366ff;
    text-align: center;
  }
  
  .event-info-text {
    font-size: 0.9rem;
  }
  
  .registration-card {
    background-color: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    margin-bottom: 2rem;
    overflow: hidden;
  }
  
  .registration-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #eee;
    background-color: #f8f9fa;
  }
  
  .registration-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0;
    display: flex;
    align-items: center;
  }
  
  .registration-title i {
    margin-right: 0.75rem;
    color: #3366ff;
  }
  
  .registration-body {
    padding: 1.5rem;
  }
  
  .registration-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #eee;
    background-color: #f8f9fa;
    text-align: right;
  }
  
  .terms-scroll {
    max-height: 200px;
    overflow-y: auto;
    padding: 1rem;
    border: 1px solid #eee;
    border-radius: 8px;
    background-color: #f8f9fa;
    margin-bottom: 1rem;
  }
  
  .payment-options {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eee;
  }
  
  .payment-method {
    display: flex;
    align-items: center;
    padding: 1rem;
    border: 1px solid #eee;
    border-radius: 8px;
    margin-bottom: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .payment-method:hover {
    border-color: #3366ff;
    background-color: #f0f4ff;
  }
  
  .payment-method.selected {
    border-color: #3366ff;
    background-color: #f0f4ff;
  }
  
  .payment-method-logo {
    width: 60px;
    height: 40px;
    background-color: #f0f4ff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 1rem;
    border-radius: 4px;
  }
  
  .payment-method-info {
    flex-grow: 1;
  }
  
  .payment-method-name {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  
  .payment-method-description {
    font-size: 0.85rem;
    color: #666;
  }
  
  .summary-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  
  .summary-total {
    font-weight: 700;
    font-size: 1.1rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #eee;
  }
  
  @media (max-width: 768px) {
    .event-info-bar {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
{% endblock %}

{% block content %}
<div class="container py-4">
  <div class="registration-container">
    <!-- En-tête de l'événement -->
    <div class="event-header">
      <div class="event-banner" style="background-image: url('{% if event.image %}{{ event.image.url }}{% else %}{% static 'images/event-default.jpg' %}{% endif %}');">
        <div class="event-banner-overlay">
          <span class="event-type-badge {{ event.event_type }}">{{ event.get_event_type_display }}</span>
          <h1 class="event-title">{{ event.title }}</h1>
        </div>
      </div>
      <div class="event-info-bar">
        <div class="event-info-item">
          <div class="event-info-icon">
            <i class="fas fa-calendar-alt"></i>
          </div>
          <div class="event-info-text">
            {{ event.start_date|date:"d M Y" }}
            {% if event.end_date and event.end_date != event.start_date %}
              - {{ event.end_date|date:"d M Y" }}
            {% endif %}
          </div>
        </div>
        <div class="event-info-item">
          <div class="event-info-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="event-info-text">
            {% if event.all_day %}
              {% trans "Toute la journée" %}
            {% else %}
              {{ event.start_time|time:"H:i" }}
              {% if event.end_time %} - {{ event.end_time|time:"H:i" }}{% endif %}
            {% endif %}
          </div>
        </div>
        <div class="event-info-item">
          <div class="event-info-icon">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <div class="event-info-text">
            {% if event.location %}{{ event.location }}{% else %}{% trans "Non spécifié" %}{% endif %}
          </div>
        </div>
        {% if event.price > 0 %}
        <div class="event-info-item">
          <div class="event-info-icon">
            <i class="fas fa-tag"></i>
          </div>
          <div class="event-info-text">
            <strong>{{ event.price }} €</strong>
          </div>
        </div>
        {% endif %}
      </div>
    </div>
    
    <!-- Messages d'alerte -->
    {% if messages %}
      <div class="messages mb-4">
        {% for message in messages %}
          <div class="alert alert-{{ message.tags }} alert-dismissible fade show">
            <i class="fas {% if message.tags == 'success' %}fa-check-circle{% elif message.tags == 'error' %}fa-exclamation-circle{% elif message.tags == 'warning' %}fa-exclamation-triangle{% else %}fa-info-circle{% endif %} me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    
    <!-- Formulaire d'inscription -->
    <form method="post" action="{% url 'competitions:events:register_for_event' event.id %}">
      {% csrf_token %}
      
      <div class="registration-card">
        <div class="registration-header">
          <h2 class="registration-title">
            <i class="fas fa-user-plus"></i> {% trans "Inscription à l'événement" %}
          </h2>
        </div>
        <div class="registration-body">
          <!-- Informations personnelles -->
          <div class="mb-4">
            <h3 class="h5 mb-3">{% trans "Vos informations" %}</h3>
            
            <div class="row g-3">
              <div class="col-md-6">
                <label for="{{ form.first_name.id_for_label }}" class="form-label">{% trans "Prénom" %}</label>
                <input type="text" name="{{ form.first_name.name }}" id="{{ form.first_name.id_for_label }}" class="form-control {% if form.first_name.errors %}is-invalid{% endif %}" value="{{ form.first_name.value|default:user.first_name }}" required>
                {% if form.first_name.errors %}
                  <div class="invalid-feedback">{{ form.first_name.errors.0 }}</div>
                {% endif %}
              </div>
              <div class="col-md-6">
                <label for="{{ form.last_name.id_for_label }}" class="form-label">{% trans "Nom" %}</label>
                <input type="text" name="{{ form.last_name.name }}" id="{{ form.last_name.id_for_label }}" class="form-control {% if form.last_name.errors %}is-invalid{% endif %}" value="{{ form.last_name.value|default:user.last_name }}" required>
                {% if form.last_name.errors %}
                  <div class="invalid-feedback">{{ form.last_name.errors.0 }}</div>
                {% endif %}
              </div>
              <div class="col-md-6">
                <label for="{{ form.email.id_for_label }}" class="form-label">{% trans "E-mail" %}</label>
                <input type="email" name="{{ form.email.name }}" id="{{ form.email.id_for_label }}" class="form-control {% if form.email.errors %}is-invalid{% endif %}" value="{{ form.email.value|default:user.email }}" required>
                {% if form.email.errors %}
                  <div class="invalid-feedback">{{ form.email.errors.0 }}</div>
                {% endif %}
              </div>
              <div class="col-md-6">
                <label for="{{ form.phone.id_for_label }}" class="form-label">{% trans "Téléphone" %}</label>
                <input type="tel" name="{{ form.phone.name }}" id="{{ form.phone.id_for_label }}" class="form-control {% if form.phone.errors %}is-invalid{% endif %}" value="{{ form.phone.value|default:'' }}">
                {% if form.phone.errors %}
                  <div class="invalid-feedback">{{ form.phone.errors.0 }}</div>
                {% endif %}
              </div>
            </div>
          </div>
          
          <!-- Notes ou informations complémentaires -->
          <div class="mb-4">
            <label for="{{ form.notes.id_for_label }}" class="form-label">{% trans "Notes ou informations complémentaires" %}</label>
            <textarea name="{{ form.notes.name }}" id="{{ form.notes.id_for_label }}" class="form-control {% if form.notes.errors %}is-invalid{% endif %}" rows="3" placeholder="{% trans 'Exigences alimentaires, besoins particuliers, etc.' %}">{{ form.notes.value|default:'' }}</textarea>
            {% if form.notes.errors %}
              <div class="invalid-feedback">{{ form.notes.errors.0 }}</div>
            {% endif %}
          </div>
          
          <!-- Options supplémentaires si l'événement en a -->
          {% if event.has_options %}
          <div class="mb-4">
            <h3 class="h5 mb-3">{% trans "Options supplémentaires" %}</h3>
            
            {% for option in event.options.all %}
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" name="options" value="{{ option.id }}" id="option_{{ option.id }}" {% if option.id in selected_options %}checked{% endif %} data-price="{{ option.price }}">
              <label class="form-check-label" for="option_{{ option.id }}">
                {{ option.name }} - {{ option.price }} €
                {% if option.description %}
                <div class="text-muted small">{{ option.description }}</div>
                {% endif %}
              </label>
            </div>
            {% endfor %}
          </div>
          {% endif %}
          
          <!-- Méthodes de paiement si l'événement est payant -->
          {% if event.price > 0 %}
          <div class="payment-options">
            <h3 class="h5 mb-3">{% trans "Mode de paiement" %}</h3>
            
            <div class="payment-methods">
              <div class="payment-method" data-method="credit_card">
                <div class="payment-method-logo">
                  <i class="fas fa-credit-card fa-2x text-primary"></i>
                </div>
                <div class="payment-method-info">
                  <div class="payment-method-name">{% trans "Carte de crédit" %}</div>
                  <div class="payment-method-description">{% trans "Visa, Mastercard, American Express" %}</div>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="payment_method" id="payment_credit_card" value="credit_card" checked>
                </div>
              </div>
              
              <div class="payment-method" data-method="paypal">
                <div class="payment-method-logo">
                  <i class="fab fa-paypal fa-2x text-primary"></i>
                </div>
                <div class="payment-method-info">
                  <div class="payment-method-name">PayPal</div>
                  <div class="payment-method-description">{% trans "Paiement sécurisé avec PayPal" %}</div>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="payment_method" id="payment_paypal" value="paypal">
                </div>
              </div>
              
              <div class="payment-method" data-method="bank_transfer">
                <div class="payment-method-logo">
                  <i class="fas fa-university fa-2x text-primary"></i>
                </div>
                <div class="payment-method-info">
                  <div class="payment-method-name">{% trans "Virement bancaire" %}</div>
                  <div class="payment-method-description">{% trans "Les coordonnées bancaires vous seront envoyées par email" %}</div>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="payment_method" id="payment_bank_transfer" value="bank_transfer">
                </div>
              </div>
              
              <div class="payment-method" data-method="on_site">
                <div class="payment-method-logo">
                  <i class="fas fa-money-bill-wave fa-2x text-primary"></i>
                </div>
                <div class="payment-method-info">
                  <div class="payment-method-name">{% trans "Paiement sur place" %}</div>
                  <div class="payment-method-description">{% trans "En espèces ou par carte le jour de l'événement" %}</div>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="payment_method" id="payment_on_site" value="on_site">
                </div>
              </div>
            </div>
            
            <!-- Résumé de la commande -->
            <div class="card mt-4">
              <div class="card-header">
                <h3 class="h5 mb-0">{% trans "Résumé" %}</h3>
              </div>
              <div class="card-body">
                <div class="summary-item">
                  <span>{{ event.title }}</span>
                  <span>{{ event.price }} €</span>
                </div>
                
                {% if event.has_options %}
                <div id="selected-options">
                  <!-- Les options sélectionnées seront ajoutées ici via JS -->
                </div>
                {% endif %}
                
                <div class="summary-item summary-total">
                  <span>{% trans "Total" %}</span>
                  <span id="total-price">{{ event.price }} €</span>
                </div>
              </div>
            </div>
          </div>
          {% endif %}
          
          <!-- Conditions générales -->
          <div class="mt-4">
            <h3 class="h5 mb-3">{% trans "Conditions générales" %}</h3>
            
            <div class="terms-scroll">
              <p><strong>{% trans "Conditions de participation" %}</strong></p>
              <p>{% trans "En vous inscrivant à cet événement, vous acceptez les conditions suivantes :" %}</p>
              <ul>
                <li>{% trans "Vous vous engagez à respecter le règlement de l'organisateur." %}</li>
                <li>{% trans "Vous confirmez que les informations fournies sont exactes." %}</li>
                <li>{% trans "Vous acceptez d'être contacté par l'organisateur concernant cet événement." %}</li>
                {% if event.price > 0 %}
                <li>{% trans "En cas d'annulation de votre part moins de 48h avant l'événement, aucun remboursement ne sera effectué." %}</li>
                {% endif %}
              </ul>
              
              <p><strong>{% trans "Politique de confidentialité" %}</strong></p>
              <p>{% trans "Vos données personnelles seront utilisées uniquement dans le cadre de cet événement et ne seront pas partagées avec des tiers sans votre consentement." %}</p>
            </div>
            
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="accept_terms" name="accept_terms" required>
              <label class="form-check-label" for="accept_terms">
                {% trans "J'accepte les conditions générales" %} *
              </label>
            </div>
            
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="accept_marketing" name="accept_marketing">
              <label class="form-check-label" for="accept_marketing">
                {% trans "J'accepte de recevoir des informations sur les prochains événements" %}
              </label>
            </div>
          </div>
        </div>
        <div class="registration-footer">
          <a href="{% url 'competitions:events:event_detail' event.id %}" class="btn btn-outline-secondary me-2">
            <i class="fas fa-arrow-left me-1"></i> {% trans "Retour" %}
          </a>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-check me-1"></i> 
            {% if event.price > 0 %}
              {% trans "Finaliser l'inscription et payer" %}
            {% else %}
              {% trans "Finaliser l'inscription" %}
            {% endif %}
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Sélection de la méthode de paiement
    const paymentMethods = document.querySelectorAll('.payment-method');
    
    if (paymentMethods.length > 0) {
      paymentMethods.forEach(method => {
        method.addEventListener('click', function() {
          // Désélectionner tous les autres
          paymentMethods.forEach(m => m.classList.remove('selected'));
          
          // Sélectionner celui-ci
          this.classList.add('selected');
          
          // Cocher le radio button
          const radio = this.querySelector('input[type="radio"]');
          radio.checked = true;
        });
      });
      
      // Sélectionner le premier par défaut
      paymentMethods[0].classList.add('selected');
    }
    
    // Calcul du prix total avec les options
    const optionCheckboxes = document.querySelectorAll('input[name="options"]');
    const totalPriceElement = document.getElementById('total-price');
    const selectedOptionsContainer = document.getElementById('selected-options');
    
    if (optionCheckboxes.length > 0 && totalPriceElement) {
      const basePrice = {{ event.price }};
      
      function updateTotalPrice() {
        let totalPrice = basePrice;
        let selectedOptionsHTML = '';
        
        optionCheckboxes.forEach(checkbox => {
          if (checkbox.checked) {
            const optionPrice = parseFloat(checkbox.dataset.price) || 0;
            totalPrice += optionPrice;
            
            const optionLabel = checkbox.nextElementSibling.textContent.split('-')[0].trim();
            selectedOptionsHTML += `
              <div class="summary-item">
                <span>${optionLabel}</span>
                <span>${optionPrice} €</span>
              </div>
            `;
          }
        });
        
        if (selectedOptionsContainer) {
          selectedOptionsContainer.innerHTML = selectedOptionsHTML;
        }
        
        totalPriceElement.textContent = `${totalPrice.toFixed(2)} €`;
      }
      
      // Mettre à jour le prix initialement
      updateTotalPrice();
      
      // Mettre à jour le prix quand une option est (dé)cochée
      optionCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateTotalPrice);
      });
    }
  });
</script>
{% endblock %}