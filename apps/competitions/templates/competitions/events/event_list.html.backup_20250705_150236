{% block extra_js %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Basculement entre les vues Grille et Calendrier
    const gridViewBtn = document.getElementById('gridViewBtn');
    const calendarViewBtn = document.getElementById('calendarViewBtn');
    const gridView = document.getElementById('gridView');
    const calendarView = document.getElementById('calendarView');
    
    gridViewBtn.addEventListener('click', function() {
      gridView.style.display = 'grid';
      calendarView.style.display = 'none';
      gridViewBtn.classList.add('active');
      calendarViewBtn.classList.remove('active');
    });
    
    calendarViewBtn.addEventListener('click', function() {
      gridView.style.display = 'none';
      calendarView.style.display = 'block';
      gridViewBtn.classList.remove('active');
      calendarViewBtn.classList.add('active');
      renderCalendar();
    });
    
    // Variables pour le calendrier
    let currentDate = new Date();
    let currentMonth = currentDate.getMonth();
    let currentYear = currentDate.getFullYear();
    
    // Données des événements (à remplacer par vos données réelles)
    const eventsData = [
      {% for event in events %}
      {
        id: "{{ event.id }}",
        title: "{{ event.title|escapejs }}",
        start_date: "{{ event.start_date|date:'Y-m-d' }}",
        end_date: "{{ event.end_date|date:'Y-m-d' }}",
        start_time: "{{ event.start_time|time:'H:i' }}",
        end_time: "{{ event.end_time|time:'H:i' }}",
        all_day: {% if event.all_day %}true{% else %}false{% endif %},
        location: "{{ event.location|default:_('Non spécifié')|escapejs }}",
        type: "{{ event.event_type }}",
        type_display: "{{ event.get_event_type_display }}",
        url: "{% url 'competitions:events:event_detail' event.id %}",
        status: "{% if event.is_cancelled %}cancelled{% elif event.is_ongoing %}ongoing{% elif event.is_upcoming %}upcoming{% else %}past{% endif %}"
      },
      {% endfor %}
    ];
    
    // Navigation dans le calendrier
    const prevMonthBtn = document.getElementById('prevMonth');
    const nextMonthBtn = document.getElementById('nextMonth');
    const todayBtn = document.getElementById('todayBtn');
    const currentMonthDisplay = document.getElementById('currentMonthDisplay');
    
    prevMonthBtn.addEventListener('click', function() {
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      renderCalendar();
    });
    
    nextMonthBtn.addEventListener('click', function() {
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      renderCalendar();
    });
    
    todayBtn.addEventListener('click', function() {
      currentMonth = currentDate.getMonth();
      currentYear = currentDate.getFullYear();
      renderCalendar();
    });
    
    // Fonction pour rendre le calendrier
    function renderCalendar() {
      const monthNames = [
        "{% trans 'Janvier' %}",
        "{% trans 'Février' %}",
        "{% trans 'Mars' %}",
        "{% trans 'Avril' %}",
        "{% trans 'Mai' %}",
        "{% trans 'Juin' %}",
        "{% trans 'Juillet' %}",
        "{% trans 'Août' %}",
        "{% trans 'Septembre' %}",
        "{% trans 'Octobre' %}",
        "{% trans 'Novembre' %}",
        "{% trans 'Décembre' %}"
      ];
      
      currentMonthDisplay.textContent = `${monthNames[currentMonth]} ${currentYear}`;
      
      const calendarGrid = document.querySelector('.calendar-grid');
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      const firstDayOfMonth = new Date(currentYear, currentMonth, 1).getDay();
      
      // Supprimer tous les jours précédents (sauf les en-têtes)
      const dayElements = calendarGrid.querySelectorAll('.calendar-day');
      dayElements.forEach(day => day.remove());
      
      // Ajouter les jours du mois actuel
      for (let i = 0; i < firstDayOfMonth; i++) {
        const emptyDay = document.createElement('div');
        emptyDay.classList.add('calendar-day', 'empty');
        calendarGrid.appendChild(emptyDay);
      }
      
      for (let i = 1; i <= daysInMonth; i++) {
        const day = document.createElement('div');
        day.classList.add('calendar-day');
        
        const dayNumber = document.createElement('div');
        dayNumber.classList.add('calendar-day-number');
        dayNumber.textContent = i;
        day.appendChild(dayNumber);
        
        // Vérifier si c'est aujourd'hui
        const today = new Date();
        if (i === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear()) {
          day.classList.add('today');
        }
        
        // Rechercher les événements pour ce jour
        const dayDate = new Date(currentYear, currentMonth, i);
        const dayEvents = getEventsForDay(dayDate);
        
        if (dayEvents.length > 0) {
          day.classList.add('has-events');
          
          // Ajouter les 3 premiers événements (limite pour éviter la surcharge)
          dayEvents.slice(0, 3).forEach(event => {
            const eventElement = document.createElement('div');
            eventElement.classList.add('calendar-event', event.type);
            eventElement.textContent = event.title;
            eventElement.setAttribute('data-event-id', event.id);
            day.appendChild(eventElement);
          });
          
          // Indiquer s'il y a plus d'événements
          if (dayEvents.length > 3) {
            const moreEvents = document.createElement('div');
            moreEvents.classList.add('text-center', 'small', 'mt-1');
            moreEvents.textContent = `+${dayEvents.length - 3} {% trans "plus" %}`;
            day.appendChild(moreEvents);
          }
          
          // Ajouter un événement de clic pour afficher les détails
          day.addEventListener('click', function() {
            showEventsForDay(dayDate, dayEvents);
          });
        }
        
        calendarGrid.appendChild(day);
      }
    }
    
    // Fonction pour obtenir les événements pour un jour donné
    function getEventsForDay(date) {
      const formattedDate = formatDate(date);
      return eventsData.filter(event => {
        const startDate = event.start_date;
        const endDate = event.end_date || startDate;
        return formattedDate >= startDate && formattedDate <= endDate;
      });
    }
    
    // Fonction pour formater une date en YYYY-MM-DD
    function formatDate(date) {
      const year = date.getFullYear();
      const month = (date.getMonth() + 1).toString().padStart(2, '0');
      const day = date.getDate().toString().padStart(2, '0');
      return `${year}-${month}-${day}`;
    }
    
    // Fonction pour afficher les événements d'un jour
    function showEventsForDay(date, events) {
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      const formattedDate = date.toLocaleDateString('fr-FR', options);
      
      // Afficher dans un modal sur desktop
      const modalBody = document.getElementById('eventDetailsModalBody');
      modalBody.innerHTML = `
        <h5>${formattedDate}</h5>
        <div class="list-group mt-3">
          ${events.map(event => `
            <div class="list-group-item list-group-item-action">
              <div class="d-flex w-100 justify-content-between">
                <h6 class="mb-1">${event.title}</h6>
                <span class="badge bg-${getStatusClass(event.status)}">${event.status}</span>
              </div>
              <p class="mb-1">
                <i class="fas fa-clock me-2 text-muted"></i>
                ${event.all_day ? "{% trans 'Toute la journée' %}" : `${event.start_time}${event.end_time ? ' - ' + event.end_time : ''}`}
              </p>
              <p class="mb-1">
                <i class="fas fa-map-marker-alt me-2 text-muted"></i>
                ${event.location}
              </p>
              <small class="text-muted">
                <i class="fas fa-tag me-1"></i>
                ${event.type_display}
              </small>
              <div class="mt-2">
                <a href="${event.url}" class="btn btn-sm btn-primary">
                  <i class="fas fa-eye me-1"></i> {% trans "Détails" %}
                </a>
              </div>
            </div>
          `).join('')}
        </div>
      `;
      
      // Afficher le modal
      const eventDetailsModal = new bootstrap.Modal(document.getElementById('eventDetailsModal'));
      eventDetailsModal.show();
      
      // Mettre à jour le lien "Voir les détails" pour rediriger vers la liste complète des événements du jour
      document.getElementById('viewEventDetailsBtn').href = `{% url 'competitions:events:event_list' %}?date=${formatDate(date)}`;
    }
    
    // Fonction pour obtenir la classe CSS du statut
    function getStatusClass(status) {
      switch (status) {
        case 'upcoming':
          return 'primary';
        case 'ongoing':
          return 'success';
        case 'past':
          return 'secondary';
        case 'cancelled':
          return 'danger';
        default:
          return 'secondary';
      }
    }
    
    // Initialiser le calendrier si la vue est active
    if (calendarView.style.display !== 'none') {
      renderCalendar();
    }
  });
</script>
{% endblock %}