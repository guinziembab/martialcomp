{% extends "base.html" %}
{% load i18n %}
{% load static %}

{% block title %}{% translate "Détail de la réponse" %} - {{ survey.title }}{% endblock %}

{% block extra_css %}
<style>
    .question-card {
        margin-bottom: 1.5rem;
        border-left: 4px solid #007bff;
    }
    .response-card {
        margin-bottom: 1rem;
        border-left: 4px solid #28a745;
    }
    .no-response {
        color: #6c757d;
        font-style: italic;
    }
</style>
{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>{% translate "Détail de la réponse" %}</h1>
        <div>
            <a href="{% url 'competitions:events:surveys:survey_detail' survey_id=survey.id %}" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> {% translate "Retour au sondage" %}
            </a>
            <a href="{% url 'competitions:events:surveys:survey_results' survey_id=survey.id %}" class="btn btn-outline-info ms-2">
                <i class="fas fa-chart-bar"></i> {% translate "Tous les résultats" %}
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h2 class="card-title h5 mb-0">{{ survey.title }}</h2>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <p>{{ survey.description }}</p>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header bg-light">
                            {% translate "Informations de la réponse" %}
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item">
                                    <strong>{% translate "Participant" %}:</strong> 
                                    {% if response.is_anonymous %}
                                        <i class="fas fa-user-secret"></i> {% translate "Anonyme" %}
                                    {% elif response.participant %}
                                        <i class="fas fa-user"></i> {{ response.participant.get_full_name|default:response.participant.username }}
                                    {% elif response.respondent_name %}
                                        <i class="fas fa-user"></i> {{ response.respondent_name }}
                                        {% if response.respondent_email %}
                                            <small class="text-muted d-block">{{ response.respondent_email }}</small>
                                        {% endif %}
                                    {% else %}
                                        <i class="fas fa-user-times"></i> {% translate "Non identifié" %}
                                    {% endif %}
                                </li>
                                <li class="list-group-item">
                                    <strong>{% translate "Date de soumission" %}:</strong> 
                                    {{ response.submitted_at|date:"d/m/Y H:i" }}
                                </li>
                                <li class="list-group-item">
                                    <strong>{% translate "Temps de complétion" %}:</strong> 
                                    {% if response.completion_time %}
                                        {{ response.completion_time }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </li>
                                {% if response.ip_address %}
                                    <li class="list-group-item">
                                        <strong>{% translate "Adresse IP" %}:</strong> 
                                        {{ response.ip_address }}
                                    </li>
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mb-3">{% translate "Réponses aux questions" %}</h2>
    
    {% for question in questions %}
        <div class="card question-card mb-4">
            <div class="card-header bg-light">
                <h3 class="card-title h5 mb-0">
                    {{ forloop.counter }}. {{ question.question_text }}
                    {% if question.is_required %}
                        <span class="badge bg-danger">{% translate "Obligatoire" %}</span>
                    {% endif %}
                </h3>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <strong>{% translate "Type" %}:</strong> {{ question.get_question_type_display }}
                    {% if question.help_text %}
                        <div class="text-muted small">
                            <i class="fas fa-info-circle"></i> {{ question.help_text }}
                        </div>
                    {% endif %}
                </div>
                
                <div class="card response-card">
                    <div class="card-body">
                        <h4 class="h6 mb-2">{% translate "Réponse" %}:</h4>
                        
                        {% with qr=responses_by_question|get_item:question.id %}
                            {% if qr %}
                                {% if question.question_type == 'text' or question.question_type == 'textarea' %}
                                    <div class="p-3 bg-light rounded">
                                        {{ qr.text_response|linebreaks|default:"<span class='no-response'>{% trans "Pas de réponse" %}</span>" }}
                                    </div>
                                    
                                {% elif question.question_type == 'single_choice' %}
                                    <div class="p-3 bg-light rounded">
                                        {% if qr.choice_response %}
                                            <span class="badge bg-primary">{{ qr.choice_response.0 }}</span>
                                        {% else %}
                                            <span class="no-response">{% translate "Pas de réponse" %}</span>
                                        {% endif %}
                                    </div>
                                    
                                {% elif question.question_type == 'multiple_choice' %}
                                    <div class="p-3 bg-light rounded">
                                        {% if qr.choice_response %}
                                            {% for choice in qr.choice_response %}
                                                <span class="badge bg-primary me-2">{{ choice }}</span>
                                            {% endfor %}
                                        {% else %}
                                            <span class="no-response">{% translate "Pas de réponse" %}</span>
                                        {% endif %}
                                    </div>
                                    
                                {% elif question.question_type == 'rating' or question.question_type == 'scale' %}
                                    <div class="p-3 bg-light rounded">
                                        {% if qr.numeric_response != None %}
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 me-3">
                                                    <div class="progress-bar bg-success" role="progressbar" 
                                                        style="width: {{ qr.numeric_response|percentage:question.max_value }}%" 
                                                        aria-valuenow="{{ qr.numeric_response }}" 
                                                        aria-valuemin="{{ question.min_value }}" 
                                                        aria-valuemax="{{ question.max_value }}">
                                                        {{ qr.numeric_response }}
                                                    </div>
                                                </div>
                                                <div>
                                                    <strong>{{ qr.numeric_response }} / {{ question.max_value }}</strong>
                                                </div>
                                            </div>
                                        {% else %}
                                            <span class="no-response">{% translate "Pas de réponse" %}</span>
                                        {% endif %}
                                    </div>
                                    
                                {% elif question.question_type == 'date' %}
                                    <div class="p-3 bg-light rounded">
                                        {% if qr.date_response %}
                                            <i class="fas fa-calendar-alt me-2"></i> {{ qr.date_response|date:"d/m/Y" }}
                                        {% else %}
                                            <span class="no-response">{% translate "Pas de réponse" %}</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% else %}
                                <span class="no-response">{% translate "Pas de réponse" %}</span>
                            {% endif %}
                        {% endwith %}
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
    
    <div class="d-flex justify-content-between mt-4 mb-5">
        <a href="{% url 'competitions:events:surveys:survey_results' survey_id=survey.id %}" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left"></i> {% translate "Retour aux résultats" %}
        </a>
        
        {% if survey.event %}
            <a href="{% url 'competitions:events:event_detail' event_id=survey.event.id %}" class="btn btn-outline-info">
                <i class="fas fa-calendar-alt"></i> {% translate "Voir l'événement" %}
            </a>
        {% endif %}
    </div>
</div>
{% endblock %}