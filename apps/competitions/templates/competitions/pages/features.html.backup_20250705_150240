{% extends "base.html" %}
{% load static %}
{% load i18n %}

{% block title %}Fonctionnalités - MartialComp{% endblock %}

{% block content %}
<style>
    /* Styles spécifiques à la page fonctionnalités */
    :root {
        --primary: #c41e3a;
        --secondary: #1a1a1a;
        --accent: #d4af37;
        --light: #f5f5f5;
        --dark: #121212;
    }
    
    body {
        background-color: var(--dark);
        color: var(--light);
    }
    
    .page-header {
        background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url("{% static 'competitions/images/features-bg.jpg' %}");
        background-size: cover;
        background-position: center;
        padding: 100px 0;
        text-align: center;
        margin-bottom: 3rem;
    }
    
    .page-title {
        font-size: 3rem;
        color: var(--light);
        margin-bottom: 1rem;
        position: relative;
        display: inline-block;
    }
    
    .page-title::after {
        content: '';
        position: absolute;
        width: 80px;
        height: 4px;
        background-color: var(--accent);
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
    }
    
    .page-subtitle {
        font-size: 1.2rem;
        max-width: 800px;
        margin: 0 auto;
        color: var(--light);
    }
    
    .features-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }
    
    .feature-section {
        margin-bottom: 5rem;
    }
    
    .section-title {
        font-size: 2rem;
        color: var(--accent);
        margin-bottom: 2rem;
        position: relative;
        padding-bottom: 0.5rem;
    }
    
    .section-title::after {
        content: '';
        position: absolute;
        width: 60px;
        height: 3px;
        background-color: var(--primary);
        bottom: 0;
        left: 0;
    }
    
    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }
    
    .feature-card {
        background-color: var(--secondary);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
        height: 100%;
    }
    
    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
    }
    
    .feature-image {
        height: 200px;
        background-color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--light);
        font-size: 3rem;
    }
    
    .feature-content {
        padding: 1.5rem;
    }
    
    .feature-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--accent);
    }
    
    .feature-desc {
        color: var(--light);
        margin-bottom: 1rem;
        line-height: 1.6;
    }
    
    .cta-section {
        background-color: var(--secondary);
        padding: 5rem 2rem;
        text-align: center;
        margin-top: 3rem;
    }
    
    .cta-title {
        font-size: 2.5rem;
        color: var(--light);
        margin-bottom: 1.5rem;
    }
    
    .cta-text {
        font-size: 1.2rem;
        color: var(--light);
        max-width: 800px;
        margin: 0 auto 2rem;
    }
    
    .cta-button {
        background-color: var(--primary);
        color: var(--light);
        border: none;
        padding: 1rem 2rem;
        border-radius: 4px;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-block;
        text-decoration: none;
    }
    
    .cta-button:hover {
        background-color: #a51a30;
        transform: translateY(-3px);
    }
</style>

<div class="page-header">
    <h1 class="page-title">{% trans "Fonctionnalités" %}</h1>
    <p class="page-subtitle">{% trans "Découvrez l'ensemble des outils puissants que MartialComp met à votre disposition pour gérer vos compétitions d'arts martiaux" %}</p>
</div>

<div class="features-container">
    <div class="feature-section">
        <h2 class="section-title">{% trans "Planification et organisation" %}</h2>
        <p>{% trans "Simplifiez la préparation de vos événements grâce à nos outils de planification avancés" %}</p>
        
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-image">📅</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Gestion du calendrier" %}</h3>
                    <p class="feature-desc">{% trans "Planifiez vos tournois avec un calendrier interactif. Évitez les conflits de dates et organisez efficacement votre saison sportive." %}</p>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-image">🏆</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Formats de compétitions" %}</h3>
                    <p class="feature-desc">{% trans "Créez des tournois en élimination directe, en poules, en round-robin ou personnalisez votre propre format selon vos besoins." %}</p>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-image">📋</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Gestion des inscriptions" %}</h3>
                    <p class="feature-desc">{% trans "Collectez facilement les informations des participants, définissez vos critères d'admission et gérez les frais d'inscription en ligne." %}</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="feature-section">
        <h2 class="section-title">{% trans "Gestion des participants" %}</h2>
        <p>{% trans "Organisez vos athlètes efficacement selon leurs spécificités" %}</p>
        
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-image">⚖️</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Catégories de poids" %}</h3>
                    <p class="feature-desc">{% trans "Créez et personnalisez les catégories de poids selon les standards de votre discipline ou vos besoins spécifiques." %}</p>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-image">👶</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Catégories d'âge" %}</h3>
                    <p class="feature-desc">{% trans "Définissez des groupes d'âge pour garantir des compétitions équitables pour tous les participants, des enfants aux vétérans." %}</p>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-image">🥋</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Niveaux et grades" %}</h3>
                    <p class="feature-desc">{% trans "Organisez les compétiteurs selon leur niveau technique pour des affrontements équilibrés et formateurs." %}</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="feature-section">
        <h2 class="section-title">{% trans "Outils pour les juges et arbitres" %}</h2>
        <p>{% trans "Facilitez le travail du corps arbitral avec nos solutions intuitives" %}</p>
        
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-image">📊</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Notation électronique" %}</h3>
                    <p class="feature-desc">{% trans "Système de notation en temps réel pour les juges, avec validation instantanée et calcul automatique des scores." %}</p>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-image">⏱️</div>
                <div class="feature-content">
                    <h3 class="feature-title">Chronométrage</h3>
                    <p class="feature-desc">{% trans "Chronométrage précis avec affichage pour le public et les compétiteurs, signaux sonores personnalisables." %}</p>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-image">🔄</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Rotation des juges" %}</h3>
                    <p class="feature-desc">{% trans "Planifiez automatiquement la rotation des juges pour éviter les conflits d'intérêts et garantir l'équité." %}</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="feature-section">
        <h2 class="section-title">{% trans "Expérience spectateur" %}</h2>
        <p>{% trans "Offrez une expérience immersive et interactive au public" %}</p>
        
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-image">📱</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Affichage des scores en direct" %}</h3>
                    <p class="feature-desc">{% trans "Le public peut suivre en temps réel l'évolution des scores sur leurs appareils mobiles ou sur les écrans du lieu de compétition." %}</p>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-image">📺</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Diffusion en ligne" %}</h3>
                    <p class="feature-desc">{% trans "Diffusez vos compétitions en direct sur internet, avec intégration des scores et des statistiques." %}</p>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-image">🔔</div>
                <div class="feature-content">
                    <h3 class="feature-title">{% trans "Notifications personnalisées" %}</h3>
                    <p class="feature-desc">{% trans "Les spectateurs peuvent configurer des alertes pour suivre leurs athlètes ou équipes préférés." %}</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="cta-section">
    <h2 class="cta-title">{% trans "Prêt à révolutionner vos compétitions ?" %}</h2>
    <p class="cta-text">{% trans "Rejoignez les centaines d'organisateurs qui font déjà confiance à MartialComp pour gérer leurs événements d'arts martiaux." %}</p>
    <a href="{% url 'account_signup' %}" class="cta-button">{% trans "Commencer maintenant" %}</a>
</div>
{% endblock %}