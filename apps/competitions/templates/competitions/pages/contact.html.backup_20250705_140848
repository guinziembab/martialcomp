{% extends "base.html" %}
{% load static %}

{% block title %}Contact - MartialComp{% endblock %}

{% block content %}
<style>
    /* Styles spécifiques à la page contact */
    :root {
        --primary: #c41e3a;
        --secondary: #1a1a1a;
        --accent: #d4af37;
        --light: #f5f5f5;
        --dark: #121212;
    }
    
    body {
        background-color: var(--dark);
        color: var(--light);
    }
    
    .page-header {
        background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url("{% static 'competitions/images/contact-bg.jpg' %}");
        background-size: cover;
        background-position: center;
        padding: 100px 0;
        text-align: center;
        margin-bottom: 3rem;
    }
    
    .page-title {
        font-size: 3rem;
        color: var(--light);
        margin-bottom: 1rem;
        position: relative;
        display: inline-block;
    }
    
    .page-title::after {
        content: '';
        position: absolute;
        width: 80px;
        height: 4px;
        background-color: var(--accent);
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
    }
    
    .page-subtitle {
        font-size: 1.2rem;
        max-width: 800px;
        margin: 0 auto;
        color: var(--light);
    }
    
    .contact-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }
    
    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }
    
    @media (max-width: 768px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }
    
    .contact-info {
        background-color: var(--secondary);
        padding: 2rem;
        border-radius: 8px;
    }
    
    .contact-title {
        font-size: 1.8rem;
        color: var(--accent);
        margin-bottom: 1.5rem;
        position: relative;
        padding-bottom: 0.5rem;
    }
    
    .contact-title::after {
        content: '';
        position: absolute;
        width: 50px;
        height: 3px;
        background-color: var(--primary);
        bottom: 0;
        left: 0;
    }
    
    .contact-items {
        margin-top: 2rem;
    }
    
    .contact-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }
    
    .contact-icon {
        width: 40px;
        height: 40px;
        background-color: rgba(196, 30, 58, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        color: var(--primary);
        font-size: 1.2rem;
    }
    
    .contact-item-content {
        flex: 1;
    }
    
    .contact-item-label {
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 0.3rem;
    }
    
    .social-links {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }
    
    .social-link {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: var(--secondary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--light);
        text-decoration: none;
        transition: all 0.3s ease;
        border: 1px solid #444;
    }
    
    .social-link:hover {
        background-color: var(--primary);
        transform: translateY(-3px);
    }
    
    .contact-form {
        background-color: var(--secondary);
        padding: 2rem;
        border-radius: 8px;
    }
    
    .form-group {
        margin-bottom: 1.5rem;
    }
    
    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--light);
        font-weight: 600;
    }
    
    .form-control {
        width: 100%;
        padding: 0.8rem;
        border-radius: 4px;
        border: 1px solid #444;
        background-color: #333;
        color: var(--light);
        transition: all 0.3s ease;
    }
    
    .form-control:focus {
        border-color: var(--accent);
        outline: none;
    }
    
    textarea.form-control {
        min-height: 150px;
        resize: vertical;
    }
    
    .submit-button {
        background-color: var(--primary);
        color: var(--light);
        border: none;
        padding: 1rem 2rem;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
        width: 100%;
    }
    
    .submit-button:hover {
        background-color: #a51a30;
        transform: translateY(-2px);
    }
    
    .contact-help {
        margin-top: 4rem;
    }
    
    .faq-section {
        margin-top: 3rem;
    }
    
    .faq-title {
        font-size: 1.8rem;
        color: var(--light);
        margin-bottom: 1.5rem;
        position: relative;
        padding-bottom: 0.5rem;
    }
    
    .faq-title::after {
        content: '';
        position: absolute;
        width: 60px;
        height: 3px;
        background-color: var(--primary);
        bottom: 0;
        left: 0;
    }
    
    .faq-item {
        background-color: var(--secondary);
        border-radius: 8px;
        margin-bottom: 1rem;
        overflow: hidden;
    }
    
    .faq-question {
        padding: 1.2rem;
        cursor: pointer;
        position: relative;
        font-weight: 600;
        color: var(--accent);
    }
    
    .faq-question::after {
        content: "+";
        position: absolute;
        right: 1.2rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.5rem;
        color: var(--accent);
    }
    
    .faq-answer {
        padding: 0 1.2rem 1.2rem;
        line-height: 1.6;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Contact</h1>
    <p class="page-subtitle">Nous sommes à votre écoute pour toute question ou suggestion</p>
</div>

<div class="contact-container">
    <div class="contact-grid">
        <div class="contact-info">
            <h2 class="contact-title">Nos coordonnées</h2>
            <p>N'hésitez pas à nous contacter pour toute demande d'information ou d'assistance technique. Notre équipe est à votre disposition pour vous répondre dans les plus brefs délais.</p>
            
            <div class="contact-items">
                <div class="contact-item">
                    <div class="contact-icon">📍</div>
                    <div class="contact-item-content">
                        <div class="contact-item-label">Adresse</div>
                        <p>123 Rue des Sports, 75001 Paris, France</p>
                    </div>
                </div>
                
                <div class="contact-item">
                    <div class="contact-icon">📞</div>
                    <div class="contact-item-content">
                        <div class="contact-item-label">Téléphone</div>
                        <p>+33 1 23 45 67 89</p>
                    </div>
                </div>
                
                <div class="contact-item">
                    <div class="contact-icon">📧</div>
                    <div class="contact-item-content">
                        <div class="contact-item-label">Email</div>
                        <p>contact@martialcomp.com</p>
                    </div>
                </div>
                
                <div class="contact-item">
                    <div class="contact-icon">⏰</div>
                    <div class="contact-item-content">
                        <div class="contact-item-label">Horaires</div>
                        <p>Lundi - Vendredi: 9h00 - 18h00<br>
                        Support technique: 7j/7 de 8h00 à 22h00</p>
                    </div>
                </div>
            </div>
            
            <div class="social-links">
                <a href="#" class="social-link">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 2H15C13.6739 2 12.4021 2.52678 11.4645 3.46447C10.5268 4.40215 10 5.67392 10 7V10H7V14H10V22H14V14H17L18 10H14V7C14 6.73478 14.1054 6.48043 14.2929 6.29289C14.4804 6.10536 14.7348 6 15 6H18V2Z" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
                
                <a href="#" class="social-link">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M23 3.00005C22.0424 3.67552 20.9821 4.19216 19.86 4.53005C19.2577 3.83756 18.4573 3.34674 17.567 3.12397C16.6767 2.90121 15.7395 2.95724 14.8821 3.2845C14.0247 3.61176 13.2884 4.19445 12.773 4.95376C12.2575 5.71308 11.9877 6.61238 12 7.53005V8.53005C10.2426 8.57561 8.50127 8.18586 6.93101 7.39549C5.36074 6.60513 4.01032 5.43868 3 4.00005C3 4.00005 -1 13 8 17C5.94053 18.398 3.48716 19.099 1 19C10 24 21 19 21 7.50005C20.9991 7.2215 20.9723 6.94364 20.92 6.67005C21.9406 5.66354 22.6608 4.39276 23 3.00005Z" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
                
                <a href="#" class="social-link">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 8C17.5913 8 19.1174 8.63214 20.2426 9.75736C21.3679 10.8826 22 12.4087 22 14V21H18V14C18 13.4696 17.7893 12.9609 17.4142 12.5858C17.0391 12.2107 16.5304 12 16 12C15.4696 12 14.9609 12.2107 14.5858 12.5858C14.2107 12.9609 14 13.4696 14 14V21H10V14C10 12.4087 10.6321 10.8826 11.7574 9.75736C12.8826 8.63214 14.4087 8 16 8Z" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6 9H2V21H6V9Z" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M4 6C5.10457 6 6 5.10457 6 4C6 2.89543 5.10457 2 4 2C2.89543 2 2 2.89543 2 4C2 5.10457 2.89543 6 4 6Z" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
                
                <a href="#" class="social-link">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16Z" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M16 8V8.01" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <rect x="2" y="2" width="20" height="20" rx="5" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>
        </div>
        
        <div class="contact-form">
            <h2 class="contact-title">Nous écrire</h2>
            
            <form method="post">
                {% csrf_token %}
                
                <div class="form-group">
                    <label class="form-label" for="name">Nom complet</label>
                    <input type="text" class="form-control" id="name" name="name" required>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="subject">Sujet</label>
                    <select class="form-control" id="subject" name="subject">
                        <option value="information">Demande d'information</option>
                        <option value="support">Support technique</option>
                        <option value="suggestion">Suggestion</option>
                        <option value="partnership">Proposition de partenariat</option>
                        <option value="other">Autre</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="message">Message</label>
                    <textarea class="form-control" id="message" name="message" required></textarea>
                </div>
                
                <button type="submit" class="submit-button">Envoyer le message</button>
            </form>
        </div>
    </div>
    
    <div class="contact-help">
        <div class="faq-section">
            <h2 class="faq-title">Questions fréquentes</h2>
            
            <div class="faq-item">
                <div class="faq-question">Comment puis-je créer un compte sur MartialComp ?</div>
                <div class="faq-answer">
                    <p>Pour créer un compte sur MartialComp, cliquez sur le bouton "S'inscrire" en haut à droite de la page d'accueil. Remplissez le formulaire avec vos informations et choisissez votre rôle (organisateur, club, arbitre, pratiquant ou spectateur). Vous recevrez un email de confirmation pour activer votre compte.</p>
                </div>
            </div>
            
            <div class="faq-item">
                <div class="faq-question">Quels types de compétitions puis-je organiser avec MartialComp ?</div>
                <div class="faq-answer">
                    <p>MartialComp prend en charge tous les types de compétitions d'arts martiaux : karaté, judo, taekwondo, kung-fu, boxe, et bien d'autres. Vous pouvez organiser des tournois en élimination directe, en poules, en round-robin ou créer vos propres formats personnalisés.</p>
                </div>
            </div>
            
            <div class="faq-item">
                <div class="faq-question">Comment les juges et arbitres peuvent-ils utiliser l'application ?</div>
                <div class="faq-answer">
                    <p>Les juges et arbitres disposent d'une interface dédiée avec un tableau de bord spécifique. Ils peuvent consulter leurs affectations, utiliser le système de notation électronique en temps réel et accéder aux règlements des compétitions. Ils peuvent également mettre à jour leur profil avec leurs qualifications et disponibilités.</p>
                </div>
            </div>
            
            <div class="faq-item">
                <div class="faq-question">Combien coûte l'utilisation de MartialComp ?</div>
                <div class="faq-answer">
                    <p>MartialComp propose plusieurs forfaits adaptés à vos besoins. L'inscription de base est gratuite pour les participants et spectateurs. Pour les clubs et organisateurs, nous proposons des forfaits à partir de 29€/mois avec différentes options. Consultez notre page de tarifs pour plus de détails ou contactez-nous pour une offre personnalisée.</p>
                </div>
            </div>
            
            <div class="faq-item">
                <div class="faq-question">Comment obtenir de l'aide technique pendant une compétition ?</div>
                <div class="faq-answer">
                    <p>Notre équipe de support technique est disponible 7j/7 de 8h à 22h par téléphone, email ou chat en direct. Pour les compétitions importantes, nous proposons également un service d'assistance dédiée. Vous pouvez accéder au support depuis votre tableau de bord ou via la section Contact de notre site.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Script pour les accordéons FAQ
    document.addEventListener('DOMContentLoaded', function() {
        const questions = document.querySelectorAll('.faq-question');
        
        questions.forEach(question => {
            question.addEventListener('click', function() {
                const answer = this.nextElementSibling;
                const isOpen = answer.style.display === 'block';
                
                // Fermer toutes les réponses
                document.querySelectorAll('.faq-answer').forEach(item => {
                    item.style.display = 'none';
                });
                
                // Réinitialiser tous les indicateurs
                document.querySelectorAll('.faq-question').forEach(item => {
                    item.classList.remove('active');
                    item.style.color = '';
                });
                
                // Ouvrir la réponse cliquée si elle était fermée
                if (!isOpen) {
                    answer.style.display = 'block';
                    this.classList.add('active');
                    this.style.color = '#d4af37';
                }
            });
        });
        
        // Ouvrir le premier élément par défaut
        if (questions.length > 0) {
            questions[0].click();
        }
    });
</script>
{% endblock %}