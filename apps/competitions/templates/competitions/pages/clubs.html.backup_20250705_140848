{% extends "base.html" %}
{% load static %}

{% block title %}Clubs - MartialComp{% endblock %}

{% block content %}
<style>
    /* Styles spécifiques à la page clubs */
    :root {
        --primary: #c41e3a;
        --secondary: #1a1a1a;
        --accent: #d4af37;
        --light: #f5f5f5;
        --dark: #121212;
    }
    
    body {
        background-color: var(--dark);
        color: var(--light);
    }
    
    .page-header {
        background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url("{% static 'competitions/images/clubs-bg.jpg' %}");
        background-size: cover;
        background-position: center;
        padding: 100px 0;
        text-align: center;
        margin-bottom: 3rem;
    }
    
    .page-title {
        font-size: 3rem;
        color: var(--light);
        margin-bottom: 1rem;
        position: relative;
        display: inline-block;
    }
    
    .page-title::after {
        content: '';
        position: absolute;
        width: 80px;
        height: 4px;
        background-color: var(--accent);
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
    }
    
    .page-subtitle {
        font-size: 1.2rem;
        max-width: 800px;
        margin: 0 auto;
        color: var(--light);
    }
    
    .clubs-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }
    
    .filters-section {
        background-color: var(--secondary);
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }
    
    .filter-title {
        font-size: 1.2rem;
        color: var(--accent);
        margin-bottom: 1rem;
    }
    
    .filter-form {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }
    
    .form-group {
        margin-bottom: 1rem;
    }
    
    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--light);
    }
    
    .form-control {
        width: 100%;
        padding: 0.7rem;
        border-radius: 4px;
        border: 1px solid #333;
        background-color: #333;
        color: var(--light);
    }
    
    .filter-button {
        background-color: var(--primary);
        color: var(--light);
        border: none;
        padding: 0.7rem 1.5rem;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
    }
    
    .filter-button:hover {
        background-color: #a51a30;
    }
    
    .clubs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 2rem;
    }
    
    .club-card {
        background-color: var(--secondary);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
    }
    
    .club-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
    }
    
    .club-header {
        display: flex;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid #333;
    }
    
    .club-logo {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: var(--primary);
        margin-right: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--light);
        font-weight: 700;
        font-size: 1.5rem;
    }
    
    .club-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--accent);
    }
    
    .club-content {
        padding: 1.5rem;
    }
    
    .club-details {
        margin-bottom: 1.5rem;
    }
    
    .detail-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 0.8rem;
    }
    
    .detail-icon {
        margin-right: 0.8rem;
        color: var(--accent);
        min-width: 20px;
        text-align: center;
    }
    
    .club-description {
        margin-top: 1.5rem;
        line-height: 1.6;
        color: #ccc;
    }
    
    .club-actions {
        display: flex;
        margin-top: 1.5rem;
    }
    
    .club-button {
        flex: 1;
        text-align: center;
        padding: 0.8rem;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
        text-decoration: none;
    }
    
    .view-button {
        background-color: transparent;
        border: 1px solid var(--accent);
        color: var(--accent);
        margin-right: 0.5rem;
    }
    
    .view-button:hover {
        background-color: rgba(212, 175, 55, 0.1);
    }
    
    .join-button {
        background-color: var(--primary);
        border: none;
        color: white;
    }
    
    .join-button:hover {
        background-color: #a51a30;
    }
    
    .discipline-badge {
        display: inline-block;
        padding: 0.3rem 0.6rem;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
        border-radius: 20px;
        background-color: rgba(196, 30, 58, 0.2);
        color: var(--light);
        font-size: 0.9rem;
    }
    
    .pagination {
        display: flex;
        justify-content: center;
        margin-top: 3rem;
    }
    
    .page-item {
        margin: 0 0.3rem;
    }
    
    .page-link {
        display: block;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        background-color: var(--secondary);
        color: var(--light);
        text-decoration: none;
        transition: all 0.3s ease;
    }
    
    .page-link:hover {
        background-color: var(--primary);
    }
    
    .active .page-link {
        background-color: var(--primary);
        color: white;
    }
    
    .map-section {
        margin-top: 4rem;
    }
    
    .map-title {
        font-size: 1.8rem;
        color: var(--light);
        margin-bottom: 1.5rem;
        position: relative;
        padding-bottom: 0.5rem;
    }
    
    .map-title::after {
        content: '';
        position: absolute;
        width: 60px;
        height: 3px;
        background-color: var(--primary);
        bottom: 0;
        left: 0;
    }
    
    .map-container {
        height: 500px;
        background-color: var(--secondary);
        border-radius: 8px;
        overflow: hidden;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Clubs Partenaires</h1>
    <p class="page-subtitle">Découvrez les clubs qui utilisent MartialComp pour leurs compétitions</p>
</div>

<div class="clubs-container">
    <div class="filters-section">
        <h3 class="filter-title">Trouver un club</h3>
        <form class="filter-form">
            <div class="form-group">
                <label class="form-label" for="discipline">Discipline</label>
                <select class="form-control" id="discipline" name="discipline">
                    <option value="">Toutes les disciplines</option>
                    <option value="1">Karaté</option>
                    <option value="2">Judo</option>
                    <option value="3">Taekwondo</option>
                    <option value="4">Kung Fu</option>
                    <option value="5">Boxe</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label" for="location">Ville</label>
                <input type="text" class="form-control" id="location" name="location" placeholder="Entrez une ville">
            </div>
            
            <div class="form-group">
                <label class="form-label" for="name">Nom du club</label>
                <input type="text" class="form-control" id="name" name="name" placeholder="Rechercher par nom">
            </div>
            
            <div class="form-group">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="filter-button">Rechercher</button>
            </div>
        </form>
    </div>
    
    <div class="clubs-grid">
        {% if clubs %}
            {% for club in clubs %}
            <div class="club-card">
                <div class="club-header">
                    <div class="club-logo">
                        {% if club.logo %}
                            <img src="{{ club.logo.url }}" alt="{{ club.name }} logo">
                        {% else %}
                            {{ club.name|slice:":2"|upper }}
                        {% endif %}
                    </div>
                    <h3 class="club-name">{{ club.name }}</h3>
                </div>
                <div class="club-content">
                    <div class="club-details">
                        <div class="detail-item">
                            <span class="detail-icon">📍</span>
                            <span>{{ club.address }}, {{ club.city }}</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-icon">📞</span>
                            <span>{{ club.contact_phone }}</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-icon">📧</span>
                            <span>{{ club.contact_email }}</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-icon">🌐</span>
                            <span>{{ club.website }}</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-icon">🥋</span>
                            <div>
                                {% for discipline in club.disciplines.all %}
                                <span class="discipline-badge">{{ discipline.name }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    
                    <p class="club-description">{{ club.description|truncatechars:150 }}</p>
                    
                    <div class="club-actions">
                        <a href="#" class="club-button view-button">Voir le profil</a>
                        <a href="#" class="club-button join-button">Contacter</a>
                    </div>
                </div>
            </div>
            {% endfor %}
        {% else %}
            <div class="no-clubs">
                <h3>Aucun club trouvé</h3>
                <p>Aucun club ne correspond à vos critères de recherche.</p>
            </div>
        {% endif %}
    </div>
    
    <div class="pagination">
        <div class="page-item {% if not clubs.has_previous %}disabled{% endif %}">
            <a class="page-link" href="?page=1" {% if not clubs.has_previous %}tabindex="-1"{% endif %}>Première</a>
        </div>
        <div class="page-item {% if not clubs.has_previous %}disabled{% endif %}">
            <a class="page-link" href="?page={{ clubs.previous_page_number }}" {% if not clubs.has_previous %}tabindex="-1"{% endif %}>Précédente</a>
        </div>
        
        {% for num in clubs.paginator.page_range %}
            {% if clubs.number == num %}
                <div class="page-item active">
                    <a class="page-link" href="?page={{ num }}">{{ num }}</a>
                </div>
            {% elif num > clubs.number|add:'-3' and num < clubs.number|add:'3' %}
                <div class="page-item">
                    <a class="page-link" href="?page={{ num }}">{{ num }}</a>
                </div>
            {% endif %}
        {% endfor %}
        
        <div class="page-item {% if not clubs.has_next %}disabled{% endif %}">
            <a class="page-link" href="?page={{ clubs.next_page_number }}" {% if not clubs.has_next %}tabindex="-1"{% endif %}>Suivante</a>
        </div>
        <div class="page-item {% if not clubs.has_next %}disabled{% endif %}">
            <a class="page-link" href="?page={{ clubs.paginator.num_pages }}" {% if not clubs.has_next %}tabindex="-1"{% endif %}>Dernière</a>
        </div>
    </div>
    
    <div class="map-section">
        <h2 class="map-title">Carte des clubs</h2>
        <div class="map-container">
            <!-- Intégrer ici une carte Google Maps ou OpenStreetMap -->
            <div style="height: 100%; display: flex; align-items: center; justify-content: center; background-color: #333; color: #fff;">
                Carte interactive des clubs partenaires
            </div>
        </div>
    </div>
</div>
{% endblock %}