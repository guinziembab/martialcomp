{% extends "competitions/dashboard/base.html" %}
{% load i18n static %}

{% block title %}{% trans "Supprimer mon compte" %} - MartialComp{% endblock %}

{% block extra_css %}
<style>
.delete-account-page {
    max-width: 600px;
    margin: 0 auto;
    padding: 2rem;
}
.warning-box {
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin: 1.5rem 0;
}
.warning-box h3 {
    color: #721c24;
    margin-bottom: 1rem;
}
.warning-box p {
    color: #721c24;
    margin-bottom: 0.5rem;
}
.info-box {
    background: #d1ecf1;
    border: 1px solid #bee5eb;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin: 1.5rem 0;
}
.info-box h3 {
    color: #0c5460;
    margin-bottom: 1rem;
}
.info-box p {
    color: #0c5460;
    margin-bottom: 0.5rem;
}
.confirm-input {
    background: #fff;
    border: 2px solid #dc3545;
    border-radius: 0.5rem;
    padding: 0.75rem;
    font-size: 1.1rem;
    text-align: center;
    font-weight: bold;
}
.btn-danger-confirm {
    background: #dc3545;
    border: none;
    padding: 0.75rem 2rem;
    font-size: 1.1rem;
    font-weight: bold;
}
.btn-danger-confirm:hover {
    background: #c82333;
}
.alternative-actions {
    background: #f8f9fa;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin: 2rem 0;
}
</style>
{% endblock %}

{% block content %}
<div class="delete-account-page">
    <h1 class="text-center mb-4 text-danger">
        <i class="fas fa-exclamation-triangle"></i>
        {% trans "Supprimer définitivement mon compte" %}
    </h1>
    
    <div class="warning-box">
        <h3><i class="fas fa-exclamation-triangle"></i> {% trans "Attention : Action irréversible" %}</h3>
        <p><strong>{% trans "Cette action supprimera définitivement :" %}</strong></p>
        <ul>
            <li>{% trans "Votre profil utilisateur et toutes vos informations personnelles" %}</li>
            <li>{% trans "Vos résultats de compétitions et historique sportif" %}</li>
            <li>{% trans "Vos inscriptions aux événements et compétitions" %}</li>
            <li>{% trans "Vos liens avec les clubs et fédérations" %}</li>
            <li>{% trans "Tous vos messages et communications sur la plateforme" %}</li>
        </ul>
        <p><strong>{% trans "Cette suppression est immédiate et ne peut pas être annulée." %}</strong></p>
    </div>

    <div class="info-box">
        <h3><i class="fas fa-info-circle"></i> {% trans "Conformité RGPD" %}</h3>
        <p>{% trans "Conformément au Règlement Général sur la Protection des Données (RGPD), vous avez le droit de demander la suppression de vos données personnelles." %}</p>
        <p>{% trans "Certaines données peuvent être conservées de manière anonyme à des fins statistiques ou pour répondre aux obligations légales." %}</p>
    </div>

    <div class="alternative-actions">
        <h3>{% trans "Alternatives à la suppression" %}</h3>
        <p>{% trans "Avant de supprimer définitivement votre compte, considérez ces alternatives :" %}</p>
        <ul>
            <li><a href="{% url 'profile' %}">{% trans "Modifier vos informations personnelles" %}</a></li>
            <li><a href="{% url 'password_change' %}">{% trans "Changer votre mot de passe" %}</a></li>
            <li>{% trans "Contacter le support : support@martialcomp.com" %}</li>
        </ul>
        <div class="mt-3">
            <a href="{% url 'profile' %}" class="btn btn-secondary me-2">
                <i class="fas fa-user-edit"></i> {% trans "Modifier mon profil" %}
            </a>
            <a href="{% url 'welcome' %}" class="btn btn-primary">
                <i class="fas fa-home"></i> {% trans "Retour à l'accueil" %}
            </a>
        </div>
    </div>

    {% if messages %}
        {% for message in messages %}
            <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endif %}

    <form method="post" onsubmit="return confirmDeletion()">
        {% csrf_token %}
        
        <div class="mb-4">
            <label for="confirm_deletion" class="form-label">
                <strong>{% trans "Pour confirmer la suppression, tapez exactement" %} : <code>DELETE</code></strong>
            </label>
            <input type="text" 
                   class="form-control confirm-input" 
                   id="confirm_deletion" 
                   name="confirm_deletion" 
                   placeholder="{% trans 'Tapez DELETE pour confirmer' %}"
                   required>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-danger btn-danger-confirm">
                <i class="fas fa-trash-alt"></i>
                {% trans "SUPPRIMER DÉFINITIVEMENT MON COMPTE" %}
            </button>
        </div>
    </form>

    <div class="text-center mt-4">
        <small class="text-muted">
            {% trans "En cas de problème, contactez-nous à : support@martialcomp.com" %}
        </small>
    </div>
</div>

<script>
function confirmDeletion() {
    const confirmText = document.getElementById('confirm_deletion').value;
    if (confirmText !== 'DELETE') {
        alert('{% trans "Veuillez taper exactement DELETE pour confirmer la suppression." %}');
        return false;
    }
    
    return confirm('{% trans "Êtes-vous absolument certain de vouloir supprimer définitivement votre compte ? Cette action ne peut pas être annulée." %}');
}
</script>
{% endblock %}