{% block content %}
<div class="container-fluid px-4">
  <!-- En-tête avec bouton retour et breadcrumb -->
  <div class="competition-hub-header">
    <div class="container">
      
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="mb-1 h3">{{ competition.title }}</h1>
          <div class="d-flex gap-3 text-white-50 small">
            <span><i class="fas fa-calendar-alt me-1"></i>{{ competition.start_date|date:"d M Y"|default:"--" }}</span>
            <span><i class="fas fa-trophy me-1"></i>{{ competition.discipline.name|default:"--" }}</span>
            {% if is_ongoing %}
              <span class="badge bg-success">{% trans "EN COURS" %}</span>
            {% elif is_published %}
              <span class="badge bg-primary">{% trans "PUBLIÉE" %}</span>
            {% else %}
              <span class="badge bg-warning">{% trans "BROUILLON" %}</span>
            {% endif %}
          </div>
        </div>
        <div>
          <a href="{% url 'competitions:dashboard:club' %}" class="btn btn-outline-light btn-sm">
            <i class="fas fa-arrow-left me-1"></i>{% trans "Dashboard" %}
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <div class="container">
    <!-- Statistiques rapides -->
    <div class="competition-stats">
      <div class="stat-card">
        <div class="stat-card-value">{{ stats.total_registrations }}</div>
        <div class="stat-card-label">{% trans "Inscriptions" %}</div>
      </div>
      <div class="stat-card">
        <div class="stat-card-value">{{ stats.confirmed_registrations }}</div>
        <div class="stat-card-label">{% trans "Confirmées" %}</div>
      </div>
      <div class="stat-card">
        <div class="stat-card-value">{{ stats.total_categories }}</div>
        <div class="stat-card-label">{% trans "Catégories" %}</div>
      </div>
    </div>
    
    <!-- Navigation par onglets -->
    <ul class="nav nav-tabs hub-tabs" id="hubTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="gestion-tab" data-bs-toggle="tab" data-bs-target="#gestion" type="button" role="tab">
          <i class="fas fa-trophy"></i>
          {% trans "Gestion" %}
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="organisation-tab" data-bs-toggle="tab" data-bs-target="#organisation" type="button" role="tab">
          <i class="fas fa-calendar-alt"></i>
          {% trans "Organisation" %}
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="notation-tab" data-bs-toggle="tab" data-bs-target="#notation" type="button" role="tab">
          <i class="fas fa-clipboard-list"></i>
          {% trans "Notation" %}
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="combat-tab" data-bs-toggle="tab" data-bs-target="#combat" type="button" role="tab">
          <i class="fas fa-fist-raised"></i>
          {% trans "Combat" %}
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="publication-tab" data-bs-toggle="tab" data-bs-target="#publication" type="button" role="tab">
          <i class="fas fa-rocket"></i>
          {% trans "Publication" %}
        </button>
      </li>
    </ul>
    
    <!-- Contenu des onglets -->
    <div class="tab-content" id="hubTabContent">
      <!-- Onglet Gestion -->
      <div class="tab-pane fade show active" id="gestion" role="tabpanel">
        <div class="hub-cards-grid">
          <a href="{% url 'competitions:club:competition_management_pro' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-trophy"></i></div>
            <div class="hub-card-title">{% trans "Gestion Pro Complète" %}</div>
            <div class="hub-card-description">{% trans "Interface avancée pour organisateurs expérimentés" %}</div>
          </a>
          <a href="{% url 'competitions:club:competition_management_detail' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-list"></i></div>
            <div class="hub-card-title">{% trans "Dashboard de Gestion" %}</div>
            <div class="hub-card-description">{% trans "Vue d'ensemble avec statistiques en temps réel" %}</div>
          </a>
          <a href="{% url 'competitions:club:competition_detail' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-chart-line"></i></div>
            <div class="hub-card-title">{% trans "Vue d'Ensemble" %}</div>
            <div class="hub-card-description">{% trans "Tableau de bord complet de la compétition" %}</div>
          </a>
          <a href="{% url 'competitions:competitions:manage_categories' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-layer-group"></i></div>
            <div class="hub-card-title">{% trans "Catégories" %}</div>
            <div class="hub-card-description">{% trans "Gérer les catégories de compétition" %}</div>
          </a>
          <a href="{% url 'competitions:club:judges_list' %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-gavel"></i></div>
            <div class="hub-card-title">{% trans "Juges & Arbitres" %}</div>
            <div class="hub-card-description">{% trans "Gestion des officiels et qualifications" %}</div>
          </a>
          <a href="{% url 'competitions:management:schedule_overview' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-clock"></i></div>
            <div class="hub-card-title">{% trans "Suivi Temps Réel" %}</div>
            <div class="hub-card-description">{% trans "Monitoring live de la compétition" %}</div>
          </a>
        </div>
      </div>
      
      <!-- Onglet Organisation -->
      <div class="tab-pane fade" id="organisation" role="tabpanel">
        <div class="hub-cards-grid">
          <a href="{% url 'competitions:management:schedule_overview' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-calendar-alt"></i></div>
            <div class="hub-card-title">{% trans "Planning & Tatamis" %}</div>
            <div class="hub-card-description">{% trans "Organisation temporelle et spatiale" %}</div>
          </a>
          <a href="{% url 'competitions:management:schedule_edit' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-edit"></i></div>
            <div class="hub-card-title">{% trans "Ordre de Passage" %}</div>
            <div class="hub-card-description">{% trans "Séquencement et ordre des épreuves" %}</div>
          </a>
          <a href="{% url 'competitions:management:judges' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-user-tie"></i></div>
            <div class="hub-card-title">{% trans "Affecter Juges" %}</div>
            <div class="hub-card-description">{% trans "Attribution des juges aux tatamis" %}</div>
          </a>
        </div>
      </div>
      
      <!-- Onglet Notation -->
      <div class="tab-pane fade" id="notation" role="tabpanel">
        {% include "competitions/club/hub/partials/scoring_section.html" %}
      </div>
      
      <!-- Onglet Combat -->
      <div class="tab-pane fade" id="combat" role="tabpanel">
        {% include "competitions/club/hub/partials/combat_section.html" %}
      </div>
      
      <!-- Onglet Publication -->
      <div class="tab-pane fade" id="publication" role="tabpanel">
        <div class="hub-cards-grid">
          <a href="{% url 'competitions:management:schedule_publish' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-rocket"></i></div>
            <div class="hub-card-title">{% trans "Publier Planning" %}</div>
            <div class="hub-card-description">{% trans "Rendre le planning public et accessible" %}</div>
          </a>
          <a href="{% url 'competitions:club:api_publish_competition' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-share-alt"></i></div>
            <div class="hub-card-title">{% trans "Lien Public" %}</div>
            <div class="hub-card-description">{% trans "Générer et partager l'URL publique" %}</div>
          </a>
          <a href="{% url 'competitions:competitions:detail' pk=competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-eye"></i></div>
            <div class="hub-card-title">{% trans "Vue Spectateur" %}</div>
            <div class="hub-card-description">{% trans "Aperçu de la page publique" %}</div>
          </a>
          <a href="{% url 'competitions:management:judges' competition.id %}" class="hub-card">
            <div class="hub-card-icon"><i class="fas fa-file-alt"></i></div>
            <div class="hub-card-title">{% trans "Fiches Notation" %}</div>
            <div class="hub-card-description">{% trans "Distribution des fiches aux juges" %}</div>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

