        <!-- Pagination -->
        {% if practitioners.has_other_pages %}
        <nav aria-label="{% trans 'Navigation des pages' %}" class="mt-4">
            <ul class="pagination justify-content-center">
                {% if practitioners.has_previous %}
                    <li class="page-item">
                        <a class="page-link" href="?{% if request.GET.search %}search={{ request.GET.search }}&{% endif %}{% if request.GET.grade %}grade={{ request.GET.grade }}&{% endif %}{% if request.GET.age_group %}age_group={{ request.GET.age_group }}&{% endif %}{% if request.GET.status %}status={{ request.GET.status }}&{% endif %}page={{ practitioners.previous_page_number }}">
