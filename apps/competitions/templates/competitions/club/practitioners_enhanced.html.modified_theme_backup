{% block extra_js %}
<script>
(function() {
    'use strict';
    
    // Fonction d'initialisation retardée pour s'assurer que tout est chargé
    function initializePractitionersView() {
        console.log('🚀 Initializing practitioners view...');
        
        // Récupération des éléments
        const cardsBtn = document.getElementById('cardsBtn');
        const tableBtn = document.getElementById('tableBtn');
        const cardsView = document.getElementById('cardsView');
        const tableView = document.getElementById('tableView');
        
        // Vérifier que tous les éléments existent
        if (!cardsBtn || !tableBtn || !cardsView || !tableView) {
            console.error('❌ Missing required elements:', {
                cardsBtn: !!cardsBtn,
                tableBtn: !!tableBtn,
                cardsView: !!cardsView,
                tableView: !!tableView
            });
            return;
        }
        
        console.log('✅ All elements found - Setting up view toggle');
        
        // Fonction de bascule de vue
        function switchView(viewType) {
            console.log('🔄 Switching to view:', viewType);
            
            if (viewType === 'cards') {
                // Activer vue cartes
                cardsBtn.classList.add('active');
                tableBtn.classList.remove('active');
                cardsView.classList.remove('d-none');
                tableView.classList.add('d-none');
                localStorage.setItem('practitioners_view', 'cards');
                console.log('✅ Cards view activated');
            } else {
                // Activer vue tableau
                tableBtn.classList.add('active');
                cardsBtn.classList.remove('active');
                cardsView.classList.add('d-none');
                tableView.classList.remove('d-none');
                localStorage.setItem('practitioners_view', 'table');
                console.log('✅ Table view activated');
            }
        }
        
        // Événements de clic
        cardsBtn.addEventListener('click', function(e) {
            e.preventDefault();
            console.log('🖱️ Cards button clicked');
            switchView('cards');
        });
        
        tableBtn.addEventListener('click', function(e) {
            e.preventDefault();
            console.log('🖱️ Table button clicked');
            switchView('table');
        });
        
        // Restaurer la vue sauvegardée
        const savedView = localStorage.getItem('practitioners_view');
        console.log('💾 Saved view preference:', savedView);
        
        if (savedView === 'table') {
            switchView('table');
        } else {
            // Par défaut, afficher les cartes
            switchView('cards');
        }
        
        // Filtrage en temps réel pour la recherche
        const searchInput = document.getElementById('search');
        let searchTimeout;
        
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    console.log('🔍 Submitting search form');
                    document.getElementById('filtersForm').submit();
                }, 800); // Attendre 800ms après la dernière frappe
            });
        }
        
        // Auto-submit pour les select
        document.querySelectorAll('select.filter-input').forEach(select => {
            select.addEventListener('change', function() {
                console.log('🎛️ Filter changed:', this.name, this.value);
                document.getElementById('filtersForm').submit();
            });
        });
        
        console.log('🎉 Practitioners view initialization complete');
    }
    
    // Attendre que le DOM ET Bootstrap soient chargés
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            console.log('📄 DOM loaded');
            // Attendre un peu plus pour s'assurer que Bootstrap est prêt
            setTimeout(initializePractitionersView, 100);
        });
    } else {
        // Le DOM est déjà chargé
        console.log('📄 DOM already loaded');
        setTimeout(initializePractitionersView, 100);
    }
    
    // Fonction d'export globale
    window.exportData = function(format) {
        console.log('📤 Exporting data in format:', format);
        const params = new URLSearchParams(window.location.search);
        params.set('format', format);
        window.location.href = window.location.pathname + '?' + params.toString();
    };
    
    // Amélioration des badges de grades avec tooltips
    function initGradeBadges() {
        const gradeBadges = document.querySelectorAll('.grade-badge[data-color]');
        
        gradeBadges.forEach(badge => {
            const color = badge.getAttribute('data-color');
            const gradeName = badge.textContent.trim();
            
            // Ajouter un titre tooltip avec info couleur
            if (color && color !== '#6c757d') {
                badge.title = `${gradeName} (Couleur: ${color})`;
                
                // Améliorer le contraste pour les grades blancs
                if (color.toUpperCase() === '#FFFFFF') {
                    badge.style.border = '2px solid #dee2e6';
                    badge.style.boxShadow = '0 0 0 1px #adb5bd';
                }
            }
        });
    }
    
    // Initialiser les badges après le chargement
    setTimeout(() => {
        initGradeBadges();
    }, 200);
    
})();
</script>
{% endblock %}