{% extends "base.html" %}
{% load i18n %}
{% load static %}

{% block title %}{% trans "Gestion des pratiquants" %} | Martial Hub{% endblock %}

{% block extra_css %}
<style>
    :root {
        --pl-bg-dark: #0f0f1a;
        --pl-bg-card: #16213e;
        --pl-bg-lighter: #1a1a2e;
        --pl-bg-input: rgba(255, 255, 255, 0.08);
        --pl-gold: #c9a227;
        --pl-gold-light: #d4a42a;
        --pl-text: #eaeaea;
        --pl-text-muted: #a0a0a0;
        --pl-border: rgba(255, 255, 255, 0.1);
        --pl-success: #00d26a;
        --pl-warning: #ffc107;
        --pl-danger: #e94560;
        --pl-info: #3498db;
    }

    body {
        background: linear-gradient(135deg, var(--pl-bg-dark) 0%, var(--pl-bg-lighter) 100%) !important;
        min-height: 100vh;
        color: var(--pl-text);
    }

    /* === STYLES COMMUNS === */
    .practitioners-container {
        background: transparent;
        min-height: 100vh;
        padding: 1.5rem 0;
    }

    .toolbar {
        background: var(--pl-bg-card);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        border: 1px solid var(--pl-border);
    }

    .toolbar h2 {
        color: var(--pl-text);
    }

    .toolbar h2 i {
        color: var(--pl-gold) !important;
    }

    .toolbar .text-muted {
        color: var(--pl-text-muted) !important;
    }

    .view-toggle {
        display: flex;
        background: rgba(0, 0, 0, 0.3);
        border-radius: 10px;
        padding: 4px;
        gap: 4px;
    }

    .view-toggle button {
        flex: 1;
        border: none;
        background: transparent;
        padding: 12px 20px;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-weight: 500;
        color: var(--pl-text-muted);
        cursor: pointer;
    }

    .view-toggle button.active {
        background: linear-gradient(135deg, var(--pl-gold) 0%, var(--pl-gold-light) 100%);
        color: var(--pl-bg-dark);
        box-shadow: 0 4px 15px rgba(201, 162, 39, 0.3);
    }

    .view-toggle button:hover:not(.active) {
        background: rgba(255,255,255,0.1);
        color: var(--pl-text);
    }

    .view-toggle button i {
        margin-right: 0.5rem;
    }

    .filters-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: end;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--pl-border);
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        min-width: 200px;
        flex: 1;
    }

    .filter-group label {
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: var(--pl-text);
        font-size: 0.9rem;
    }

    .filter-input {
        padding: 0.75rem;
        border: 1px solid var(--pl-border);
        border-radius: 8px;
        background: var(--pl-bg-input);
        color: var(--pl-text);
        transition: all 0.3s ease;
    }

    .filter-input::placeholder {
        color: var(--pl-text-muted);
    }

    .filter-input:focus {
        outline: none;
        border-color: var(--pl-gold);
        box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.15);
        background: rgba(255, 255, 255, 0.12);
    }

    .filter-input option {
        background: var(--pl-bg-card);
        color: var(--pl-text);
    }

    /* === STATS BAR === */
    .stats-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin: 2rem 0;
    }

    .stat-card {
        background: var(--pl-bg-card);
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px solid var(--pl-border);
        text-align: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        border-color: var(--pl-gold);
    }

    .stat-card .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: var(--pl-gold);
        display: block;
        margin-bottom: 0.5rem;
    }

    .stat-card .stat-label {
        color: var(--pl-text-muted);
        font-size: 0.9rem;
        font-weight: 500;
    }

    /* === STYLES VUE CARTES === */
    .cards-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .cards-container.d-none {
        display: none !important;
    }

    .practitioner-card {
        background: var(--pl-bg-card);
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid var(--pl-border);
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .practitioner-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 35px rgba(0,0,0,0.3);
        border-color: var(--pl-gold);
    }

    .practitioner-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .practitioner-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--pl-gold) 0%, var(--pl-gold-light) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--pl-bg-dark);
        font-size: 1.5rem;
        font-weight: 600;
        text-transform: uppercase;
        position: relative;
        flex-shrink: 0;
    }

    .practitioner-avatar::after {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 50%;
        border: 2px solid var(--pl-gold);
        opacity: 0.3;
    }

    .practitioner-info h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.2rem;
        font-weight: 600;
        color: #ffffff !important;
    }

    .practitioner-meta {
        font-size: 0.85rem;
        color: var(--pl-text-muted);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .practitioner-meta i {
        color: var(--pl-gold);
    }

    .grade-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        background: rgba(201, 162, 39, 0.15);
        color: var(--pl-gold);
        border: 1px solid rgba(201, 162, 39, 0.3);
    }

    /* Grades Qwan Ki Do - adaptés au thème sombre */
    .grade-cap-jaune { background: rgba(255, 235, 59, 0.15); color: #FFEB3B; border: 1px solid rgba(255, 235, 59, 0.3); }
    .grade-cap-rouge { background: rgba(244, 67, 54, 0.15); color: #F44336; border: 1px solid rgba(244, 67, 54, 0.3); }
    .grade-cap-blanc { background: rgba(255, 255, 255, 0.1); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.3); }
    .grade-cap-bleu { background: rgba(33, 150, 243, 0.15); color: #2196F3; border: 1px solid rgba(33, 150, 243, 0.3); }
    .grade-cap-marron { background: rgba(121, 85, 72, 0.2); color: #a1887f; border: 1px solid rgba(121, 85, 72, 0.4); }
    .grade-cap-noir { background: rgba(0, 0, 0, 0.4); color: var(--pl-gold); border: 1px solid var(--pl-gold); }

    /* Grades supplémentaires */
    .grade-cap-vert { background: rgba(76, 175, 80, 0.15); color: #4CAF50; border: 1px solid rgba(76, 175, 80, 0.3); }
    .grade-cap-orange { background: rgba(255, 152, 0, 0.15); color: #FF9800; border: 1px solid rgba(255, 152, 0, 0.3); }

    /* Indicateur de couleur dans le badge de grade */
    .grade-badge::before {
        content: '';
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-right: 0.5rem;
        border: 1px solid rgba(255,255,255,0.2);
        flex-shrink: 0;
    }

    .grade-badge[data-color]::before {
        background-color: var(--grade-color);
        box-shadow: 0 0 5px var(--grade-color);
    }

    .grade-badge[data-color="#FFFFFF"]::before,
    .grade-badge[data-color="#ffffff"]::before {
        background-color: #ffffff;
        border: 2px solid var(--pl-border);
        box-shadow: 0 0 5px rgba(255,255,255,0.5);
    }

    .practitioner-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-bottom: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--pl-border);
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--pl-text-muted);
    }

    .detail-item i {
        width: 16px;
        color: var(--pl-gold);
        flex-shrink: 0;
    }

    .practitioner-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .btn-action {
        flex: 1;
        padding: 0.6rem;
        border: 1px solid var(--pl-border);
        background: var(--pl-bg-input);
        border-radius: 8px;
        color: var(--pl-text-muted);
        transition: all 0.3s ease;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.85rem;
    }

    .btn-action:hover {
        background: var(--pl-gold);
        color: var(--pl-bg-dark);
        border-color: var(--pl-gold);
        text-decoration: none;
        transform: translateY(-2px);
    }

    .btn-action.btn-primary {
        background: linear-gradient(135deg, var(--pl-gold) 0%, var(--pl-gold-light) 100%);
        color: var(--pl-bg-dark);
        border-color: var(--pl-gold);
        font-weight: 600;
    }

    .btn-action.btn-primary:hover {
        box-shadow: 0 4px 15px rgba(201, 162, 39, 0.4);
    }

    /* === STYLES VUE TABLEAU === */
    .table-container {
        background: var(--pl-bg-card);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        border: 1px solid var(--pl-border);
        margin-top: 2rem;
    }

    .table-container.d-none {
        display: none !important;
    }

    .table-header {
        padding: 1.5rem;
        border-bottom: 1px solid var(--pl-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        background: rgba(0, 0, 0, 0.2);
    }

    .table-header h5 {
        margin: 0;
        color: var(--pl-gold);
    }

    .table-header .badge {
        background: rgba(201, 162, 39, 0.15) !important;
        color: var(--pl-gold) !important;
    }

    .bulk-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .practitioners-table {
        width: 100%;
        margin: 0;
        color: var(--pl-text);
    }

    .practitioners-table th {
        background: rgba(0, 0, 0, 0.3);
        padding: 1rem;
        font-weight: 600;
        color: var(--pl-text-muted);
        border-bottom: 1px solid var(--pl-border);
        font-size: 0.85rem;
        text-transform: uppercase;
    }

    .practitioners-table td {
        padding: 1rem;
        border-bottom: 1px solid var(--pl-border);
        vertical-align: middle;
    }

    .practitioners-table tbody tr:hover {
        background: rgba(201, 162, 39, 0.05);
    }

    .practitioners-table .fw-semibold {
        color: #ffffff !important;
    }

    /* Nom du pratiquant - toujours visible en blanc */
    .practitioners-table td .fw-semibold,
    .practitioners-table tbody td div.fw-semibold,
    .practitioners-table td > div > div > .fw-semibold {
        color: #ffffff !important;
        font-weight: 600 !important;
    }

    .practitioners-table .text-muted {
        color: var(--pl-text-muted) !important;
    }

    /* Badges de statut */
    .badge.bg-success {
        background: rgba(0, 210, 106, 0.2) !important;
        color: var(--pl-success) !important;
    }

    .badge.bg-danger {
        background: rgba(233, 69, 96, 0.2) !important;
        color: var(--pl-danger) !important;
    }

    .badge.bg-info {
        background: rgba(52, 152, 219, 0.2) !important;
        color: var(--pl-info) !important;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--pl-text-muted);
    }

    .empty-state i {
        font-size: 4rem;
        color: var(--pl-gold);
        opacity: 0.5;
        margin-bottom: 1rem;
    }

    .empty-state h4 {
        color: var(--pl-text);
        margin-bottom: 1rem;
    }

    /* Boutons Bootstrap Override */
    .btn-primary {
        background: linear-gradient(135deg, var(--pl-gold) 0%, var(--pl-gold-light) 100%);
        border-color: var(--pl-gold);
        color: var(--pl-bg-dark);
        font-weight: 600;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, var(--pl-gold-light) 0%, var(--pl-gold) 100%);
        border-color: var(--pl-gold-light);
        color: var(--pl-bg-dark);
        box-shadow: 0 4px 15px rgba(201, 162, 39, 0.4);
    }

    .btn-outline-secondary {
        border-color: var(--pl-border);
        color: var(--pl-text-muted);
        background: transparent;
    }

    .btn-outline-secondary:hover {
        border-color: var(--pl-gold);
        color: var(--pl-gold);
        background: rgba(201, 162, 39, 0.1);
    }

    .btn-outline-info {
        border-color: var(--pl-gold);
        color: var(--pl-gold);
        background: transparent;
    }

    .btn-outline-info:hover {
        background: var(--pl-gold);
        color: var(--pl-bg-dark);
    }

    .btn-outline-primary {
        border-color: var(--pl-gold);
        color: var(--pl-gold);
    }

    .btn-outline-primary:hover {
        background: var(--pl-gold);
        color: var(--pl-bg-dark);
    }

    .btn-sm.btn-primary {
        padding: 0.4rem 0.75rem;
    }

    .btn-sm.btn-outline-secondary {
        border-color: var(--pl-border);
        color: var(--pl-text-muted);
    }

    .btn-sm.btn-outline-secondary:hover {
        border-color: var(--pl-gold);
        color: var(--pl-gold);
        background: rgba(201, 162, 39, 0.1);
    }

    /* Dropdown */
    .dropdown-menu {
        background: var(--pl-bg-card);
        border: 1px solid var(--pl-border);
        box-shadow: 0 10px 40px rgba(0,0,0,0.4);
    }

    .dropdown-item {
        color: var(--pl-text);
    }

    .dropdown-item:hover {
        background: rgba(201, 162, 39, 0.1);
        color: var(--pl-gold);
    }

    /* Pagination */
    .pagination .page-link {
        background: var(--pl-bg-card);
        border-color: var(--pl-border);
        color: var(--pl-text-muted);
    }

    .pagination .page-link:hover {
        background: rgba(201, 162, 39, 0.1);
        border-color: var(--pl-gold);
        color: var(--pl-gold);
    }

    .pagination .page-item.active .page-link {
        background: var(--pl-gold);
        border-color: var(--pl-gold);
        color: var(--pl-bg-dark);
    }

    /* Statut icons */
    .text-success {
        color: var(--pl-success) !important;
    }

    .text-danger {
        color: var(--pl-danger) !important;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .cards-container {
            grid-template-columns: 1fr;
        }

        .filters-row {
            flex-direction: column;
        }

        .filter-group {
            min-width: 100%;
        }

        .stats-bar {
            grid-template-columns: repeat(2, 1fr);
        }

        .table-responsive {
            font-size: 0.875rem;
        }

        .practitioner-actions {
            flex-direction: column;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="practitioners-container">
    <div class="container-fluid">
        <!-- En-tête -->
        <div class="toolbar">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="h4 mb-1">
                        <i class="fas fa-users text-primary me-2"></i>
                        {% trans "Gestion des Pratiquants" %}
                    </h2>
                    <p class="text-muted mb-0">
                        {% trans "Gérez votre communauté de pratiquants avec des outils professionnels" %}
                    </p>
                </div>
                
                <div class="d-flex gap-2">
                    <a href="{% url 'competitions:club:practitioner_add' %}" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>
                        {% trans "Nouveau Pratiquant" %}
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-download me-1"></i>
                            {% trans "Export" %}
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="javascript:void(0);" onclick="exportData('csv')">
                                    <i class="fas fa-file-csv me-2"></i>
                                    {% trans "CSV" %}
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="javascript:void(0);" onclick="exportData('excel')">
                                    <i class="fas fa-file-excel me-2"></i>
                                    {% trans "Excel" %}
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="javascript:void(0);" onclick="exportData('pdf')">
                                    <i class="fas fa-file-pdf me-2"></i>
                                    {% trans "PDF" %}
                                </a>
                            </li>
                        </ul>
                    </div>
                    
                    <!-- Bouton d'aide pour les couleurs de grades -->
                    <button class="btn btn-outline-info" type="button" data-bs-toggle="modal" data-bs-target="#gradeColorsModal">
                        <i class="fas fa-palette me-1"></i>
                        {% trans "Couleurs Grades" %}
                    </button>
                </div>
            </div>

            <!-- Bascule de vue -->
            <div class="row mt-4 align-items-center">
                <div class="col-md-4">
                    <div class="view-toggle">
                        <button type="button" class="active" data-view="cards" id="cardsBtn">
                            <i class="fas fa-th-large"></i>
                            {% trans "Cartes" %}
                        </button>
                        <button type="button" data-view="table" id="tableBtn">
                            <i class="fas fa-table"></i>
                            {% trans "Tableau" %}
                        </button>
                    </div>
                </div>
            </div>

            <!-- Filtres -->
            <form method="get" class="filters-row" id="filtersForm">
                <div class="filter-group">
                    <label for="search">{% trans "Recherche" %}</label>
                    <input type="text" name="search" id="search" class="filter-input" 
                           placeholder="{% trans 'Nom, prénom, email...' %}" 
                           value="{{ request.GET.search }}">
                </div>
                
                <div class="filter-group">
                    <label for="grade">{% trans "Grade" %}</label>
                    <select name="grade" id="grade" class="filter-input">
                        <option value="">{% trans "Tous les grades" %}</option>
                        <option value="none" {% if request.GET.grade == "none" %}selected{% endif %}>
                            {% trans "Sans grade" %}
                        </option>
                        {% for grade_value, grade_name in grade_choices %}
                            <option value="{{ grade_value }}" 
                                    {% if request.GET.grade == grade_value|stringformat:"s" %}selected{% endif %}>
                                {{ grade_name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="filter-group">
                    <label for="age_group">{% trans "Groupe d'âge" %}</label>
                    <select name="age_group" id="age_group" class="filter-input">
                        <option value="">{% trans "Tous les âges" %}</option>
                        <option value="child" {% if request.GET.age_group == "child" %}selected{% endif %}>
                            {% trans "Enfants (- 12 ans)" %}
                        </option>
                        <option value="teen" {% if request.GET.age_group == "teen" %}selected{% endif %}>
                            {% trans "Adolescents (12-17 ans)" %}
                        </option>
                        <option value="adult" {% if request.GET.age_group == "adult" %}selected{% endif %}>
                            {% trans "Adultes (18+ ans)" %}
                        </option>
                    </select>
                </div>
                
                <div class="filter-group">
                    <label for="status">{% trans "Statut" %}</label>
                    <select name="status" id="status" class="filter-input">
                        <option value="">{% trans "Tous" %}</option>
                        <option value="active" {% if request.GET.status == "active" %}selected{% endif %}>
                            {% trans "Actifs" %}
                        </option>
                        <option value="inactive" {% if request.GET.status == "inactive" %}selected{% endif %}>
                            {% trans "Inactifs" %}
                        </option>
                    </select>
                </div>
                
                <div class="filter-group">
                    <label>&nbsp;</label>
                    <button type="submit" class="filter-input btn btn-primary">
                        <i class="fas fa-search me-1"></i>
                        {% trans "Filtrer" %}
                    </button>
                </div>
            </form>
        </div>

        <!-- Statistiques -->
        {% if stats %}
        <div class="stats-bar">
            <div class="stat-card">
                <span class="stat-number">{{ stats.total_practitioners }}</span>
                <span class="stat-label">{% trans "Total Pratiquants" %}</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">{{ stats.active_practitioners }}</span>
                <span class="stat-label">{% trans "Actifs" %}</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">{{ stats.practitioners_with_accounts }}</span>
                <span class="stat-label">{% trans "Avec Compte" %}</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">{{ stats.completion_rate }}%</span>
                <span class="stat-label">{% trans "Taux d'Inscription" %}</span>
            </div>
        </div>
        {% endif %}

        <!-- Vue Cartes -->
        <div class="cards-container" id="cardsView">
            {% if practitioners %}
                {% for practitioner in practitioners %}
                <div class="practitioner-card">
                    <div class="practitioner-header">
                        <div class="practitioner-avatar">
                            {{ practitioner.first_name|first|default:"?" }}{{ practitioner.last_name|first|default:"?" }}
                        </div>
