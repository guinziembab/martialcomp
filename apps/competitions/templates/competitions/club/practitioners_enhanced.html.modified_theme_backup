                    <li class="page-item">
                        <a class="page-link" href="?{% if request.GET.search %}search={{ request.GET.search }}&{% endif %}{% if request.GET.grade %}grade={{ request.GET.grade }}&{% endif %}{% if request.GET.age_group %}age_group={{ request.GET.age_group }}&{% endif %}{% if request.GET.status %}status={{ request.GET.status }}&{% endif %}page={{ practitioners.next_page_number }}">
                            {% trans "Suivant" %}
