// Recherche dans les catégories
function searchCategories() {
    const searchTerm = document.getElementById('categorySearchInput').value.toLowerCase();
    const typeFilter = document.getElementById('categoryTypeFilter').value;
    const genderFilter = document.getElementById('categoryGenderFilter').value;
    const sortBy = document.getElementById('categorySortSelect').value;
    const minAge = parseInt(document.getElementById('minAgeFilter').value) || 0;
    const maxAge = parseInt(document.getElementById('maxAgeFilter').value) || 999;
    const hasRegistrations = document.getElementById('hasRegistrationsFilter').checked;
    const emptyOnly = document.getElementById('emptyCategoriesFilter').checked;
    
    filteredCategories = categoriesData.filter(category => {
        // Recherche textuelle
        if (searchTerm && !category.name.toLowerCase().includes(searchTerm)) {
            return false;
        }
        
        // Filtre par type
        if (typeFilter && !category.type.includes(typeFilter)) {
            return false;
        }
        
        // Filtre par genre
        if (genderFilter && !category.gender.includes(genderFilter)) {
            return false;
        }
        
        // Filtre par inscriptions
        if (hasRegistrations && category.registrations_count === 0) {
            return false;
        }
        
        if (emptyOnly && category.registrations_count > 0) {
            return false;
        }
        
        return true;
    });
    
    // Trier
    filteredCategories.sort((a, b) => {
        switch (sortBy) {
            case 'name':
                return a.name.localeCompare(b.name);
            case 'type':
                return (a.type || '').localeCompare(b.type || '');
            case 'gender':
                return (a.gender || '').localeCompare(b.gender || '');
            case 'registrations':
                return b.registrations_count - a.registrations_count;
            default:
                return 0;
        }
    });
    
    renderCategories();
    updateCategoriesStats();
}

// Charger les filtres de type
function loadTypeFilters() {
    const typeFilter = document.getElementById('categoryTypeFilter');
    const types = [...new Set(categoriesData.map(cat => cat.type).filter(Boolean))];
    
    typeFilter.innerHTML = '<option value="">Tous les types</option>';
    types.forEach(type => {
        const option = document.createElement('option');
        option.value = type;
        option.textContent = type;
        typeFilter.appendChild(option);
    });
}

// Actualiser les catégories
function refreshCategories() {
    loadCategories();
}

// Mettre à jour les statistiques des catégories
function updateCategoriesStats() {
    const totalCategories = categoriesData.length;
    const categoriesWithRegistrations = categoriesData.filter(cat => cat.registrations_count > 0).length;
    const emptyCategories = totalCategories - categoriesWithRegistrations;
    const totalRegistrations = categoriesData.reduce((sum, cat) => sum + cat.registrations_count, 0);
    const avgRegistrations = totalCategories > 0 ? Math.round(totalRegistrations / totalCategories) : 0;
    
    document.getElementById('totalCategoriesCount').textContent = totalCategories;
    document.getElementById('categoriesWithRegistrationsCount').textContent = categoriesWithRegistrations;
    document.getElementById('emptyCategoriesCount').textContent = emptyCategories;
    document.getElementById('totalRegistrationsCount').textContent = totalRegistrations;
    document.getElementById('avgRegistrationsPerCategory').textContent = avgRegistrations;
    document.getElementById('filteredCategoriesCount').textContent = filteredCategories.length;
}

