// Formulaire de type
function initTypeForm() {
    const form = document.getElementById('typeForm');
    if (!form) return;
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const submitButton = form.querySelector('button[type="submit"]');
        const originalText = submitButton.innerHTML;
        const editId = form.getAttribute('data-edit-id');
        
        submitButton.disabled = true;
        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Enregistrement...';
        
        const url = editId ? `/fr/competitions/club/api/competitions/${competitionId}/types/${editId}/` : urls.addType;
        const method = editId ? 'PUT' : 'POST';
        
        // Pour la modification, envoyer en JSON
        const data = editId ? Object.fromEntries(formData) : formData;
        const headers = {
            'X-CSRFToken': csrfToken,
            'X-Requested-With': 'XMLHttpRequest'
        };
        
        if (editId) {
            headers['Content-Type'] = 'application/json';
        }
        
        fetch(url, {
            method: method,
            body: editId ? JSON.stringify(data) : data,
            headers: headers
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('typeModal')).hide();
