    loadTypes();
}

// Mettre à jour les statistiques des types
function updateTypesStats() {
    const totalTypes = typesData.length;
    const totalCategories = typesData.reduce((sum, type) => sum + type.categories_count, 0);
    const avgCategories = totalTypes > 0 ? Math.round(totalCategories / totalTypes) : 0;
    const emptyTypes = typesData.filter(type => type.categories_count === 0).length;
    
    document.getElementById('totalTypesCount').textContent = totalTypes;
    document.getElementById('totalCategoriesCount').textContent = totalCategories;
    document.getElementById('avgCategoriesPerType').textContent = avgCategories;
    document.getElementById('emptyTypesCount').textContent = emptyTypes;
}

