// Charger les catégories
async function loadCategories() {
    try {
        showCategoriesLoading(true);
        // Simuler le chargement des catégories depuis l'API
        // En attendant, utiliser les données du template
        const categories = [];
        document.querySelectorAll('[data-category-id]').forEach(element => {
            const categoryId = element.getAttribute('data-category-id');
            const name = element.querySelector('h5').textContent.trim();
            const type = element.querySelector('.badge.bg-info')?.textContent.trim() || '';
            const gender = element.querySelector('.fa-venus-mars')?.parentElement.textContent.trim() || '';
            const age = element.querySelector('.fa-birthday-cake')?.parentElement.textContent.trim() || '';
            const registrationsCount = parseInt(element.querySelector('.fa-users')?.parentElement.textContent.match(/\d+/)?.[0] || '0');
            
            categories.push({
                id: categoryId,
                name: name,
                type: type,
                gender: gender,
                age: age,
                registrations_count: registrationsCount
            });
        });
        
        categoriesData = categories;
        filteredCategories = [...categories];
        renderCategories();
        updateCategoriesStats();
        loadTypeFilters();
    } catch (error) {
        console.error('Erreur lors du chargement des catégories:', error);
        showCategoriesError('Erreur de connexion');
    } finally {
        showCategoriesLoading(false);
    }
}

