// Recherche dans les types
function searchTypes() {
    const searchTerm = document.getElementById('typeSearchInput').value.toLowerCase();
    const sortBy = document.getElementById('typeSortSelect').value;
    
    filteredTypes = typesData.filter(type => 
        type.name.toLowerCase().includes(searchTerm) ||
        (type.description && type.description.toLowerCase().includes(searchTerm))
    );
    
    // Trier
    filteredTypes.sort((a, b) => {
        switch (sortBy) {
            case 'name':
                return a.name.localeCompare(b.name);
            case 'categories':
                return b.categories_count - a.categories_count;
            case 'created':
                return new Date(b.created_at || 0) - new Date(a.created_at || 0);
            default:
                return 0;
        }
    });
    
    renderTypes();
    updateTypesStats();
}

// Actualiser les types
