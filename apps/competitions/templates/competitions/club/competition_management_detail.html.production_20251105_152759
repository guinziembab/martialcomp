{% block extra_js %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/dragula/3.7.3/dragula.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
// Configuration
const competitionId = {{ competition.id }};
const currentLanguage = '{{ LANGUAGE_CODE|default:"fr" }}';
const csrfToken = '{{ csrf_token }}';

// URLs API
const urls = {
    addCategory: "{% url 'competitions:competitions:add_category_detailed' competition.id %}",
    deleteCategory: "{% url 'competitions:competitions:delete_category_detailed' competition.id %}",
    getGrades: `/${currentLanguage}/competitions/competitions/${competitionId}/api/grades/`,
    addType: `{% url 'competitions:club:api_add_competition_type' competition.id %}`,
    editType: `{% url 'competitions:club:api_add_competition_type' competition.id %}`,
    deleteType: `{% url 'competitions:club:api_add_competition_type' competition.id %}`,
    assignToCategory: `/api/competitions/${competitionId}/assign-category/`,
    removeFromCategory: `/api/competitions/${competitionId}/remove-category/`,
    assignJudge: `/api/competitions/${competitionId}/assign-judge/`,
    publishCompetition: `/api/competitions/${competitionId}/publish/`,
    shareCompetition: `/api/competitions/${competitionId}/share/`
};

// Variables globales
let gradesLoaded = false;
let gradesData = [];
let dragulaPractitioners = null;
let dragulaJudges = null;
let dragulaCategories = null;

// Initialisation
document.addEventListener('DOMContentLoaded', function() {
    console.log('Initializing Competition Management Pro...');
    console.log('Competition ID:', competitionId);
    console.log('URLs:', urls);
    console.log('Add Type URL:', urls.addType);
    console.log('Edit Type URL:', urls.editType);
    console.log('Delete Type URL:', urls.deleteType);
    
    // Test des URLs
    console.log('Test URL for type 79:', `/fr/competitions/club/api/competitions/${competitionId}/types/79/`);
    
    // Test de l'API
    fetch(`/fr/competitions/club/api/competitions/${competitionId}/types/`)
        .then(response => {
            console.log('API test response status:', response.status);
            return response.text();
        })
        .then(text => {
            console.log('API test response text:', text);
        })
        .catch(error => {
            console.error('API test error:', error);
        });
    
    // Initialiser les formulaires
    initCategoryForm();
    initTypeForm();
    initJudgeForm();
    
    // Réinitialiser le modal de type après fermeture
    document.getElementById('typeModal').addEventListener('hidden.bs.modal', function() {
        const form = document.getElementById('typeForm');
        form.reset();
        form.removeAttribute('data-edit-id');
        document.querySelector('#typeModal .modal-title').textContent = 'Ajouter un type de compétition';
    });
    
    // Charger les grades
    loadGrades();
    
    // Initialiser le drag and drop
    initDragAndDrop();
    
    // Initialiser les filtres
    initFilters();
    
    // Démarrer l'horloge temps réel
    startRealtimeClock();
    
    // Charger les juges disponibles
    loadAvailableJudges();
    
    // Initialiser l'onglet Résultats si Chart.js est disponible
    if (window.Chart) {
        initScoringChart();
    }
    
    // Charger les statistiques de notation
    loadScoringStats();
    
    // Gérer le changement d'onglets pour le live update
    document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(button => {
        button.addEventListener('shown.bs.tab', function (e) {
            if (e.target.getAttribute('data-bs-target') === '#results') {
                // Rafraîchir les statistiques quand on arrive sur l'onglet
                loadScoringStats();
            } else {
                // Arrêter le rafraîchissement automatique si on quitte l'onglet
                if (window.liveResultsInterval) {
                    clearInterval(window.liveResultsInterval);
                    window.liveResultsInterval = null;
                }
            }
        });
    });
});

// Initialiser le drag and drop
function initDragAndDrop() {
    // Drag and drop pour les pratiquants
    const practitionerContainers = [
        document.getElementById('unassignedPractitioners'),
        ...document.querySelectorAll('.category-drop')
    ].filter(el => el !== null);
    
    if (practitionerContainers.length > 0) {
        dragulaPractitioners = dragula(practitionerContainers, {
            copy: false,
            revertOnSpill: true,
            accepts: function(el, target, source, sibling) {
                // Ne pas accepter si déjà dans une catégorie du même type
                if (target.classList.contains('category-drop')) {
                    const categoryId = target.dataset.categoryId;
                    const registrationId = el.dataset.registrationId;
                    return canAssignToCategory(registrationId, categoryId);
                }
                return true;
            }
        });
        
        dragulaPractitioners.on('drop', function(el, target, source, sibling) {
            if (target.classList.contains('category-drop')) {
                const categoryId = target.dataset.categoryId;
                const registrationId = el.dataset.registrationId;
                assignToCategory(registrationId, categoryId);
            }
        });
    }
    
    // Drag and drop pour les juges
    const judgeContainers = [
        document.getElementById('availableJudges'),
        ...document.querySelectorAll('.judge-drop')
    ].filter(el => el !== null);
    
    if (judgeContainers.length > 0) {
        dragulaJudges = dragula(judgeContainers, {
            copy: false,
            revertOnSpill: true,
            accepts: function(el, target, source, sibling) {
                // Vérifier les contraintes pour les juges
                if (target.classList.contains('judge-drop')) {
                    const role = target.dataset.role;
                    if (role === 'central' && target.children.length >= 1) {
                        return false; // Un seul arbitre central
                    }
                    if (role === 'corner' && target.children.length >= 4) {
                        return false; // Maximum 4 juges de coin
                    }
                }
                return true;
            }
        });
        
        dragulaJudges.on('drop', function(el, target, source, sibling) {
            if (target.classList.contains('judge-drop')) {
                const zone = target.dataset.zone;
                const role = target.dataset.role;
                const judgeId = el.dataset.judgeId;
                assignJudge(judgeId, zone, role);
            }
        });
    }
}

// Vérifier si on peut assigner à une catégorie
function canAssignToCategory(registrationId, categoryId) {
