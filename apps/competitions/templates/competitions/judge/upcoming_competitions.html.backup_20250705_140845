{% extends "base.html" %}
{% load static %}
{% load i18n %}

{% block title %}{% trans "Compétitions à venir" %} - Martial Hub{% endblock %}

{% block extra_css %}
<style>
    .competition-card {
        transition: all 0.3s ease;
        overflow: hidden;
        height: 100%;
        border-radius: 10px;
        border: none;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }
    
    .competition-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }
    
    .competition-image {
        height: 200px;
        object-fit: cover;
    }
    
    .competition-details {
        padding: 20px;
    }
    
    .competition-meta {
        margin-bottom: 15px;
    }
    
    .competition-meta-item {
        display: inline-flex;
        align-items: center;
        margin-right: 15px;
        color: #6c757d;
        font-size: 0.9rem;
    }
    
    .competition-meta-item i {
        margin-right: 5px;
    }
    
    .badge-discipline {
        background-color: #e9ecef;
        color: #495057;
        font-weight: 500;
        padding: 6px 10px;
        border-radius: 15px;
        font-size: 0.8rem;
        margin-right: 5px;
        margin-bottom: 5px;
    }
    
    .status-open {
        color: #198754;
    }
    
    .status-closed {
        color: #dc3545;
    }
    
    .filter-card {
        border-radius: 10px;
        overflow: hidden;
        border: none;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }
    
    .filter-header {
        background-color: #f8f9fa;
        padding: 15px 20px;
        border-bottom: 1px solid #dee2e6;
    }
    
    .filter-body {
        padding: 20px;
    }
    
    .no-results-container {
        text-align: center;
        padding: 40px 20px;
    }
    
    .no-results-illustration {
        max-width: 250px;
        margin-bottom: 30px;
    }
    
    /* Customisation pour les champs de formulaire dans les filtres */
    .filter-form .form-control, .filter-form .form-select {
        border-radius: 20px;
        padding: 8px 15px;
    }
    
    .filter-form .form-label {
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 5px;
    }
    
    /* Badge pour les qualifications requises */
    .required-qualification {
        display: inline-block;
        padding: 4px 8px;
        margin: 0 5px 5px 0;
        border-radius: 15px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    /* Style pour les disciplines */
    .discipline-tag {
        display: inline-block;
        margin-right: 5px;
        margin-bottom: 5px;
        border-radius: 15px;
        padding: 5px 10px;
        font-size: 0.8rem;
        background-color: #e9ecef;
    }
    
    /* Animation pour le chargement des cartes */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .animated-card {
        animation: fadeInUp 0.5s ease forwards;
    }
</style>
{% endblock %}

{% block content %}
<div class="container py-4">
    <!-- Titre et description -->
    <div class="text-center mb-5">
        <h1 class="display-5 mb-3">{% trans "Compétitions à venir" %}</h1>
        <p class="lead text-muted">
            {% trans "Découvrez les prochaines compétitions et inscrivez-vous en tant que juge." %}
        </p>
    </div>
    
    <!-- Messages de succès/erreur -->
    {% if messages %}
        {% for message in messages %}
            <div class="alert alert-{{ message.tags }} alert-dismissible fade show mb-4" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endif %}
    
    <div class="row g-4">
        <!-- Colonne de filtres -->
        <div class="col-lg-3">
            <div class="filter-card mb-4 sticky-top" style="top: 20px; z-index: 100;">
                <div class="filter-header">
                    <h5 class="mb-0">
                        <i class="fas fa-filter me-2"></i>{% trans "Filtres" %}
                    </h5>
                </div>
                <div class="filter-body">
                    <form method="get" class="filter-form">
                        <div class="mb-3">
                            <label for="discipline" class="form-label">{% trans "Discipline" %}</label>
                            <select name="discipline" id="discipline" class="form-select">
                                <option value="">{% trans "Toutes les disciplines" %}</option>
                                {% for discipline in disciplines %}
                                    <option value="{{ discipline.id }}" {% if selected_discipline == discipline.id|stringformat:"i" %}selected{% endif %}>
                                        {{ discipline.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label for="location" class="form-label">{% trans "Lieu" %}</label>
                            <input type="text" name="location" id="location" class="form-control" value="{{ search_location }}" placeholder="{% trans 'Ville, pays...' %}">
                        </div>
                        
                        <div class="mb-3">
                            <label for="date_from" class="form-label">{% trans "Date de début" %}</label>
                            <input type="date" name="date_from" id="date_from" class="form-control" value="{{ date_from|date:'Y-m-d' }}">
                        </div>
                        
                        <div class="mb-3">
                            <label for="date_to" class="form-label">{% trans "Date de fin" %}</label>
                            <input type="date" name="date_to" id="date_to" class="form-control" value="{{ date_to|date:'Y-m-d' }}">
                        </div>
                        
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="only_eligible" id="only_eligible" {% if only_eligible %}checked{% endif %}>
                            <label class="form-check-label" for="only_eligible">
                                {% trans "Seulement les compétitions éligibles" %}
                            </label>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>{% trans "Filtrer" %}
                        </button>
                    </form>
                    
                    {% if is_filtered %}
                        <a href="{% url 'competitions:judge:upcoming_competitions' %}" class="btn btn-outline-secondary w-100 mt-2">
                            <i class="fas fa-times me-2"></i>{% trans "Réinitialiser les filtres" %}
                        </a>
                    {% endif %}
                </div>
            </div>
            
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">{% trans "Mes qualifications" %}</h5>
                </div>
                <div class="card-body">
                    {% if judge.qualifications.exists %}
                        <div class="mb-3">
                            <span class="fw-bold d-block mb-2">{% trans "Niveau:" %}</span>
                            <span class="badge {% if judge.qualification_level == 'international' %}bg-danger{% elif judge.qualification_level == 'national' %}bg-success{% elif judge.qualification_level == 'regional' %}bg-primary{% else %}bg-secondary{% endif %} px-3 py-2">
                                {{ judge.get_qualification_level_display }}
                            </span>
                        </div>
                        
                        <span class="fw-bold d-block mb-2">{% trans "Types de qualifications:" %}</span>
                        <div class="d-flex flex-wrap mb-3">
                            {% for qualification in judge.qualifications.all %}
                                <span class="badge bg-info me-1 mb-1">
                                    {{ qualification.get_qualification_type_display }}
                                </span>
                            {% endfor %}
                        </div>
                        
                        <span class="fw-bold d-block mb-2">{% trans "Disciplines:" %}</span>
                        <div class="d-flex flex-wrap">
                            {% for qualification in judge.qualifications.all %}
                                <span class="discipline-tag">{{ qualification.discipline.name }}</span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-warning mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            {% trans "Vous n'avez pas encore ajouté de qualifications. Pour pouvoir juger des compétitions, veuillez ajouter vos qualifications." %}
                        </div>
                        <a href="{% url 'competitions:judge:add_qualification' %}" class="btn btn-outline-primary btn-sm mt-3">
                            <i class="fas fa-plus-circle me-1"></i>{% trans "Ajouter une qualification" %}
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <!-- Colonne des compétitions -->
        <div class="col-lg-9">
            <!-- Barre de tri et nombre de résultats -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="mb-0">
                    {{ competitions|length }} {% trans "compétition(s) trouvée(s)" %}
                </p>
                <div class="d-flex align-items-center">
                    <label for="sort_by" class="me-2 mb-0">{% trans "Trier par:" %}</label>
                    <select id="sort_by" class="form-select form-select-sm" style="width: auto;">
                        <option value="date_asc">{% trans "Date (croissante)" %}</option>
                        <option value="date_desc">{% trans "Date (décroissante)" %}</option>
                        <option value="name_asc">{% trans "Nom (A-Z)" %}</option>
                        <option value="name_desc">{% trans "Nom (Z-A)" %}</option>
                    </select>
                </div>
            </div>
            
            {% if competitions %}
                <div class="row g-4" id="competitions-container">
                    {% for competition in competitions %}
                        <div class="col-md-6 col-lg-6 mb-4 competition-item animated-card" style="animation-delay: {{ forloop.counter0|divisibleby:2 }}00ms;">
                            <div class="competition-card">
                                <div class="position-relative">
                                    <!-- Image de la compétition -->
                                    {% if competition.image %}
                                        <img src="{{ competition.image.url }}" alt="{{ competition.title }}" class="competition-image w-100">
                                    {% else %}
                                        <img src="{% static 'img/competition-placeholder.jpg' %}" alt="{{ competition.title }}" class="competition-image w-100">
                                    {% endif %}
                                    
                                    <!-- Badge de statut -->
                                    <div class="position-absolute top-0 end-0 m-3">
                                        {% if competition.registration_open %}
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="fas fa-door-open me-1"></i>{% trans "Inscriptions ouvertes" %}
                                            </span>
                                        {% else %}
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="fas fa-door-closed me-1"></i>{% trans "Inscriptions fermées" %}
                                            </span>
                                        {% endif %}
                                    </div>
                                    
                                    <!-- Indicateur d'éligibilité -->
                                    {% if competition.is_eligible %}
                                        <div class="position-absolute top-0 start-0 m-3">
                                            <span class="badge bg-primary px-3 py-2">
                                                <i class="fas fa-check-circle me-1"></i>{% trans "Éligible" %}
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>
                                
                                <div class="competition-details">
                                    <h3 class="card-title h5">{{ competition.title }}</h3>
                                    
                                    <div class="competition-meta my-3">
                                        <div class="competition-meta-item">
                                            <i class="fas fa-calendar-alt"></i>
                                            <span>{{ competition.start_date|date:"d/m/Y" }}</span>
                                        </div>
                                        <div class="competition-meta-item">
                                            <i class="fas fa-map-marker-alt"></i>
                                            <span>{{ competition.location }}</span>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        {% for discipline in competition.disciplines.all %}
                                            <span class="badge-discipline">{{ discipline.name }}</span>
                                        {% endfor %}
                                    </div>
                                    
                                    {% if competition.judge_needed %}
                                        <div class="mb-3">
                                            <span class="text-danger">
                                                <i class="fas fa-user-plus me-1"></i>{% trans "Juges recherchés!" %}
                                            </span>
                                        </div>
                                    {% endif %}
                                    
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-2">{% trans "Qualifications requises:" %}</h6>
                                        <div>
                                            {% for qualification in competition.required_qualifications %}
                                                <span class="required-qualification bg-light border">
                                                    {{ qualification.type }} - {{ qualification.level }}
                                                </span>
                                            {% endfor %}
                                            {% if not competition.required_qualifications %}
                                                <span class="text-muted">{% trans "Aucune qualification spécifique requise" %}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between align-items-center">
                                        <a href="{% url 'competitions:judge:competition_detail' competition.id %}" class="btn btn-outline-primary">
                                            <i class="fas fa-info-circle me-1"></i>{% trans "Détails" %}
                                        </a>
                                        
                                        {% if competition.registration_open and competition.is_eligible %}
                                            <a href="{% url 'competitions:judge:register_for_competition' %}?competition={{ competition.id }}" class="btn btn-primary">
                                                <i class="fas fa-sign-in-alt me-1"></i>{% trans "S'inscrire" %}
                                            </a>
                                        {% elif competition.registration_open and not competition.is_eligible %}
                                            <button class="btn btn-secondary" disabled title="{% trans 'Vous n\'avez pas les qualifications requises' %}">
                                                <i class="fas fa-ban me-1"></i>{% trans "Non éligible" %}
                                            </button>
                                        {% else %}
                                            <button class="btn btn-secondary" disabled>
                                                <i class="fas fa-lock me-1"></i>{% trans "Inscriptions fermées" %}
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                
                <!-- Pagination -->
                {% if is_paginated %}
                    <nav aria-label="{% trans 'Navigation de pagination' %}" class="mt-4">
                        <ul class="pagination justify-content-center">
                            {% if page_obj.has_previous %}
                                <li class="page-item">
                                    <a class="page-link" href="?page=1{% if request.GET.discipline %}&discipline={{ request.GET.discipline }}{% endif %}{% if request.GET.location %}&location={{ request.GET.location }}{% endif %}{% if request.GET.date_from %}&date_from={{ request.GET.date_from }}{% endif %}{% if request.GET.date_to %}&date_to={{ request.GET.date_to }}{% endif %}{% if request.GET.only_eligible %}&only_eligible=on{% endif %}" aria-label="{% trans 'Première' %}">
                                        <span aria-hidden="true">&laquo;&laquo;</span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="?page={{ page_obj.previous_page_number }}{% if request.GET.discipline %}&discipline={{ request.GET.discipline }}{% endif %}{% if request.GET.location %}&location={{ request.GET.location }}{% endif %}{% if request.GET.date_from %}&date_from={{ request.GET.date_from }}{% endif %}{% if request.GET.date_to %}&date_to={{ request.GET.date_to }}{% endif %}{% if request.GET.only_eligible %}&only_eligible=on{% endif %}" aria-label="{% trans 'Précédente' %}">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                            {% endif %}
                            
                            {% for i in paginator.page_range %}
                                {% if page_obj.number == i %}
                                    <li class="page-item active">
                                        <span class="page-link">{{ i }}</span>
                                    </li>
                                {% elif i > page_obj.number|add:'-3' and i < page_obj.number|add:'3' %}
                                    <li class="page-item">
                                        <a class="page-link" href="?page={{ i }}{% if request.GET.discipline %}&discipline={{ request.GET.discipline }}{% endif %}{% if request.GET.location %}&location={{ request.GET.location }}{% endif %}{% if request.GET.date_from %}&date_from={{ request.GET.date_from }}{% endif %}{% if request.GET.date_to %}&date_to={{ request.GET.date_to }}{% endif %}{% if request.GET.only_eligible %}&only_eligible=on{% endif %}">{{ i }}</a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                            
                            {% if page_obj.has_next %}
                                <li class="page-item">
                                    <a class="page-link" href="?page={{ page_obj.next_page_number }}{% if request.GET.discipline %}&discipline={{ request.GET.discipline }}{% endif %}{% if request.GET.location %}&location={{ request.GET.location }}{% endif %}{% if request.GET.date_from %}&date_from={{ request.GET.date_from }}{% endif %}{% if request.GET.date_to %}&date_to={{ request.GET.date_to }}{% endif %}{% if request.GET.only_eligible %}&only_eligible=on{% endif %}" aria-label="{% trans 'Suivante' %}">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="?page={{ paginator.num_pages }}{% if request.GET.discipline %}&discipline={{ request.GET.discipline }}{% endif %}{% if request.GET.location %}&location={{ request.GET.location }}{% endif %}{% if request.GET.date_from %}&date_from={{ request.GET.date_from }}{% endif %}{% if request.GET.date_to %}&date_to={{ request.GET.date_to }}{% endif %}{% if request.GET.only_eligible %}&only_eligible=on{% endif %}" aria-label="{% trans 'Dernière' %}">
                                        <span aria-hidden="true">&raquo;&raquo;</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </nav>
                {% endif %}
            {% else %}
                <div class="no-results-container">
                    <img src="{% static 'img/illustrations/no-results.svg' %}" alt="{% trans 'Aucun résultat' %}" class="no-results-illustration">
                    <h3>{% trans "Aucune compétition trouvée" %}</h3>
                    <p class="text-muted mb-4">{% trans "Aucune compétition ne correspond à vos critères de recherche." %}</p>
                    <a href="{% url 'competitions:judge:upcoming_competitions' %}" class="btn btn-primary">
                        <i class="fas fa-sync-alt me-2"></i>{% trans "Réinitialiser les filtres" %}
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    // JavaScript pour le tri des compétitions
    document.addEventListener('DOMContentLoaded', function() {
        const sortSelect = document.getElementById('sort_by');
        const competitionsContainer = document.getElementById('competitions-container');
        
        if (sortSelect && competitionsContainer) {
            sortSelect.addEventListener('change', function() {
                const competitionItems = Array.from(document.querySelectorAll('.competition-item'));
                const sortValue = this.value;
                
                competitionItems.sort(function(a, b) {
                    let valueA, valueB;
                    
                    if (sortValue === 'date_asc' || sortValue === 'date_desc') {
                        // Extraire la date
                        const dateA = a.querySelector('.competition-meta-item:first-child span').textContent;
                        const dateB = b.querySelector('.competition-meta-item:first-child span').textContent;
                        
                        // Convertir en objet Date
                        const [dayA, monthA, yearA] = dateA.split('/');
                        const [dayB, monthB, yearB] = dateB.split('/');
                        
                        valueA = new Date(yearA, monthA - 1, dayA);
                        valueB = new Date(yearB, monthB - 1, dayB);
                    } else {
                        // Tri par nom
                        valueA = a.querySelector('.card-title').textContent.toLowerCase();
                        valueB = b.querySelector('.card-title').textContent.toLowerCase();
                    }
                    
                    // Déterminer l'ordre
                    if (sortValue === 'date_asc') {
                        return valueA - valueB;
                    } else if (sortValue === 'date_desc') {
                        return valueB - valueA;
                    } else if (sortValue === 'name_asc') {
                        return valueA.localeCompare(valueB);
                    } else if (sortValue === 'name_desc') {
                        return valueB.localeCompare(valueA);
                    }
                });
                
                // Réorganiser les éléments dans le DOM
                competitionItems.forEach(function(item) {
                    competitionsContainer.appendChild(item);
                });
            });
        }
    });
</script>
{% endblock %}