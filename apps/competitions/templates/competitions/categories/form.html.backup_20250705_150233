{% extends "base.html" %}
{% load i18n %}

{% block title %}
    {% if category %}Modifier la catégorie{% else %}Ajouter une catégorie{% endif %}
{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        {% if category %}
                            Modifier la catégorie "{{ category.name }}"
                        {% else %}
                            Ajouter une catégorie pour {{ competition_type.name }}
                        {% endif %}
                    </h2>
                </div>
                <div class="card-body">
                    <form method="post">
                        {% csrf_token %}
                        
                        {% if form.non_field_errors %}
                        <div class="alert alert-danger">
                            {% for error in form.non_field_errors %}
                                {{ error }}
                            {% endfor %}
                        </div>
                        {% endif %}
                        
                        <div class="mb-3">
                            <label for="{{ form.name.id_for_label }}" class="form-label">{{ form.name.label }}</label>
                            {{ form.name }}
                            {% if form.name.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.name.errors }}
                                </div>
                            {% endif %}
                            {% if form.name.help_text %}
                                <div class="form-text">{{ form.name.help_text }}</div>
                            {% endif %}
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <h5 class="mb-3">{% trans "Catégorie d'âge" %}</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="{{ form.min_age.id_for_label }}" class="form-label">{{ form.min_age.label }}</label>
                                            {{ form.min_age }}
                                            {% if form.min_age.errors %}
                                                <div class="invalid-feedback d-block">
                                                    {{ form.min_age.errors }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="{{ form.max_age.id_for_label }}" class="form-label">{{ form.max_age.label }}</label>
                                            {{ form.max_age }}
                                            {% if form.max_age.errors %}
                                                <div class="invalid-feedback d-block">
                                                    {{ form.max_age.errors }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <h5 class="mb-3">{% trans "Catégorie de grade" %}</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="{{ form.min_grade.id_for_label }}" class="form-label">{{ form.min_grade.label }}</label>
                                            {{ form.min_grade }}
                                            {% if form.min_grade.errors %}
                                                <div class="invalid-feedback d-block">
                                                    {{ form.min_grade.errors }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="{{ form.max_grade.id_for_label }}" class="form-label">{{ form.max_grade.label }}</label>
                                            {{ form.max_grade }}
                                            {% if form.max_grade.errors %}
                                                <div class="invalid-feedback d-block">
                                                    {{ form.max_grade.errors }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h5 class="mb-3">{% trans "Catégorie de poids" %}</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="{{ form.min_weight.id_for_label }}" class="form-label">{{ form.min_weight.label }}</label>
                                            {{ form.min_weight }}
                                            {% if form.min_weight.errors %}
                                                <div class="invalid-feedback d-block">
                                                    {{ form.min_weight.errors }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="{{ form.max_weight.id_for_label }}" class="form-label">{{ form.max_weight.label }}</label>
                                            {{ form.max_weight }}
                                            {% if form.max_weight.errors %}
                                                <div class="invalid-feedback d-block">
                                                    {{ form.max_weight.errors }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <h5 class="mb-3">{% trans "Genre" %}</h5>
                                <div class="mb-3">
                                    <label for="{{ form.gender.id_for_label }}" class="form-label">{{ form.gender.label }}</label>
                                    {{ form.gender }}
                                    {% if form.gender.errors %}
                                        <div class="invalid-feedback d-block">
                                            {{ form.gender.errors }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="{% url 'competitions:categories' competition.id %}" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i>{% trans "Annuler" %}</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> 
                                {% if category %}Mettre à jour{% else %}Créer la catégorie{% endif %}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}