        // Fonction pour générer un slug depuis le nom
        function generateSlug(text) {
            return text
                .toLowerCase()
                .trim()
                .replace(/[\u00e0\u00e1\u00e2\u00e3\u00e4\u00e5]/g, 'a')
                .replace(/[\u00e8\u00e9\u00ea\u00eb]/g, 'e')
                .replace(/[\u00ec\u00ed\u00ee\u00ef]/g, 'i')
                .replace(/[\u00f2\u00f3\u00f4\u00f5\u00f6]/g, 'o')
                .replace(/[\u00f9\u00fa\u00fb\u00fc]/g, 'u')
                .replace(/[\u00e7]/g, 'c')
                .replace(/[\u00f1]/g, 'n')
                .replace(/[^a-z0-9\s-]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-')
                .replace(/^-|-$/g, '');
        }
        
        // Fonction pour mettre à jour l'aperçu du sous-domaine
        function updateSubdomainPreview() {
            if (nameInput && generatedSubdomainSpan) {
                let subdomain;
                
                // Si un sous-domaine personnalisé est saisi
                if (customSubdomainCheckbox.checked && customSubdomainField.value.trim()) {
                    subdomain = customSubdomainField.value.trim().toLowerCase();
                } else if (nameInput.value.trim()) {
                    // Générer automatiquement depuis le nom
                    subdomain = 'fed-' + generateSlug(nameInput.value.trim());
                } else {
                    subdomain = 'votre-federation';
                }
                
                // Valeur par défaut si vide
                if (!subdomain || subdomain === 'fed-') {
                    subdomain = 'votre-federation';
                }
                
                generatedSubdomainSpan.textContent = subdomain;
                
                // Activer l'animation si le nom est renseigné
                if (nameInput.value.trim()) {
                    subdomainPreview.classList.add('active');
                } else {
                    subdomainPreview.classList.remove('active');
                }
            }
        }
        
        // Événements pour la génération de sous-domaine
        if (nameInput) {
            nameInput.addEventListener('input', updateSubdomainPreview);
        }
        
        if (customSubdomainCheckbox) {
            customSubdomainCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    customSubdomainInput.style.display = 'block';
                    customSubdomainField.focus();
                } else {
                    customSubdomainInput.style.display = 'none';
                    customSubdomainField.value = '';
                }
                updateSubdomainPreview();
            });
        }
        
        if (customSubdomainField) {
            customSubdomainField.addEventListener('input', updateSubdomainPreview);
        }
        
        // Initialiser l'aperçu
        updateSubdomainPreview();
    });
</script>
{% endblock %}