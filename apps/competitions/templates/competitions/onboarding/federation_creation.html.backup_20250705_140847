                        <span class="country-name">${country.name}</span>
                    </div>`
                ).join('');
                
                // Ajouter les événements de clic
                countryDropdown.querySelectorAll('.country-option').forEach((option, index) => {
                    option.addEventListener('click', () => selectCountry(index));
                });
            }
            
            countryDropdown.classList.add('show');
            highlightedIndex = -1;
        }
        
        // Fonction pour sélectionner un pays
        function selectCountry(index) {
            if (index >= 0 && index < filteredCountries.length) {
                const selectedCountry = filteredCountries[index];
                countrySearchInput.value = `${selectedCountry.flag} ${selectedCountry.name}`;
                selectedCountryInput.value = selectedCountry.name;
                countryDropdown.classList.remove('show');
                highlightedIndex = -1;
            }
        }
        
        // Fonction pour mettre en surbrillance une option
        function highlightOption(index) {
            const options = countryDropdown.querySelectorAll('.country-option');
            
            // Retirer la surbrillance précédente
            options.forEach(option => option.classList.remove('highlighted'));
            
            // Ajouter la nouvelle surbrillance
            if (index >= 0 && index < options.length) {
                options[index].classList.add('highlighted');
                options[index].scrollIntoView({block: 'nearest'});
            }
        }
        
