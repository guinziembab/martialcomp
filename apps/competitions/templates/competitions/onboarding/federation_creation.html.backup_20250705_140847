{% extends "base.html" %}
{% load i18n %}
{% load static %}
{% load competition_tags %} 

{% block title %}{% trans "Création de fédération" %} | Martial Hub{% endblock %}

{% block extra_css %}
<style>
    :root {
        --primary: #dc3545;
        --secondary: #212529;
        --accent: #ffc107;
        --light-gray: #f8f9fa;
        --medium-gray: #e9ecef;
        --dark-gray: #6c757d;
    }
    
    .onboarding-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
    }
    
    .onboarding-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }
    
    .onboarding-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    
    .onboarding-subtitle {
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
        color: var(--dark-gray);
    }
    
    .progress-container {
        margin-bottom: 2rem;
    }
    
    .progress-wrapper {
        background-color: var(--medium-gray);
        height: 8px;
        border-radius: 4px;
        margin: 0.5rem 0 1rem;
        overflow: hidden;
    }
    
    .progress-bar {
        height: 100%;
        background-color: var(--primary);
        border-radius: 4px;
        transition: width 0.5s ease-in-out;
    }
    
    .progress-steps {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }
    
    .step {
        font-size: 0.9rem;
        color: var(--dark-gray);
        position: relative;
    }
    
    .step.active {
        color: var(--primary);
        font-weight: 600;
    }
    
    .step.completed {
        color: #28a745;
    }
    
    .onboarding-card {
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        padding: 2rem;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
        animation: fadeIn 0.5s ease-out forwards;
    }
    
    .form-section {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--medium-gray);
    }
    
    .form-section:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }
    
    .section-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        color: var(--primary);
    }
    
    .section-title i {
        margin-right: 0.5rem;
    }
    
    .form-group {
        margin-bottom: 1.5rem;
    }
    
    .form-label {
        font-weight: 500;
        margin-bottom: 0.5rem;
        display: block;
    }
    
    .required::after {
        content: " *";
        color: var(--primary);
    }
    
    .form-control {
        display: block;
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        transition: all 0.2s ease;
    }
    
    .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
        outline: none;
    }
    
    .preview-container {
        text-align: center;
        margin-bottom: 1rem;
    }
    
    .logo-preview {
        max-width: 150px;
        max-height: 150px;
        border-radius: 0.25rem;
        background-color: white;
        padding: 0.5rem;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        display: none;
    }
    
    .custom-file-input:lang(fr) ~ .custom-file-label::after {
        content: "Parcourir";
    }
    
    .actions-container {
        display: flex;
        justify-content: space-between;
        margin-top: 2rem;
    }
    
    .disciplines-container {
        background-color: var(--light-gray);
        padding: 1.5rem;
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
        max-height: 300px;
        overflow-y: auto;
    }
    
    .discipline-item {
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        padding: 0.5rem;
        transition: background-color 0.2s;
        border-radius: 0.25rem;
    }
    
    .discipline-item:hover {
        background-color: rgba(220, 53, 69, 0.1);
    }
    
    .discipline-item input[type="checkbox"] {
        margin-right: 0.75rem;
    }
    
    .discipline-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--primary);
        color: white;
        border-radius: 50%;
        margin-right: 0.75rem;
        font-size: 1.2rem;
    }
    
    .discipline-details {
        flex: 1;
    }
    
    .discipline-name {
        font-weight: 500;
        margin-bottom: 0.2rem;
    }
    
    .discipline-origin {
        font-size: 0.8rem;
        color: var(--dark-gray);
    }
    
    .add-discipline-btn {
        margin-top: 1rem;
        display: inline-flex;
        align-items: center;
        background-color: #f8f9fa;
        border: 1px dashed #ced4da;
        padding: 0.75rem 1rem;
        border-radius: 0.25rem;
        color: var(--dark-gray);
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .add-discipline-btn:hover {
        background-color: #e9ecef;
        color: var(--primary);
    }
    
    .add-discipline-btn i {
        margin-right: 0.5rem;
    }
    
    #newDisciplineForm {
        display: none;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 0.5rem;
        margin-top: 1rem;
        border: 1px solid #ced4da;
    }
    
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Country Search Dropdown */
    .country-select-container {
        position: relative;
    }
    
    .country-search-input {
        background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="%236c757d" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>');
        background-repeat: no-repeat;
        background-position: 12px center;
        padding-left: 40px;
    }
    
    .country-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #ced4da;
        border-top: none;
        border-radius: 0 0 0.375rem 0.375rem;
        max-height: 200px;
        overflow-y: auto;
        z-index: 1000;
        display: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .country-dropdown.show {
        display: block;
    }
    
    .country-option {
        padding: 10px 12px;
        cursor: pointer;
        border-bottom: 1px solid #f1f1f1;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: background-color 0.2s;
    }
    
    .country-option:hover,
    .country-option.highlighted {
        background-color: #f8f9fa;
    }
    
    .country-option.selected {
        background-color: var(--primary);
        color: white;
    }
    
    .country-flag {
        font-size: 1.2em;
        width: 20px;
        text-align: center;
    }
    
    .country-name {
        flex: 1;
    }
    
    .no-results {
        padding: 12px;
        text-align: center;
        color: #6c757d;
        font-style: italic;
    }
    
    /* Subdomain Preview */
    .subdomain-preview {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border: 1px solid var(--primary);
        border-radius: 0.5rem;
        padding: 1.5rem;
        margin-top: 1rem;
        text-align: center;
        transition: all 0.3s ease;
    }
    
    .subdomain-preview.active {
        background: linear-gradient(135deg, rgba(220, 53, 69, 0.1) 0%, rgba(220, 53, 69, 0.05) 100%);
        border-color: var(--primary);
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.1);
    }
    
    .subdomain-url {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--primary);
        margin-bottom: 0.5rem;
        word-break: break-all;
    }
    
    .subdomain-description {
        font-size: 0.9rem;
        color: var(--dark-gray);
        margin-bottom: 1rem;
    }
    
    .subdomain-features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.5rem;
        margin-top: 1rem;
    }
    
    .subdomain-feature {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: var(--dark-gray);
    }
    
    .subdomain-feature i {
        color: #28a745;
    }
    
    @media (max-width: 768px) {
        .onboarding-container {
            padding: 1rem;
        }
        
        .onboarding-card {
            padding: 1.5rem;
        }
        
        .actions-container {
            flex-direction: column-reverse;
            gap: 1rem;
        }
        
        .actions-container .btn {
            width: 100%;
        }
        
        .subdomain-features {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="onboarding-container">
    {% if messages %}
        {% for message in messages %}
            <div class="alert alert-{{ message.tags }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endif %}

    <div class="onboarding-header">
        <h1 class="onboarding-title">{% trans "Création de votre fédération" %}</h1>
        <p class="onboarding-subtitle">
            {% trans "En tant qu'administrateur de fédération, vous pourrez gérer les clubs affiliés, organiser des compétitions et établir les règles de votre discipline." %}
        </p>
    </div>

    <!-- Progress Tracker -->
    <div class="progress-container">
        <div class="progress-steps">
            <div class="step completed">
                {% trans "Rôle" %}
            </div>
            <div class="step active">
                {% trans "Fédération" %}
            </div>
            <div class="step">
                {% trans "Finalisation" %}
            </div>
        </div>
        <div class="progress-wrapper">
            <div class="progress-bar" style="width: 0%"></div>
        </div>
    </div>

    <div class="onboarding-card">
        <form method="post" enctype="multipart/form-data">
            {% csrf_token %}
            
            <!-- Informations générales -->
            <div class="form-section">
                <h2 class="section-title">
                    <i class="fas fa-info-circle"></i>
                    {% trans "Informations générales" %}
                </h2>
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group">
                            <label for="{{ form.name.id_for_label }}" class="form-label required">
                                {{ form.name.label }}
                            </label>
                            {{ form.name }}
                            {% if form.name.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.name.errors }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="{{ form.logo.id_for_label }}" class="form-label">
                                {{ form.logo.label }}
                            </label>
                            
                            <div class="preview-container">
                                <img src="#" alt="{% trans 'Aperçu du logo' %}" class="logo-preview" id="logoPreview">
                            </div>
                            
                            <div class="custom-file">
                                {{ form.logo }}
                                <label class="custom-file-label" for="{{ form.logo.id_for_label }}">
                                    {% trans "Choisir un fichier..." %}
                                </label>
                            </div>
                            {% if form.logo.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.logo.errors }}
                                </div>
                            {% endif %}
                            {% if form.logo.help_text %}
                                <small class="form-text text-muted">{{ form.logo.help_text }}</small>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="{{ form.description.id_for_label }}" class="form-label">
                        {{ form.description.label }}
                    </label>
                    {{ form.description }}
                    {% if form.description.errors %}
                        <div class="invalid-feedback d-block">
                            {{ form.description.errors }}
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Disciplines -->
            <div class="form-section">
                <h2 class="section-title">
                    <i class="fas fa-karate"></i>
                    {% trans "Disciplines" %}
                </h2>
                
                <p class="text-muted mb-3">{% trans "Sélectionnez les disciplines gérées par votre fédération." %}</p>
                
                <div class="disciplines-container">
                    {% if disciplines %}
                        {% for discipline in disciplines %}
                            <div class="discipline-item">
                                <input type="checkbox" 
                                    class="form-check-input" 
                                    name="disciplines" 
                                    id="discipline-{{ discipline.id }}" 
                                    value="{{ discipline.id }}">
                                <div class="discipline-icon">
                                    <i class="fas fa-fist-raised"></i>
                                </div>
                                <div class="discipline-details">
                                    <label class="discipline-name" for="discipline-{{ discipline.id }}">
                                        {{ discipline.name }}
                                    </label>
                                    {% if discipline.country_origin %}
                                        <div class="discipline-origin">{{ discipline.country_origin }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            {% trans "Aucune discipline n'est disponible pour le moment." %}
                        </div>
                    {% endif %}
                </div>
                
                <!-- Bouton d'ajout de discipline -->
                <button type="button" class="add-discipline-btn" id="addDisciplineBtn">
                    <i class="fas fa-plus-circle"></i>
                    {% trans "Ajouter une nouvelle discipline" %}
                </button>
                
                <!-- Formulaire d'ajout de discipline -->
                <div id="newDisciplineForm">
                    <h3 class="h5 mb-3">{% trans "Nouvelle discipline" %}</h3>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="new_discipline_name" class="form-label required">{% trans "Nom" %}</label>
                                <input type="text" id="new_discipline_name" name="new_discipline_name" class="form-control" placeholder="{% trans 'Ex: Karaté' %}">
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="new_discipline_origin" class="form-label">{% trans "Pays d'origine" %}</label>
                                <input type="text" id="new_discipline_origin" name="new_discipline_origin" class="form-control" placeholder="{% trans 'Ex: Japon' %}">
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="new_discipline_description" class="form-label">{% trans "Description" %}</label>
                        <textarea id="new_discipline_description" name="new_discipline_description" class="form-control" rows="3" placeholder="{% trans 'Description de la discipline...' %}"></textarea>
                    </div>
                    
                    <div class="d-flex justify-content-end mt-3">
                        <button type="button" class="btn btn-outline-secondary me-2" id="cancelDisciplineBtn">
                            {% trans "Annuler" %}
                        </button>
                        <button type="button" class="btn btn-primary" id="saveDisciplineBtn">
                            <i class="fas fa-check me-2"></i>
                            {% trans "Ajouter" %}
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Localisation et contact -->
            <div class="form-section">
                <h2 class="section-title">
                    <i class="fas fa-map-marker-alt"></i>
                    {% trans "Localisation et Contact" %}
                </h2>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="country-search" class="form-label">
                                {% trans "Pays" %}
                            </label>
                            <div class="country-select-container">
                                <input type="text" 
                                       id="country-search" 
                                       class="form-control country-search-input" 
                                       placeholder="{% trans 'Rechercher un pays...' %}"
                                       autocomplete="off">
                                <div class="country-dropdown" id="country-dropdown">
                                    <!-- Les options seront ajoutées via JavaScript -->
                                </div>
                                <input type="hidden" name="country" id="selected-country" value="">
                            </div>
                            {% if form.country.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.country.errors }}
                                </div>
                            {% endif %}
                            <small class="form-text text-muted">
                                {% trans "Commencez à taper pour rechercher votre pays" %}
                            </small>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="{{ form.city.id_for_label }}" class="form-label">
                                {{ form.city.label }}
                            </label>
                            {{ form.city }}
                            {% if form.city.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.city.errors }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="{{ form.address.id_for_label }}" class="form-label">
                        {{ form.address.label }}
                    </label>
                    {{ form.address }}
                    {% if form.address.errors %}
                        <div class="invalid-feedback d-block">
                            {{ form.address.errors }}
                        </div>
                    {% endif %}
                </div>
                
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="{{ form.postal_code.id_for_label }}" class="form-label">
                                {{ form.postal_code.label }}
                            </label>
                            {{ form.postal_code }}
                            {% if form.postal_code.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.postal_code.errors }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="{{ form.contact_email.id_for_label }}" class="form-label">
                                {{ form.contact_email.label }}
                            </label>
                            {{ form.contact_email }}
                            {% if form.contact_email.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.contact_email.errors }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="{{ form.contact_phone.id_for_label }}" class="form-label">
                                {{ form.contact_phone.label }}
                            </label>
                            {{ form.contact_phone }}
                            {% if form.contact_phone.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.contact_phone.errors }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="{{ form.website.id_for_label }}" class="form-label">
                                {{ form.website.label }}
                            </label>
                            {{ form.website }}
                            {% if form.website.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.website.errors }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="{{ form.founding_date.id_for_label }}" class="form-label">
                                {{ form.founding_date.label }}
                            </label>
                            {{ form.founding_date }}
                            {% if form.founding_date.errors %}
                                <div class="invalid-feedback d-block">
                                    {{ form.founding_date.errors }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Site Web et Sous-domaine Automatique -->
            <div class="form-section">
                <h2 class="section-title">
                    <i class="fas fa-globe"></i>
                    {% trans "Votre site web fédéral" %}
                </h2>
                
                <p class="text-muted mb-3">
                    {% trans "Nous créons automatiquement un site web professionnel pour votre fédération avec un sous-domaine personnalisé." %}
                </p>
                
                <!-- Prévisualisation du sous-domaine -->
                <div class="subdomain-preview" id="subdomainPreview">
                    <div class="subdomain-url" id="subdomainUrl">
                        <i class="fas fa-link me-2"></i>
                        <span id="generatedSubdomain">votre-federation</span>.martialcomp.com
                    </div>
                    <div class="subdomain-description">
                        {% trans "Votre site web sera automatiquement accessible à cette adresse" %}
                    </div>
                    
                    <div class="subdomain-features">
                        <div class="subdomain-feature">
                            <i class="fas fa-check"></i>
                            {% trans "Design responsive" %}
                        </div>
                        <div class="subdomain-feature">
                            <i class="fas fa-check"></i>
                            {% trans "SSL automatique" %}
                        </div>
                        <div class="subdomain-feature">
                            <i class="fas fa-check"></i>
                            {% trans "Multilingue" %}
                        </div>
                        <div class="subdomain-feature">
                            <i class="fas fa-check"></i>
                            {% trans "Gestion des clubs" %}
                        </div>
                        <div class="subdomain-feature">
                            <i class="fas fa-check"></i>
                            {% trans "Compétitions" %}
                        </div>
                        <div class="subdomain-feature">
                            <i class="fas fa-check"></i>
                            {% trans "Tableau de bord" %}
                        </div>
                    </div>
                </div>
                
                <!-- Option de personnalisation -->
                <div class="mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="customSubdomain" name="enable_custom_subdomain">
                        <label class="form-check-label" for="customSubdomain">
                            {% trans "Je veux personnaliser mon sous-domaine" %}
                        </label>
                    </div>
                    
                    <div id="customSubdomainInput" style="display: none;" class="mt-2">
                        <div class="input-group">
                            <input type="text" 
                                   id="customSubdomainField" 
                                   name="custom_subdomain" 
                                   class="form-control" 
                                   placeholder="{% trans 'mon-federation' %}"
                                   pattern="^[a-z0-9-]+$">
                            <span class="input-group-text">.martialcomp.com</span>
                        </div>
                        <small class="form-text text-muted">
                            {% trans "Seules les lettres minuscules, chiffres et tirets sont autorisés" %}
                        </small>
                    </div>
                </div>
            </div>
            
            <div class="actions-container">
                <a href="{% url 'competitions:onboarding:role_selection' %}" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>{% trans "Retour" %}
                </a>
                
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>{% trans "Créer ma fédération" %}
