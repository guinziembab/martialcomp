<!-- templates/competitions/onboarding/base_onboarding.html -->
{% extends "base.html" %}
{% load i18n %}

{% block content %}
<div class="onboarding-container">
    <div class="onboarding-header">
        <h1>{% block onboarding_title %}Configuration de votre compte{% endblock %}</h1>
        <p class="lead">{% block onboarding_subtitle %}Suivez ces étapes pour configurer votre compte MartialComp{% endblock %}</p>
    </div>
    
    <!-- Barre de progression -->
    <div class="progress-tracker">
        <div class="step{% if current_step == 'role_selection' %} active{% elif current_step != 'role_selection' %} completed{% endif %}">
            <div class="step-icon">1</div>
            <div class="step-label">{% trans "Rôle" %}</div>
        </div>
        <div class="step{% if current_step == 'club_creation' or current_step == 'federation_creation' or current_step == 'judge_profile' or current_step == 'participant_profile' or current_step == 'coach_profile' %} active{% elif current_step == 'final_setup' %} completed{% endif %}">
            <div class="step-icon">2</div>
            <div class="step-label">{% trans "Configuration" %}</div>
        </div>
        <div class="step{% if current_step == 'final_setup' %} active{% endif %}">
            <div class="step-icon">3</div>
            <div class="step-label">{% trans "Finalisation" %}</div>
        </div>
    </div>
    
    {% if messages %}
        <div class="messages">
            {% for message in messages %}
                <div class="alert alert-{{ message.tags }}">{{ message }}</div>
            {% endfor %}
        </div>
    {% endif %}
    
    <div class="onboarding-content">
        {% block onboarding_content %}{% endblock %}
    </div>
</div>
{% endblock %}