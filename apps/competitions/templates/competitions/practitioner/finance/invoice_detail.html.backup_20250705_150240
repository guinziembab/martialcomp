{% extends "competitions/practitioner/base.html" %}
{% load i18n %}
{% load static %}

{% block title %}{% translate "Facture" %} #{{ invoice.invoice_number|default:invoice.id }}{% endblock %}

{% block content %}
<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0">{% translate "Facture" %} #{{ invoice.invoice_number|default:invoice.id }}</h2>
        <div>
            <a href="{% url 'competitions:practitioner:invoice_list' %}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> {% translate "Retour à la liste" %}
            </a>
            <button class="btn btn-primary" onclick="printInvoice()">
                <i class="fas fa-print"></i> {% translate "Imprimer" %}
            </button>
            <button class="btn btn-success" onclick="downloadPDF()">
                <i class="fas fa-file-pdf"></i> {% translate "Télécharger PDF" %}
            </button>
        </div>
    </div>

    <!-- Facture -->
    <div class="card">
        <div class="card-body invoice-body">
            <!-- En-tête de la facture -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <img src="{% static 'images/logo.png' %}" alt="{% trans "Logo" %}" class="invoice-logo mb-3" style="max-height: 60px;">
                    <h5>{{ organisation.name|default:"MartialComp" }}</h5>
                    <p class="text-muted mb-0">
                        {{ organisation.address|default:"Adresse de l'organisation" }}<br>
                        {{ organisation.postal_code|default:"" }} {{ organisation.city|default:"" }}<br>
                        {{ organisation.country|default:"" }}
                    </p>
                </div>
                <div class="col-md-6 text-end">
                    <h3 class="text-primary">{% translate "FACTURE" %}</h3>
                    <p class="mb-1">
                        <strong>{% translate "N°" %}:</strong> {{ invoice.invoice_number|default:"#" }}{{ invoice.id }}<br>
                        <strong>{% translate "Date" %}:</strong> {{ invoice.issue_date|date:"d/m/Y" }}<br>
                        <strong>{% translate "Échéance" %}:</strong> {{ invoice.due_date|date:"d/m/Y" }}
                    </p>
                    <div class="mt-3">
                        {% if invoice.status == 'paid' %}
                            <span class="badge bg-success fs-6">
                                <i class="fas fa-check"></i> {% translate "Payée" %}
                            </span>
                        {% elif invoice.status == 'pending' %}
                            <span class="badge bg-warning fs-6">
                                <i class="fas fa-clock"></i> {% translate "En attente" %}
                            </span>
                        {% elif invoice.status == 'overdue' %}
                            <span class="badge bg-danger fs-6">
                                <i class="fas fa-exclamation-triangle"></i> {% translate "En retard" %}
                            </span>
                        {% else %}
                            <span class="badge bg-secondary fs-6">
                                <i class="fas fa-file"></i> {% translate "Brouillon" %}
                            </span>
                        {% endif %}
                    </div>
                </div>
            </div>

            <hr>

            <!-- Informations client -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <h6 class="text-uppercase text-muted">{% translate "Facturé à" %}</h6>
                    <strong>{{ invoice.client_name|default:practitioner.get_full_name }}</strong><br>
                    {{ invoice.client_address|default:practitioner.address }}<br>
                    {{ invoice.client_postal_code|default:practitioner.postal_code }} 
                    {{ invoice.client_city|default:practitioner.city }}<br>
                    {{ invoice.client_country|default:practitioner.country }}
                </div>
                <div class="col-md-6">
                    <h6 class="text-uppercase text-muted">{% translate "Informations de paiement" %}</h6>
                    <p class="mb-0">
                        <strong>{% translate "Méthode" %}:</strong> 
                        {% if invoice.payment_method == 'bank_transfer' %}
                            {% translate "Virement bancaire" %}
                        {% elif invoice.payment_method == 'card' %}
                            {% translate "Carte bancaire" %}
                        {% elif invoice.payment_method == 'cash' %}
                            {% translate "Espèces" %}
                        {% else %}
                            {{ invoice.payment_method }}
                        {% endif %}<br>
                        <strong>{% translate "Référence" %}:</strong> {{ invoice.reference|default:"-" }}
                    </p>
                </div>
            </div>

            <!-- Détails de la facture -->
            <div class="table-responsive mb-4">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{% translate "Description" %}</th>
                            <th class="text-center">{% translate "Quantité" %}</th>
                            <th class="text-end">{% translate "Prix unitaire" %}</th>
                            <th class="text-end">{% translate "Total HT" %}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in invoice.items.all %}
                        <tr>
                            <td>{{ item.description }}</td>
                            <td class="text-center">{{ item.quantity }}</td>
                            <td class="text-end">{{ item.unit_price|floatformat:2 }} €</td>
                            <td class="text-end">{{ item.total|floatformat:2 }} €</td>
                        </tr>
                        {% empty %}
                        <tr>
                            <td>{{ invoice.description|default:"Service" }}</td>
                            <td class="text-center">1</td>
                            <td class="text-end">{{ invoice.subtotal|floatformat:2 }} €</td>
                            <td class="text-end">{{ invoice.subtotal|floatformat:2 }} €</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Totaux -->
            <div class="row">
                <div class="col-md-6">
                    {% if invoice.notes %}
                    <h6 class="text-muted">{% translate "Notes" %}</h6>
                    <p>{{ invoice.notes|linebreaks }}</p>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td class="text-end"><strong>{% translate "Sous-total HT" %}:</strong></td>
                                <td class="text-end">{{ invoice.subtotal|floatformat:2 }} €</td>
                            </tr>
                            {% if invoice.tax_rate %}
                            <tr>
                                <td class="text-end"><strong>{% translate "TVA" %} ({{ invoice.tax_rate }}%):</strong></td>
                                <td class="text-end">{{ invoice.tax_amount|floatformat:2 }} €</td>
                            </tr>
                            {% endif %}
                            <tr>
                                <td class="text-end"><h5>{% translate "Total TTC" %}:</h5></td>
                                <td class="text-end"><h5>{{ invoice.total_amount|floatformat:2 }} €</h5></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Actions -->
            {% if invoice.status == 'pending' %}
            <hr>
            <div class="text-center">
                <a href="#" class="btn btn-success btn-lg">
                    <i class="fas fa-credit-card"></i> {% translate "Payer maintenant" %}
                </a>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Historique des paiements -->
    {% if invoice.payments.exists %}
    <div class="card mt-4">
        <div class="card-header">
            <h5 class="card-title mb-0">{% translate "Historique des paiements" %}</h5>
        </div>
        <div class="card-body">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>{% translate "Date" %}</th>
                        <th>{% translate "Montant" %}</th>
                        <th>{% translate "Méthode" %}</th>
                        <th>{% translate "Statut" %}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payment in invoice.payments.all %}
                    <tr>
                        <td>{{ payment.payment_date|date:"d/m/Y" }}</td>
                        <td>{{ payment.amount|floatformat:2 }} €</td>
                        <td>{{ payment.payment_method }}</td>
                        <td>
                            {% if payment.status == 'completed' %}
                                <span class="badge bg-success">{% translate "Complété" %}</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ payment.status }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}
</div>

<script>
function printInvoice() {
    window.print();
}

function downloadPDF() {
    window.location.href = "{{ request.path }}?download=pdf";
}
</script>

<style>
.invoice-body {
    background: white;
    padding: 2rem;
}

@media print {
    .btn, .card-header {
        display: none !important;
    }
    
    .card {
        border: none !important;
        box-shadow: none !important;
    }
    
    .invoice-body {
        padding: 0;
    }
}

.table th {
    background-color: #f8f9fa;
    font-weight: 600;
}
</style>
{% endblock %}