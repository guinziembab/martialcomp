{% extends "competitions/practitioner/base.html" %}
{% load i18n %}
{% load static %}

{% block title %}{% translate "Mes Paiements" %}{% endblock %}

{% block content %}
<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0">{% translate "Historique des Paiements" %}</h2>
        <a href="{% url 'competitions:practitioner:finance_dashboard' %}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> {% translate "Retour au tableau de bord" %}
        </a>
    </div>

    <!-- Filtres -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="status" class="form-label">{% translate "Statut" %}</label>
                    <select class="form-select" id="status" name="status">
                        <option value="">{% translate "Tous" %}</option>
                        <option value="pending">{% translate "En attente" %}</option>
                        <option value="completed">{% translate "Complété" %}</option>
                        <option value="failed">{% translate "Échoué" %}</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="date_from" class="form-label">{% translate "Date début" %}</label>
                    <input type="date" class="form-control" id="date_from" name="date_from">
                </div>
                <div class="col-md-3">
                    <label for="date_to" class="form-label">{% translate "Date fin" %}</label>
                    <input type="date" class="form-control" id="date_to" name="date_to">
                </div>
                <div class="col-md-3">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> {% translate "Filtrer" %}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Liste des paiements -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">{% translate "Liste des Paiements" %}</h5>
        </div>
        <div class="card-body">
            {% if payments %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>{% translate "Référence" %}</th>
                                <th>{% translate "Date" %}</th>
                                <th>{% translate "Description" %}</th>
                                <th>{% translate "Montant" %}</th>
                                <th>{% translate "Méthode" %}</th>
                                <th>{% translate "Statut" %}</th>
                                <th>{% translate "Actions" %}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for payment in payments %}
                            <tr>
                                <td>{{ payment.reference|default:"#" }}{{ payment.id }}</td>
                                <td>{{ payment.payment_date|date:"d/m/Y" }}</td>
                                <td>{{ payment.description }}</td>
                                <td class="text-end">{{ payment.amount|floatformat:2 }} €</td>
                                <td>
                                    {% if payment.payment_method == 'card' %}
                                        <i class="fas fa-credit-card"></i> {% translate "Carte" %}
                                    {% elif payment.payment_method == 'bank_transfer' %}
                                        <i class="fas fa-university"></i> {% translate "Virement" %}
                                    {% elif payment.payment_method == 'cash' %}
                                        <i class="fas fa-money-bill"></i> {% translate "Espèces" %}
                                    {% else %}
                                        {{ payment.payment_method }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if payment.status == 'completed' %}
                                        <span class="badge bg-success">
                                            <i class="fas fa-check"></i> {% translate "Complété" %}
                                        </span>
                                    {% elif payment.status == 'pending' %}
                                        <span class="badge bg-warning">
                                            <i class="fas fa-clock"></i> {% translate "En attente" %}
                                        </span>
                                    {% elif payment.status == 'failed' %}
                                        <span class="badge bg-danger">
                                            <i class="fas fa-times"></i> {% translate "Échoué" %}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ payment.status }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{% url 'competitions:practitioner:payment_detail' payment.id %}" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i> {% translate "Détails" %}
                                    </a>
                                    {% if payment.status == 'completed' %}
                                        <button class="btn btn-sm btn-outline-success" 
                                                onclick="downloadReceipt('{{ payment.id }}')">
                                            <i class="fas fa-download"></i> {% translate "Reçu" %}
                                        </button>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                {% if page_obj %}
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {% if page_obj.has_previous %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ page_obj.previous_page_number }}">
                                    {% translate "Précédent" %}
                                </a>
                            </li>
                        {% endif %}
                        
                        {% for num in page_obj.paginator.page_range %}
                            <li class="page-item {% if page_obj.number == num %}active{% endif %}">
                                <a class="page-link" href="?page={{ num }}">{{ num }}</a>
                            </li>
                        {% endfor %}
                        
                        {% if page_obj.has_next %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ page_obj.next_page_number }}">
                                    {% translate "Suivant" %}
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
                {% endif %}
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-file-invoice-dollar fa-3x text-muted mb-3"></i>
                    <p class="text-muted">{% translate "Aucun paiement trouvé" %}</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
function downloadReceipt(paymentId) {
    // Fonction pour télécharger un reçu
    window.location.href = "{% url 'competitions:practitioner:payment_detail' 0 %}".replace('0', paymentId) + '?download=receipt';
}
</script>

<style>
.table th {
    background-color: #f8f9fa;
    font-weight: 600;
}

.badge {
    padding: 0.5em 0.75em;
}

.btn-sm {
    margin: 0 2px;
}
</style>
{% endblock %}