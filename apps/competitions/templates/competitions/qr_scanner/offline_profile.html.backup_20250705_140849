{% extends "base.html" %}
{% load i18n %}
{% load static %}

{% block title %}{{ page_title }}{% endblock %}

{% block extra_css %}
{% include 'competitions/qr_scanner/include_offline_profile_css.html' %}
{% endblock %}

{% block content %}
<div class="container profile-qr-container">
    <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">{% trans "Profil hors-ligne" %} - {{ practitioner.full_name }}</h4>
            
            <div class="no-print">
                <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                    <i class="fas fa-print"></i> {% trans "Imprimer" %}
                </button>
            </div>
        </div>
        
        <div class="card-body">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                {% trans "Ce QR code contient toutes les informations de votre profil de pratiquant. Il peut être scanné sans connexion internet pour vérifier votre identité lors des événements." %}
            </div>
            
            <div class="offline-profile-qr">
                <div class="qr-image">
                    {% if qr_code.offline_profile_qr_image %}
                    <img src="{{ qr_code.offline_profile_qr_image.url }}" alt="QR Code du profil">
                    {% else %}
                    <div class="alert alert-warning">
                        {% trans "QR code en cours de génération..." %}
                    </div>
                    {% endif %}
                </div>
                
                <h5 class="mt-3">{{ practitioner.full_name }}</h5>
                <p class="text-muted mb-1">{{ practitioner.organization.name }}</p>
                <p class="text-muted mb-3">{% trans "Licence" %}: {{ practitioner.license_number|default:"-" }}</p>
                
                {% if practitioner.grade %}
                <div class="badge badge-info p-2">
                    {{ practitioner.grade_display }}
                </div>
                {% endif %}
            </div>
            
            <div class="info-block no-print">
                <h5>{% trans "Informations sur le profil hors-ligne" %}</h5>
                <p>{% trans "Ce QR code contient un token sécurisé avec vos informations de profil pour une utilisation hors-ligne." %}</p>
                
                <div class="token-container">
                    <div class="token-text" id="tokenText">{{ profile_data.token }}</div>
                    <button class="btn btn-sm btn-outline-secondary copy-btn" onclick="copyToken()">
                        <i class="fas fa-copy"></i> {% trans "Copier" %}
                    </button>
                </div>
                
                <div class="expiry-info">
                    <div>
                        <i class="fas fa-clock mr-2"></i>
                        {% trans "Généré le" %}:
                        <strong>{{ profile_data.generated_at }}</strong>
                    </div>
                    <div>
                        {% trans "Valable jusqu'au" %}:
                        <strong>{{ profile_data.expires_at }}</strong>
                    </div>
                </div>
            </div>
            
            <div class="actions no-print">
                <a href="{% url 'competitions:practitioner:view_qr' practitioner.id %}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> {% trans "Retour au QR code standard" %}
                </a>
                
                <a href="{% url 'competitions:qr:view_offline_profile_with_token' token=profile_data.token %}" class="btn btn-primary ml-2" target="_blank">
                    <i class="fas fa-eye"></i> {% trans "Prévisualiser" %}
                </a>
                
                <button class="btn btn-success ml-2" onclick="downloadQR()">
                    <i class="fas fa-download"></i> {% trans "Télécharger QR Code" %}
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    function copyToken() {
        const tokenText = document.getElementById('tokenText');
        const textArea = document.createElement('textarea');
        textArea.value = tokenText.textContent;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        
        const copyBtn = document.querySelector('.copy-btn');
        const originalHTML = copyBtn.innerHTML;
        copyBtn.innerHTML = '<i class="fas fa-check"></i> {% trans "Copié!" %}';
        copyBtn.classList.add('btn-success');
        copyBtn.classList.remove('btn-outline-secondary');
        
        setTimeout(() => {
            copyBtn.innerHTML = originalHTML;
            copyBtn.classList.remove('btn-success');
            copyBtn.classList.add('btn-outline-secondary');
        }, 2000);
    }
    
    function downloadQR() {
        const qrImage = document.querySelector('.qr-image img');
        const link = document.createElement('a');
        link.download = 'profile_{{ practitioner.id }}_{{ practitioner.last_name }}.png';
        link.href = qrImage.src;
        link.click();
    }
</script>
{% endblock %}