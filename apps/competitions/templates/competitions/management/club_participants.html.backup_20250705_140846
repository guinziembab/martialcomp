{% extends "base.html" %}
{% load i18n %}
{% load static %}

{% block title %}{{ club.name }} - {% trans "Participants" %}{% endblock %}

{% block extra_css %}
<style>
    .club-header {
        background-color: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }
    
    .club-logo {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #fff;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    }
    
    .badge-pending {
        background-color: #f0ad4e;
        color: white;
    }
    
    .badge-approved {
        background-color: #5cb85c;
        color: white;
    }
    
    .badge-rejected {
        background-color: #d9534f;
        color: white;
    }
    
    .quick-actions {
        position: sticky;
        top: 20px;
    }
    
    .stat-card {
        transition: all 0.3s ease;
        border-radius: 8px;
        margin-bottom: 15px;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    
    .participant-row:hover {
        background-color: rgba(0,0,0,0.03);
    }
    
    .action-buttons .btn {
        margin-right: 5px;
    }
</style>
{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{% url 'competitions:management:participants_list' competition.id %}" class="btn btn-outline-secondary mb-2">
                <i class="fas fa-arrow-left me-2"></i>{% trans "Retour à la liste" %}
            </a>
            <h1 class="h3 mb-0">{{ club.name }} - {% trans "Participants" %}</h1>
        </div>
        
        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" type="button" id="clubActionsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-cog me-2"></i>{% trans "Actions" %}
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="clubActionsDropdown">
                <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#bulkApproveModal">
                        <i class="fas fa-check-double me-2"></i>{% trans "Approuver tous les participants" %}
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="{% url 'competitions:management:category_assignment' competition.id %}?club={{ club.id }}">
                        <i class="fas fa-layer-group me-2"></i>{% trans "Assigner des catégories" %}
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#exportModal">
                        <i class="fas fa-file-export me-2"></i>{% trans "Exporter la liste" %}
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#contactModal">
                        <i class="fas fa-envelope me-2"></i>{% trans "Contacter le club" %}
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- En-tête du club -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body club-header">
            <div class="row align-items-center">
                <div class="col-auto">
                    {% if club.logo %}
                        <img src="{{ club.logo.url }}" alt="{{ club.name }}" class="club-logo">
                    {% else %}
                        <div class="club-logo bg-primary d-flex align-items-center justify-content-center">
                            <i class="fas fa-dojo text-white fa-2x"></i>
                        </div>
                    {% endif %}
                </div>
                <div class="col">
                    <h2 class="h4 mb-1">{{ club.name }}</h2>
                    <p class="text-muted mb-0">
                        {% if club.city %}
                            <i class="fas fa-map-marker-alt me-1"></i>{{ club.city }}
                            {% if club.postal_code %} ({{ club.postal_code }}){% endif %}
                        {% endif %}
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="mb-2">
                        {% if club.contact_email %}
                            <span><i class="fas fa-envelope me-1"></i>{{ club.contact_email }}</span><br>
                        {% endif %}
                        {% if club.contact_phone %}
                            <span><i class="fas fa-phone me-1"></i>{{ club.contact_phone }}</span><br>
                        {% endif %}
                        {% if club.website %}
                            <span><i class="fas fa-globe me-1"></i><a href="{{ club.website }}" target="_blank">{{ club.website }}</a></span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Statistiques et actions rapides -->
        <div class="col-md-3">
            <div class="quick-actions">
                <h5 class="mb-3">{% trans "Statistiques" %}</h5>
                
                <div class="card bg-light stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle text-muted">{% trans "Total" %}</h6>
                                <h3 class="card-title mb-0">{{ registrations|length }}</h3>
                            </div>
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px">
                                <i class="fas fa-users text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card bg-light stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle text-muted">{% trans "En attente" %}</h6>
                                <h3 class="card-title mb-0">{{ registrations|selectattr:"status"|selecteq:"pending"|length }}</h3>
                            </div>
                            <div class="bg-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px">
                                <i class="fas fa-clock text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card bg-light stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle text-muted">{% trans "Approuvés" %}</h6>
                                <h3 class="card-title mb-0">{{ registrations|selectattr:"status"|selecteq:"approved"|length }}</h3>
                            </div>
                            <div class="bg-success rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px">
                                <i class="fas fa-check text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card bg-light stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle text-muted">{% trans "Rejetés" %}</h6>
                                <h3 class="card-title mb-0">{{ registrations|selectattr:"status"|selecteq:"rejected"|length }}</h3>
                            </div>
                            <div class="bg-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px">
                                <i class="fas fa-times text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
                
                <hr class="my-4">
                
                <h5 class="mb-3">{% trans "Actions rapides" %}</h5>
                <div class="d-grid gap-2">
                    <a href="#" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#bulkApproveModal">
                        <i class="fas fa-check-double me-2"></i>{% trans "Approuver tous" %}
                    </a>
                    <a href="{% url 'competitions:management:category_assignment' competition.id %}?club={{ club.id }}" class="btn btn-outline-secondary">
                        <i class="fas fa-layer-group me-2"></i>{% trans "Assigner catégories" %}
                    </a>
                    <a href="#" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#exportModal">
                        <i class="fas fa-file-export me-2"></i>{% trans "Exporter CSV" %}
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Liste des participants -->
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">{% trans "Liste des participants" %}</h5>
                        <div class="input-group w-50">
                            <input type="text" id="participantSearch" class="form-control" placeholder="{% trans 'Rechercher un participant...' %}">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="participantsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>{% trans "Nom" %}</th>
                                    <th>{% trans "Grade" %}</th>
                                    <th>{% trans "Catégories" %}</th>
                                    <th>{% trans "Statut" %}</th>
                                    <th class="text-end">{% trans "Actions" %}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if registrations %}
                                    {% for registration in registrations %}
                                        <tr class="participant-row">
                                            <td>
                                                <strong>{{ registration.practitioner.last_name }}</strong> {{ registration.practitioner.first_name }}
                                            </td>
                                            <td>
                                                {{ registration.practitioner.grade|default:"-" }}
                                            </td>
                                            <td>
                                                {% for category in registration.categories.all %}
                                                    <span class="badge bg-info text-dark">{{ category.name }}</span>
                                                {% empty %}
                                                    <span class="text-muted">{% trans "Aucune catégorie" %}</span>
                                                {% endfor %}
                                            </td>
                                            <td>
                                                {% if registration.status == 'pending' %}
                                                    <span class="badge badge-pending">{% trans "En attente" %}</span>
                                                {% elif registration.status == 'approved' %}
                                                    <span class="badge badge-approved">{% trans "Approuvé" %}</span>
                                                {% elif registration.status == 'rejected' %}
                                                    <span class="badge badge-rejected">{% trans "Rejeté" %}</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-end">
                                                <div class="action-buttons">
                                                    <a href="{% url 'competitions:management:participant_detail' competition.id registration.id %}" class="btn btn-sm btn-primary">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    
                                                    <form method="post" action="{% url 'competitions:management:update_registration_status' competition.id registration.id %}" class="d-inline">
                                                        {% csrf_token %}
                                                        <input type="hidden" name="redirect_to_list" value="1">
                                                        
                                                        {% if registration.status != 'approved' %}
                                                            <button type="submit" name="status" value="approved" class="btn btn-sm btn-success" title="{% trans 'Approuver' %}">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        {% endif %}
                                                        
                                                        {% if registration.status != 'rejected' %}
                                                            <button type="submit" name="status" value="rejected" class="btn btn-sm btn-danger" title="{% trans 'Rejeter' %}">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        {% endif %}
                                                        
                                                        {% if registration.status != 'pending' %}
                                                            <button type="submit" name="status" value="pending" class="btn btn-sm btn-warning" title="{% trans 'Remettre en attente' %}">
                                                                <i class="fas fa-undo"></i>
                                                            </button>
                                                        {% endif %}
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-4">
                                            <div class="alert alert-info mb-0">
                                                <i class="fas fa-info-circle me-2"></i>{% trans "Aucun participant inscrit pour ce club." %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Approbation en masse -->
<div class="modal fade" id="bulkApproveModal" tabindex="-1" aria-labelledby="bulkApproveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkApproveModalLabel">{% trans "Approuver tous les participants" %}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{% url 'competitions:management:bulk_approval' competition.id %}" method="post">
                {% csrf_token %}
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        {% trans "Vous êtes sur le point d'approuver tous les participants en attente de ce club. Voulez-vous continuer ?" %}
                    </div>
                    
                    <div class="mb-3">
                        <label for="note" class="form-label">{% trans "Ajouter une note (optionnel)" %}</label>
                        <textarea class="form-control" id="note" name="note" rows="3" placeholder="{% trans 'Cette note sera ajoutée à tous les participants approuvés' %}"></textarea>
                    </div>
                    
                    <!-- Champs cachés pour l'action et les participants -->
                    <input type="hidden" name="action" value="approved">
                    {% for registration in registrations %}
                        {% if registration.status == 'pending' %}
                            <input type="hidden" name="registrations" value="{{ registration.id }}">
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans "Annuler" %}</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check-double me-2"></i>{% trans "Approuver tous" %}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Export -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exportModalLabel">{% trans "Exporter la liste des participants" %}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>{% trans "Sélectionnez le format d'exportation :" %}</p>
                <div class="list-group">
                    <a href="{% url 'competitions:management:export_participants' competition.id %}?club={{ club.id }}" class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1"><i class="fas fa-file-csv me-2"></i>{% trans "Format CSV" %}</h5>
                            <small>.csv</small>
                        </div>
                        <p class="mb-1">{% trans "Fichier tabulaire, compatible avec Excel et autres tableurs." %}</p>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1"><i class="fas fa-file-pdf me-2"></i>{% trans "Format PDF" %}</h5>
                            <small>.pdf</small>
                        </div>
                        <p class="mb-1">{% trans "Document formaté pour l'impression." %}</p>
                    </a>
                </div>
                
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="includeContact">
                    <label class="form-check-label" for="includeContact">
                        {% trans "Inclure les coordonnées de contact" %}
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans "Annuler" %}</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Contact du club -->
<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="contactModalLabel">{% trans "Contacter le club" %}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label for="subject" class="form-label">{% trans "Sujet" %}</label>
                        <input type="text" class="form-control" id="subject" placeholder="{% trans 'Sujet du message' %}">
                    </div>
                    <div class="mb-3">
                        <label for="message" class="form-label">{% trans "Message" %}</label>
                        <textarea class="form-control" id="message" rows="5" placeholder="{% trans 'Votre message...' %}"></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="ccMe">
                        <label class="form-check-label" for="ccMe">
                            {% trans "M'envoyer une copie" %}
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans "Annuler" %}</button>
                <button type="button" class="btn btn-primary">
                    <i class="fas fa-paper-plane me-2"></i>{% trans "Envoyer" %}
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Recherche de participants
        const searchInput = document.getElementById('participantSearch');
        const participantsTable = document.getElementById('participantsTable');
        const participantRows = participantsTable.querySelectorAll('tbody tr');
        
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            
            participantRows.forEach(row => {
                if (row.querySelector('td')) {  // Vérifier que ce n'est pas une ligne de message "aucun participant"
                    const name = row.querySelector('td:first-child').textContent.toLowerCase();
                    const grade = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
                    const categories = row.querySelector('td:nth-child(3)').textContent.toLowerCase();
                    
                    if (name.includes(searchTerm) || grade.includes(searchTerm) || categories.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        });
        
        // Confirmation pour les actions de changement de statut
        document.querySelectorAll('button[name="status"]').forEach(button => {
            button.addEventListener('click', function(e) {
                const action = this.value;
                let message = '';
                
                if (action === 'approved') {
                    message = "{% trans 'Approuver cette inscription ?' %}";
                } else if (action === 'rejected') {
                    message = "{% trans 'Rejeter cette inscription ?' %}";
                } else if (action === 'pending') {
                    message = "{% trans 'Remettre cette inscription en attente ?' %}";
                }
                
                if (!confirm(message)) {
                    e.preventDefault();
                }
            });
        });
    });
</script>
{% endblock %}