                        <div class="col-md-6 text-end d-flex align-items-end justify-content-end">
                            <button class="btn btn-outline-primary me-2">
                                <i class="fas fa-undo me-1"></i>{% trans "Réinitialiser" %}
                            </button>
                            <button class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>{% trans "Enregistrer les paramètres" %}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal d'ajout de critère -->
<div class="modal fade" id="addCriterionModal" tabindex="-1" aria-labelledby="addCriterionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCriterionModalLabel">{% trans "Ajouter un critère de notation" %}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label for="criterionName" class="form-label">{% trans "Nom du critère" %}*</label>
                        <input type="text" class="form-control" id="criterionName" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="criterionDescription" class="form-label">{% trans "Description" %}</label>
                        <textarea class="form-control" id="criterionDescription" rows="3"></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="criterionWeight" class="form-label">{% trans "Pondération" %}*</label>
                                <input type="number" class="form-control" id="criterionWeight" value="1.0" min="0.1" step="0.1" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="criterionMinScore" class="form-label">{% trans "Score minimum" %}*</label>
                                <input type="number" class="form-control" id="criterionMinScore" value="5.0" step="0.1" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="criterionMaxScore" class="form-label">{% trans "Score maximum" %}*</label>
                                <input type="number" class="form-control" id="criterionMaxScore" value="10.0" step="0.1" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="criterionApplicability" class="form-label">{% trans "Applicable à" %}</label>
                        <select class="form-select" id="criterionApplicability">
                            <option value="kata">{% trans "Kata uniquement" %}</option>
                            <option value="kumite">{% trans "Kumite uniquement" %}</option>
                            <option value="both">{% trans "Kata et Kumite" %}</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans "Annuler" %}</button>
                <button type="button" class="btn btn-primary">{% trans "Ajouter le critère" %}</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Styles pour l'interface de simulation juge */
    .judge-interface-simulation {
        max-width: 100%;
        margin: 0 auto;
    }
    
    .judge-score-input .score-value {
        font-weight: bold;
        font-size: 1.1rem;
    }
    
    .handle {
        cursor: grab;
    }
    
    .handle:active {
        cursor: grabbing;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Gestion du changement de système de notation
        document.getElementById('scoringSystem').addEventListener('change', function() {
            // Logique pour mettre à jour les champs en fonction du système choisi
            console.log('Système de notation changé:', this.value);
        });
        
        // Gestion de la sélection de catégorie
        document.getElementById('categorySelection').addEventListener('change', function() {
            const customSelection = document.getElementById('customCategorySelection');
            if (this.value === 'custom') {
                customSelection.classList.remove('d-none');
            } else {
                customSelection.classList.add('d-none');
            }
        });
        
        // Simulation des boutons +/- pour les scores
        const incrementButtons = document.querySelectorAll('.judge-score-input button:nth-child(3)');
        const decrementButtons = document.querySelectorAll('.judge-score-input button:nth-child(1)');
        
        incrementButtons.forEach(button => {
            button.addEventListener('click', function() {
                const scoreElement = this.previousElementSibling.querySelector('.score-value');
                let currentScore = parseFloat(scoreElement.textContent);
                const newScore = Math.min(currentScore + 0.25, 10.0).toFixed(2);
                scoreElement.textContent = newScore;
                
                // Mise à jour de la barre de progression
                const progressBar = this.parentElement.nextElementSibling.querySelector('.progress-bar');
                const percentage = (newScore - 5) / 5 * 100;
                progressBar.style.width = percentage + '%';
                progressBar.setAttribute('aria-valuenow', newScore);
                
                // Activer/désactiver les boutons si nécessaire
                if (parseFloat(newScore) >= 10.0) {
                    this.disabled = true;
                }
                this.parentElement.querySelector('button:first-child').disabled = false;
            });
        });
        
        decrementButtons.forEach(button => {
            button.addEventListener('click', function() {
                const scoreElement = this.nextElementSibling.querySelector('.score-value');
                let currentScore = parseFloat(scoreElement.textContent);
                const newScore = Math.max(currentScore - 0.25, 5.0).toFixed(2);
                scoreElement.textContent = newScore;
                
                // Mise à jour de la barre de progression
                const progressBar = this.parentElement.nextElementSibling.querySelector('.progress-bar');
                const percentage = (newScore - 5) / 5 * 100;
                progressBar.style.width = percentage + '%';
                progressBar.setAttribute('aria-valuenow', newScore);
                
                // Activer/désactiver les boutons si nécessaire
                if (parseFloat(newScore) <= 5.0) {
                    this.disabled = true;
                }
                this.parentElement.querySelector('button:last-child').disabled = false;
            });
        });
    });
</script>
{% endblock %}