{% extends "organizations/base.html" %}
{% load static %}
{% load i18n %}

{% block title %}{% trans "Liste des organisations" %} | {% trans "Organisations" %}{% endblock %}

{% block content_title %}{% trans "Liste des organisations" %}{% endblock %}
{% block content_subtitle %}{% trans "Trouvez et explorez les organisations disponibles." %}{% endblock %}

{% block main_content %}
    <!-- Formulaire de recherche -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{% url 'organizations:list' %}" class="row g-3">
                <div class="col-md-4">
                    <label for="q" class="form-label">{% trans "Recherche" %}</label>
                    <input type="text" class="form-control" id="q" name="q" placeholder="{% trans 'Nom, description...' %}" value="{{ search_query }}">
                </div>
                <div class="col-md-3">
                    <label for="type" class="form-label">{% trans "Type" %}</label>
                    <select class="form-select" id="type" name="type">
                        <option value="">{% trans "Tous les types" %}</option>
                        {% for value, label in organization_types.items %}
                            <option value="{{ value }}" {% if selected_type == value %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="country" class="form-label">{% trans "Pays" %}</label>
                    <select class="form-select" id="country" name="country">
                        <option value="">{% trans "Tous les pays" %}</option>
                        {% for country_name in countries %}
                            <option value="{{ country_name }}" {% if selected_country == country_name %}selected{% endif %}>{{ country_name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>{% trans "Rechercher" %}
                    </button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Statistiques -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center bg-light">
                <div class="card-body">
                    <h5 class="card-title">{% trans "Total" %}</h5>
                    <p class="card-text display-6">{{ total_organizations }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center bg-light">
                <div class="card-body">
                    <h5 class="card-title">{% trans "Actives" %}</h5>
                    <p class="card-text display-6">{{ active_organizations }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center bg-light">
                <div class="card-body">
                    <h5 class="card-title">{% trans "Filtrées" %}</h5>
                    <p class="card-text display-6">{{ organizations|length }}</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Liste des organisations -->
    <div class="row row-cols-1 row-cols-md-2 g-4">
        {% if organizations %}
            {% for organization in organizations %}
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        {% if organization.logo %}
                            <div class="text-center pt-3">
                                <img src="{{ organization.logo.url }}" alt="{{ organization.name }}" class="organization-logo" style="max-height: 80px; max-width: 80%;">
                            </div>
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title">{{ organization.name }}</h5>
                            <h6 class="card-subtitle mb-2 text-muted">{{ organization.get_organization_type_display }}</h6>
                            <p class="card-text text-truncate">{{ organization.description|default:_("Aucune description disponible.") }}</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="fas fa-map-marker-alt me-1"></i> 
                                    {{ organization.city }}{% if organization.country %}, {{ organization.country }}{% endif %}
                                </small>
                                <span class="badge {% if organization.is_active %}bg-success{% else %}bg-danger{% endif %}">
                                    {% if organization.is_active %}{% trans "Actif" %}{% else %}{% trans "Inactif" %}{% endif %}
                                </span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="{% url 'organizations:detail' pk=organization.id %}" class="btn btn-outline-primary btn-sm w-100">
                                <i class="fas fa-info-circle me-1"></i> {% trans "Détails" %}
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    {% trans "Aucune organisation ne correspond à vos critères de recherche." %}
                </div>
            </div>
        {% endif %}
    </div>
    
    <!-- Pagination -->
    {% if is_paginated %}
        <div class="mt-4">
            <nav aria-label="{% trans 'Navigation des pages' %}">
                <ul class="pagination justify-content-center">
                    {% if page_obj.has_previous %}
                        <li class="page-item">
                            <a class="page-link" href="?page=1{% if search_query %}&q={{ search_query }}{% endif %}{% if selected_type %}&type={{ selected_type }}{% endif %}{% if selected_country %}&country={{ selected_country }}{% endif %}" aria-label="{% trans 'Première' %}">
                                <span aria-hidden="true">&laquo;&laquo;</span>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="?page={{ page_obj.previous_page_number }}{% if search_query %}&q={{ search_query }}{% endif %}{% if selected_type %}&type={{ selected_type }}{% endif %}{% if selected_country %}&country={{ selected_country }}{% endif %}" aria-label="{% trans 'Précédente' %}">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link">&laquo;&laquo;</span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">&laquo;</span>
                        </li>
                    {% endif %}
                    
                    {% for i in paginator.page_range %}
                        {% if page_obj.number == i %}
                            <li class="page-item active">
                                <span class="page-link">{{ i }} <span class="sr-only">(current)</span></span>
                            </li>
                        {% elif i > page_obj.number|add:'-3' and i < page_obj.number|add:'3' %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ i }}{% if search_query %}&q={{ search_query }}{% endif %}{% if selected_type %}&type={{ selected_type }}{% endif %}{% if selected_country %}&country={{ selected_country }}{% endif %}">{{ i }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                    
                    {% if page_obj.has_next %}
                        <li class="page-item">
                            <a class="page-link" href="?page={{ page_obj.next_page_number }}{% if search_query %}&q={{ search_query }}{% endif %}{% if selected_type %}&type={{ selected_type }}{% endif %}{% if selected_country %}&country={{ selected_country }}{% endif %}" aria-label="{% trans 'Suivante' %}">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="?page={{ paginator.num_pages }}{% if search_query %}&q={{ search_query }}{% endif %}{% if selected_type %}&type={{ selected_type }}{% endif %}{% if selected_country %}&country={{ selected_country }}{% endif %}" aria-label="{% trans 'Dernière' %}">
                                <span aria-hidden="true">&raquo;&raquo;</span>
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link">&raquo;</span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">&raquo;&raquo;</span>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        </div>
    {% endif %}
{% endblock %}

{% block sidebar_extra %}
    {% if user.is_authenticated and user_organizations %}
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">{% trans "Mes organisations" %}</h5>
            </div>
            <div class="list-group list-group-flush">
                {% for org in user_organizations %}
                    <a href="{% url 'organizations:detail' pk=org.id %}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        {{ org.name }}
                        <span class="badge bg-primary rounded-pill">{{ org.get_organization_type_display }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}