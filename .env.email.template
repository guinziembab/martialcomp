# ================================================================
# CONFIGURATION EMAIL MARTIALCOMP - IONOS SMTP
# ================================================================
# Copier ce fichier vers .env ou ajouter ces variables à votre .env existant
# Pour IONOS : smtp.ionos.fr (port 587 avec TLS)
#
# INSTRUCTIONS IONOS:
# 1. Créer une adresse email dans le panel IONOS (ex: noreply@martialcomp.com)
# 2. Utiliser l'adresse email complète comme EMAIL_HOST_USER
# 3. Utiliser le mot de passe de cette adresse email
# ================================================================

# Configuration SMTP IONOS
EMAIL_HOST=smtp.ionos.fr
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30

# Credentials IONOS (à remplacer par vos vraies valeurs)
EMAIL_HOST_USER=noreply@martialcomp.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_ionos

# Adresses email par défaut
DEFAULT_FROM_EMAIL=MartialComp <noreply@martialcomp.com>
SERVER_EMAIL=noreply@martialcomp.com

# Emails de service
ACCOUNTING_EMAIL=finance@martialcomp.com
CUSTOMER_SERVICE_EMAIL=support@martialcomp.com
SUPPORT_EMAIL=support@martialcomp.com
ADMIN_EMAIL=admin@martialcomp.com

# URL du site pour les liens dans les emails
SITE_URL=https://martialcomp.com

# ================================================================
# ALTERNATIVE: Configuration Gmail (si besoin)
# ================================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre-email@gmail.com
# EMAIL_HOST_PASSWORD=votre_mot_de_passe_application
# Note: Pour Gmail, utiliser un "mot de passe d'application"
# (Paramètres Google > Sécurité > Mots de passe des applications)
