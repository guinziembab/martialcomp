# Variables d'environnement pour le développement MartialComp
# NE PAS COMMITTER CE FICHIER

# Django
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Base de données de développement PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/martialcomp_dev

# Redis (pour le développement local)
REDIS_URL=redis://localhost:6379/0

# Email (pour les tests en développement)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025

# Authentification sociale - Clés de test (à configurer)
# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple Sign-In
APPLE_SERVICES_ID=
APPLE_PRIVATE_KEY=
APPLE_KEY_ID=
APPLE_TEAM_ID=

# Stripe (mode test)
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Sentry (désactivé en développement)
SENTRY_DSN=

# DeepL (optionnel pour les traductions)
DEEPL_API_KEY=

# Domaine de développement
DOMAIN=localhost:8000
SECURE_SSL_REDIRECT=False

# Configuration multi-tenant
TENANT_DOMAIN_MODEL=competitions.Club
TENANT_SCHEMA_NAME=public