            <div class="footer-content">
                <div class="footer-section">
                    <h3>{% trans "MartialComp" %}</h3>
                    <p>{% trans "La plateforme complète de gestion des arts martiaux pour clubs, fédérations et pratiquants." %}</p>
                    <div style="margin-top: 1rem;">
                        <a href="#" style="color: var(--accent); margin-right: 1rem;"><i class="fab fa-facebook"></i></a>
                        <a href="#" style="color: var(--accent); margin-right: 1rem;"><i class="fab fa-twitter"></i></a>
                        <a href="#" style="color: var(--accent); margin-right: 1rem;"><i class="fab fa-linkedin"></i></a>
                        <a href="#" style="color: var(--accent);"><i class="fab fa-instagram"></i></a>
                </div>
                </div>
                
