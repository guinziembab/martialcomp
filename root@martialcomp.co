<!DOCTYPE html>
{% load i18n %}
{% load static %}
<html lang="{{ LANGUAGE_CODE }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% trans "MartialComp - La Plateforme Complète de Gestion des Arts Martiaux" %}</title>
    
    <!-- Meta descriptions pour SEO -->
    <meta name="description" content="MartialComp est la solution complète pour organiser, gérer et participer aux compétitions d'arts martiaux. Gestion de clubs, membres, compétitions, finances et grades.">
    <meta name="keywords" content="arts martiaux, compétitions, karaté, judo, taekwondo, gestion club, membres, finances, grades">
    
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #c41e3a;
            --primary-dark: #a51a30;
            --secondary: #1a1a1a;
            --accent: #d4af37;
            --accent-dark: #b8941f;
            --light: #f8f9fa;
            --dark: #121212;
            --gray: #6c757d;
            --white: #ffffff;
            --success: #28a745;
            --info: #17a2b8;
            --warning: #ffc107;
            --border-radius: 8px;
            --shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            --shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.15);
            --transition: all 0.3s ease;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Montserrat', sans-serif;
            line-height: 1.6;
            background-color: var(--dark);
            color: var(--light);
            overflow-x: hidden;
        }
        
        /* ==== HEADER & NAVIGATION ==== */
        .header {
            background: linear-gradient(135deg, var(--secondary) 0%, var(--primary) 100%);
            padding: 1rem 0;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            backdrop-filter: blur(10px);
            border-bottom: 2px solid var(--accent);
        }
        
        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--white);
            text-decoration: none;
        }
        
        .logo img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
        }
        
        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }
        
        .nav-links a {
            color: var(--light);
            text-decoration: none;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: var(--border-radius);
            transition: var(--transition);
        }
        
        .nav-links a:hover {
            background-color: rgba(212, 175, 55, 0.2);
            color: var(--accent);
        }
        
        .auth-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .language-selector {
            position: relative;
        }
        
        .language-select {
            background: var(--secondary);
            color: var(--light);
            border: 2px solid var(--accent);
            border-radius: var(--border-radius);
            padding: 0.5rem 1rem;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            outline: none;
        }
        
        .language-select:hover {
            background: var(--accent);
            color: var(--dark);
        }
        
        .btn {
            padding: 0.75rem 1.5rem;
            border-radius: var(--border-radius);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .btn-primary {
            background: var(--primary);
            color: var(--white);
        }
        
        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }
        
        .btn-outline {
            background: transparent;
            color: var(--light);
            border: 2px solid var(--accent);
        }
        
        .btn-outline:hover {
            background: var(--accent);
            color: var(--dark);
        }
        
        /* ==== HERO SECTION ==== */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 120px 0 80px;
            background: linear-gradient(135deg, var(--dark) 0%, var(--secondary) 100%);
            position: relative;
            overflow: hidden;
        }
        
        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><defs><radialGradient id="g" cx="50%" cy="50%"><stop offset="0%" stop-color="%23c41e3a" stop-opacity="0.1"/><stop offset="100%" stop-color="%23c41e3a" stop-opacity="0"/></radialGradient></defs><circle cx="200" cy="200" r="150" fill="url(%23g)"/><circle cx="800" cy="300" r="200" fill="url(%23g)"/><circle cx="400" cy="700" r="180" fill="url(%23g)"/></svg>');
            opacity: 0.5;
            animation: float 20s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            33% { transform: translateY(-20px) rotate(1deg); }
            66% { transform: translateY(10px) rotate(-1deg); }
        }
        
        .hero-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
            position: relative;
            z-index: 2;
        }
        
        .hero-content {
            animation: fadeInUp 1s ease-out;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, var(--accent), var(--primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShift 3s ease-in-out infinite;
        }
        
        @keyframes gradientShift {
            0%, 100% { filter: hue-rotate(0deg); }
            50% { filter: hue-rotate(10deg); }
        }
        
        .hero-content p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
            color: var(--light);
            opacity: 0.9;
            line-height: 1.8;
        }
        
        .hero-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        
        .hero-buttons .btn {
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .hero-buttons .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }
        
        .hero-buttons .btn:hover::before {
            left: 100%;
        }
        
        .hero-image {
            text-align: center;
            animation: fadeInRight 1s ease-out 0.3s both;
        }
        
        @keyframes fadeInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        .hero-image img {
            max-width: 100%;
            height: auto;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-hover);
            transition: transform 0.3s ease;
        }
        
        .hero-image img:hover {
            transform: scale(1.05);
        }
        
        /* Floating elements animation */
        .floating-elements {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }
        
        .floating-element {
            position: absolute;
            width: 4px;
            height: 4px;
            background: var(--accent);
            border-radius: 50%;
            animation: floatElement 6s ease-in-out infinite;
        }
        
        .floating-element:nth-child(1) { top: 20%; left: 10%; animation-delay: 0s; }
        .floating-element:nth-child(2) { top: 60%; left: 80%; animation-delay: 2s; }
        .floating-element:nth-child(3) { top: 80%; left: 20%; animation-delay: 4s; }
        .floating-element:nth-child(4) { top: 30%; left: 70%; animation-delay: 1s; }
        .floating-element:nth-child(5) { top: 70%; left: 30%; animation-delay: 3s; }
        
        @keyframes floatElement {
            0%, 100% { transform: translateY(0px) scale(1); opacity: 0.7; }
            50% { transform: translateY(-20px) scale(1.2); opacity: 1; }
        }
        
        /* ==== FEATURES SECTION ==== */
        .features {
            padding: 100px 0;
            background: var(--secondary);
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 4rem;
        }
        
        .section-title h2 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--accent);
        }
        
        .section-title p {
            font-size: 1.1rem;
            color: var(--light);
            opacity: 0.8;
        }
        
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 4rem;
        }
        
        .feature-card {
            background: var(--dark);
            padding: 2rem;
            border-radius: var(--border-radius);
            border: 2px solid transparent;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }
        
        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--accent));
        }
        
        .feature-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent);
            box-shadow: var(--shadow-hover);
        }
        
        .feature-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            font-size: 1.5rem;
            color: var(--white);
        }
        
        .feature-card h3 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--accent);
        }
        
        .feature-card p {
            color: var(--light);
            opacity: 0.8;
            line-height: 1.6;
        }
        
        /* ==== PRICING SECTION ==== */
        .pricing {
            padding: 100px 0;
            background: var(--dark);
        }
        
        /* ==== TESTIMONIALS SECTION ==== */
        .testimonials {
            padding: 80px 0;
            background: var(--secondary);
        }
        
        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }
        
        .testimonial-card {
            background: var(--dark);
            padding: 2rem;
            border-radius: var(--border-radius);
            border-left: 4px solid var(--accent);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }
        
        .testimonial-card::before {
            content: '"';
            position: absolute;
            top: -10px;
            left: 20px;
            font-size: 4rem;
            color: var(--accent);
            opacity: 0.3;
            font-family: serif;
        }
        
        .testimonial-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
        }
        
        .testimonial-content p {
            color: var(--light);
            font-style: italic;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }
        
        .testimonial-author {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .author-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: var(--dark);
        }
        
        .author-name {
            font-weight: 600;
            color: var(--accent);
        }
        
        .author-title {
            font-size: 0.9rem;
            color: var(--light);
            opacity: 0.8;
        }
        
        /* ==== CTA SECTION ==== */
        .cta-section {
            padding: 100px 0;
            background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
            position: relative;
            overflow: hidden;
        }
        
        .cta-content {
            text-align: center;
            position: relative;
            z-index: 2;
        }
        
        .cta-content h2 {
            font-size: 3rem;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 1.5rem;
        }
        
        .cta-content p {
            font-size: 1.2rem;
            color: var(--white);
            opacity: 0.9;
            margin-bottom: 2rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .cta-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .cta-features {
            margin-top: 3rem;
            display: flex;
            justify-content: center;
            gap: 3rem;
            flex-wrap: wrap;
        }
        
        .cta-feature {
            text-align: center;
            color: var(--white);
        }
        
        .cta-feature i {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }
        
        /* ==== ENHANCED ANIMATIONS ==== */
        .animate-fade-in-up {
            animation: fadeInUp 0.8s ease-out forwards;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .animate-fade-in-right {
            animation: fadeInRight 0.8s ease-out forwards;
        }
        
        @keyframes fadeInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        /* ==== RESPONSIVE IMPROVEMENTS ==== */
        @media (max-width: 768px) {
            .hero-content h1 {
                font-size: 2.5rem;
            }
            
            .hero-container {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            
            .hero-stats {
                justify-content: center;
            }
            
            .cta-content h2 {
                font-size: 2rem;
            }
            
            .cta-buttons {
                flex-direction: column;
                align-items: center;
            }
            
            .testimonials-grid {
                grid-template-columns: 1fr;
            }
        }
        
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }
        
        .pricing-card {
            background: var(--secondary);
            border-radius: var(--border-radius);
            padding: 2.5rem;
            border: 2px solid transparent;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }
        
        .pricing-card.featured {
            border-color: var(--accent);
            transform: scale(1.05);
        }
        
        .pricing-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
        }
        
        .pricing-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .pricing-name {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--accent);
            margin-bottom: 0.5rem;
        }
        
        .pricing-price {
            font-size: 3rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }
        
        .pricing-period {
            color: var(--light);
            opacity: 0.7;
        }
        
        .pricing-features {
            list-style: none;
            margin-bottom: 2rem;
        }
        
        .pricing-features li {
            padding: 0.5rem 0;
            color: var(--light);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .pricing-features li::before {
            content: '✓';
            color: var(--success);
            font-weight: bold;
        }
        
        /* ==== REFERRAL SECTION ==== */
        .referral {
            padding: 100px 0;
            background: linear-gradient(135deg, var(--secondary) 0%, var(--dark) 100%);
        }
        
        .referral-content {
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }
        
        .referral-content h2 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: var(--accent);
        }
        
        .referral-content p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
            color: var(--light);
            opacity: 0.9;
        }
        
        .referral-benefits {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }
        
        .referral-benefit {
            background: var(--dark);
            padding: 2rem;
            border-radius: var(--border-radius);
            border: 2px solid var(--accent);
        }
        
        .referral-benefit h3 {
            color: var(--accent);
            margin-bottom: 1rem;
        }
        
        /* ==== FOOTER ==== */
        .footer {
            background: var(--secondary);
            padding: 60px 0 20px;
            border-top: 2px solid var(--accent);
        }
        
        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 3rem;
            margin-bottom: 3rem;
        }
        
        .footer-section h3 {
            color: var(--accent);
            margin-bottom: 1.5rem;
            font-size: 1.3rem;
        }
        
        .footer-section ul {
            list-style: none;
        }
        
        .footer-section ul li {
            margin-bottom: 0.5rem;
        }
        
        .footer-section ul li a {
            color: var(--light);
            text-decoration: none;
            transition: var(--transition);
        }
        
        .footer-section ul li a:hover {
            color: var(--accent);
        }
        
        .footer-bottom {
            text-align: center;
            padding-top: 2rem;
            border-top: 1px solid var(--gray);
            color: var(--light);
            opacity: 0.7;
        }
        
        /* ==== RESPONSIVE DESIGN ==== */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }
            
            .hero-container {
                grid-template-columns: 1fr;
                text-align: center;
            }
            
            .hero-content h1 {
                font-size: 2.5rem;
            }
            
            .hero-buttons {
                justify-content: center;
            }
            
            .features-grid {
                grid-template-columns: 1fr;
            }
            
            .pricing-grid {
                grid-template-columns: 1fr;
            }
            
            .pricing-card.featured {
                transform: none;
            }
        }
        
        /* ==== ANIMATIONS ==== */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .animate-fade-in-up {
            animation: fadeInUp 0.6s ease-out;
        }
        
        /* ==== FAQ SECTION ==== */
        .faq {
            padding: 100px 0;
            background: var(--dark);
        }
        
        .faq-item {
            background: var(--secondary);
            margin-bottom: 1rem;
            border-radius: var(--border-radius);
            overflow: hidden;
        }
        
        .faq-question {
            padding: 1.5rem;
            background: var(--secondary);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: var(--transition);
        }
        
        .faq-question:hover {
            background: var(--primary);
        }
        
        .faq-question h3 {
            color: var(--accent);
            margin: 0;
        }
        
        .faq-answer {
            padding: 0 1.5rem 1.5rem;
            color: var(--light);
            opacity: 0.9;
        }
        
        /* ==== STATISTICS SECTION ==== */
        .stats {
            padding: 80px 0;
            background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 2rem;
                text-align: center;
            }
            
        .stat-item {
            color: var(--white);
        }
        
        .stat-number {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
        }
        
        .stat-label {
            font-size: 1.1rem;
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <nav class="nav-container">
            <a href="#" class="logo">
                <img src="{% static 'competitions/logos/logo.png' %}" alt="MartialComp Logo">
                <span>MartialComp</span>
            </a>
            
            <ul class="nav-links">
                <li><a href="#features">{% trans "Fonctionnalités" %}</a></li>
                <li><a href="#pricing">{% trans "Tarifs" %}</a></li>
                <li><a href="#referral">{% trans "Parrainage" %}</a></li>
                <li><a href="#faq">FAQ</a></li>
                <li><a href="#contact">{% trans "Contact" %}</a></li>
            </ul>
            
            <div class="auth-section">
                {% include 'competitions/includes/language_selector.html' %}
                <a href="{% url 'account_login' %}" class="btn btn-outline">{% trans "Connexion" %}</a>
                <a href="{% url 'account_signup' %}" class="btn btn-primary">{% trans "Inscription" %}</a>
            </div>
        </nav>
    </header>
    
    <!-- Hero Section -->
    <section class="hero">
        <!-- Floating elements for visual enhancement -->
        <div class="floating-elements">
            <div class="floating-element"></div>
            <div class="floating-element"></div>
            <div class="floating-element"></div>
            <div class="floating-element"></div>
            <div class="floating-element"></div>
        </div>
        
        <div class="hero-container">
            <div class="hero-content animate-fade-in-up">
                <h1>{% trans "Bienvenue sur MartialComp" %}</h1>
                <p>{% trans "La plateforme complète pour organiser, gérer et participer aux compétitions d'arts martiaux. Une solution tout-en-un pour fédérations, clubs, juges et pratiquants." %}</p>
                <div class="hero-buttons">
                    <a href="#features" class="btn btn-primary">
                        <i class="fas fa-play"></i>
                        {% trans "Découvrir les fonctionnalités" %}
                    </a>
                    <a href="#" class="btn btn-outline" onclick="openLoginModal(); return false;">
                        <i class="fas fa-sign-in-alt"></i>
                        {% trans "Se connecter" %}
                    </a>
                </div>
                
                <!-- Quick stats -->
                <div class="hero-stats" style="margin-top: 2rem; display: flex; gap: 2rem; flex-wrap: wrap;">
                    <div class="stat-item" style="text-align: center;">
                        <div class="stat-number" style="font-size: 2rem; font-weight: 700; color: var(--accent);">{{ total_competitions|default:"0" }}</div>
                        <div class="stat-label" style="font-size: 0.9rem; color: var(--light); opacity: 0.8;">{% trans "Compétitions" %}</div>
                    </div>
                    <div class="stat-item" style="text-align: center;">
                        <div class="stat-number" style="font-size: 2rem; font-weight: 700; color: var(--accent);">{{ total_practitioners|default:"0" }}</div>
                        <div class="stat-label" style="font-size: 0.9rem; color: var(--light); opacity: 0.8;">{% trans "Pratiquants" %}</div>
                    </div>
                    <div class="stat-item" style="text-align: center;">
                        <div class="stat-number" style="font-size: 2rem; font-weight: 700; color: var(--accent);">{{ total_clubs|default:"0" }}</div>
                        <div class="stat-label" style="font-size: 0.9rem; color: var(--light); opacity: 0.8;">{% trans "Clubs" %}</div>
                    </div>
                </div>
                    </div>
            <div class="hero-image animate-fade-in-up">
                <div style="width: 320px; height: 320px; border-radius: 50%; overflow: hidden; margin: 0 auto; box-shadow: 0 0 32px rgba(0,0,0,0.15); background: var(--secondary); display: flex; align-items: center; justify-content: center;">
                    <img src="{% static 'competitions/logos/logo.png' %}" alt="MartialComp Platform" style="width: 90%; height: 90%; object-fit: contain; border-radius: 50%; background: none;">
                        </div>
                        </div>
                    </div>
    </section>

    <!-- Statistics Section -->
    <section class="stats">
        <div class="container">
            <div class="stats-grid">
                    <div class="stat-item">
                    <div class="stat-number">{{ total_clubs|default:"500" }}+</div>
                    <div class="stat-label">{% trans "Clubs Actifs" %}</div>
                    </div>
                    <div class="stat-item">
                    <div class="stat-number">{{ total_practitioners|default:"10000" }}+</div>
                    <div class="stat-label">{% trans "Membres Inscrits" %}</div>
                    </div>
                    <div class="stat-item">
                    <div class="stat-number">{{ total_competitions|default:"200" }}+</div>
                    <div class="stat-label">{% trans "Compétitions Organisées" %}</div>
                    </div>
                <div class="stat-item">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">{% trans "Fédérations Partenaires" %}</div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Testimonials Section -->
    <section class="testimonials" style="padding: 80px 0; background: var(--secondary);">
        <div class="container">
            <div class="section-title">
                <h2>{% trans "Ils nous font confiance" %}</h2>
                <p>{% trans "Découvrez ce que disent nos utilisateurs" %}</p>
            </div>
            
            <div class="testimonials-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem; margin-top: 3rem;">
                <div class="testimonial-card" style="background: var(--dark); padding: 2rem; border-radius: var(--border-radius); border-left: 4px solid var(--accent);">
                    <div class="testimonial-content" style="margin-bottom: 1.5rem;">
                        <p style="color: var(--light); font-style: italic; line-height: 1.6;">{% trans "MartialComp a révolutionné la gestion de notre club. L'organisation des compétitions est maintenant un jeu d'enfant !" %}</p>
                    </div>
                    <div class="testimonial-author" style="display: flex; align-items: center; gap: 1rem;">
                        <div class="author-avatar" style="width: 50px; height: 50px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 600; color: var(--dark);">
                            MS
                        </div>
                        <div>
                            <div class="author-name" style="font-weight: 600; color: var(--accent);">{% trans "Maître Sarah" %}</div>
                            <div class="author-title" style="font-size: 0.9rem; color: var(--light); opacity: 0.8;">{% trans "Directrice, Club de Karaté Excellence" %}</div>
                        </div>
                    </div>
                </div>
                
                <div class="testimonial-card" style="background: var(--dark); padding: 2rem; border-radius: var(--border-radius); border-left: 4px solid var(--accent);">
                    <div class="testimonial-content" style="margin-bottom: 1.5rem;">
                        <p style="color: var(--light); font-style: italic; line-height: 1.6;">{% trans "Le système de notation technique est exceptionnel. Nos juges sont plus efficaces et les résultats sont instantanés." %}</p>
                    </div>
                    <div class="testimonial-author" style="display: flex; align-items: center; gap: 1rem;">
                        <div class="author-avatar" style="width: 50px; height: 50px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 600; color: var(--dark);">
                            PJ
                        </div>
                        <div>
                            <div class="author-name" style="font-weight: 600; color: var(--accent);">{% trans "Professeur Jean" %}</div>
                            <div class="author-title" style="font-size: 0.9rem; color: var(--light); opacity: 0.8;">{% trans "Arbitre International, Fédération de Judo" %}</div>
                        </div>
                    </div>
                </div>
                
                <div class="testimonial-card" style="background: var(--dark); padding: 2rem; border-radius: var(--border-radius); border-left: 4px solid var(--accent);">
                    <div class="testimonial-content" style="margin-bottom: 1.5rem;">
                        <p style="color: var(--light); font-style: italic; line-height: 1.6;">{% trans "La gestion financière intégrée nous fait gagner des heures chaque mois. Tout est automatisé et transparent." %}</p>
                    </div>
                    <div class="testimonial-author" style="display: flex; align-items: center; gap: 1rem;">
                        <div class="author-avatar" style="width: 50px; height: 50px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 600; color: var(--dark);">
                            LM
                        </div>
                        <div>
                            <div class="author-name" style="font-weight: 600; color: var(--accent);">{% trans "Lucie Martin" %}</div>
                            <div class="author-title" style="font-size: 0.9rem; color: var(--light); opacity: 0.8;">{% trans "Trésorière, Dojo Taekwondo" %}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Features Section -->
    <section class="features" id="features">
        <div class="container">
            <div class="section-title">
                <h2>{% trans "Fonctionnalités Principales" %}</h2>
                <p>{% trans "Une suite complète d'outils pour gérer efficacement votre organisation d'arts martiaux" %}</p>
            </div>
            
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h3>{% trans "Gestion des Membres" %}</h3>
                    <p>{% trans "Gérez facilement les profils, licences, grades et progression de tous vos membres avec un système complet de suivi." %}</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <h3>{% trans "Organisation de Compétitions" %}</h3>
                    <p>{% trans "Créez et gérez des compétitions complètes avec inscriptions, catégories, arbitrage et résultats en temps réel." %}</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-coins"></i>
                    </div>
                    <h3>{% trans "Gestion Financière" %}</h3>
                    <p>{% trans "Suivez les cotisations, paiements, dépenses et générez des rapports financiers détaillés pour votre club." %}</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <h3>{% trans "Boutique en Ligne" %}</h3>
                    <p>{% trans "Vendez équipements, tenues et accessoires directement depuis votre plateforme avec gestion des stocks." %}</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-certificate"></i>
                    </div>
                    <h3>{% trans "Système de Grades" %}</h3>
                    <p>{% trans "Gérez les passages de grades, certifications et suivez la progression technique de vos pratiquants." %}</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h3>{% trans "Formation & Certification" %}</h3>
                    <p>{% trans "Organisez des formations, stages et délivrez des certifications reconnues par les fédérations." %}</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3>{% trans "Analytics & Rapports" %}</h3>
                    <p>{% trans "Analysez les performances, générez des statistiques et prenez des décisions éclairées avec nos outils d'analyse." %}</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h3>{% trans "Application Mobile" %}</h3>
                    <p>{% trans "Accédez à toutes les fonctionnalités depuis votre smartphone avec notre application mobile native." %}</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3>{% trans "Sécurité & Conformité" %}</h3>
                    <p>{% trans "Vos données sont protégées avec des standards de sécurité élevés et conformité RGPD garantie." %}</p>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Pricing Section -->
    <section class="pricing" id="pricing">
        <div class="container">
            <div class="section-title">
                <h2>{% trans "Tarification Transparente par Utilisateur" %}</h2>
                <p>{% trans "Une tarification équitable adaptée au pouvoir d'achat de chaque région" %}</p>
            </div>
            
            <div class="pricing-grid">
                <div class="pricing-card">
                    <div class="pricing-header">
                        <div class="pricing-name">{% trans "Dojo Essentials" %}</div>
                        <div class="pricing-price">3,99€</div>
                        <div class="pricing-period">{% trans "/utilisateur/an (Afrique - Référence)" %}</div>
                    </div>
                    <ul class="pricing-features">
                        <li>{% trans "Jusqu'à 100 membres" %}</li>
                        <li>{% trans "2 disciplines maximum" %}</li>
                        <li>{% trans "Authentification sécurisée" %}</li>
                        <li>{% trans "Profils des pratiquants" %}</li>
                        <li>{% trans "Gestion des grades (basique)" %}</li>
                        <li>{% trans "Système de licences" %}</li>
                        <li>{% trans "Calendrier des événements" %}</li>
                        <li style="color: #adb5bd; text-decoration: line-through;">{% trans "Historique médical" %}</li>
                        <li style="color: #adb5bd; text-decoration: line-through;">{% trans "Système de notation" %}</li>
                        <li style="color: #adb5bd; text-decoration: line-through;">{% trans "Combat en temps réel" %}</li>
                    </ul>
                    <a href="#" class="btn btn-primary">{% trans "Commencer" %}</a>
                </div>
                
                <div class="pricing-card featured">
                    <div class="pricing-header">
                        <div class="pricing-name">{% trans "Master's Circle" %}</div>
                        <div class="pricing-price">7,98€</div>
                        <div class="pricing-period">{% trans "/utilisateur/an (Afrique - Référence)" %}</div>
                    </div>
                    <ul class="pricing-features">
                        <li>{% trans "Jusqu'à 300 membres" %}</li>
                        <li>{% trans "5 disciplines maximum" %}</li>
                        <li>{% trans "Toutes les fonctionnalités Dojo Essentials" %}</li>
                        <li>{% trans "Historique médical complet" %}</li>
                        <li>{% trans "Création de compétitions" %}</li>
                        <li>{% trans "Système de notation simple" %}</li>
                        <li>{% trans "Combat basique" %}</li>
                        <li>{% trans "QR Scanner avancé" %}</li>
                        <li>{% trans "Multi-clubs (3 maximum)" %}</li>
                        <li style="color: #adb5bd; text-decoration: line-through;">{% trans "Combat temps réel avancé" %}</li>
                    </ul>
                    <a href="#" class="btn btn-primary">{% trans "Choisir ce Plan" %}</a>
                </div>
                
                <div class="pricing-card">
                    <div class="pricing-header">
                        <div class="pricing-name">{% trans "Grand Champion" %}</div>
                        <div class="pricing-price">11,97€</div>
                        <div class="pricing-period">{% trans "/utilisateur/an (Afrique - Référence)" %}</div>
                    </div>
                    <ul class="pricing-features">
                        <li>{% trans "Membres illimités" %}</li>
                        <li>{% trans "Disciplines illimitées" %}</li>
                        <li>{% trans "Toutes les fonctionnalités précédentes" %}</li>
                        <li>{% trans "Notation technique avancée" %}</li>
                        <li>{% trans "Combat temps réel complet" %}</li>
                        <li>{% trans "Streaming live intégré" %}</li>
                        <li>{% trans "Boutique e-commerce" %}</li>
                        <li>{% trans "Branding personnalisé" %}</li>
                        <li>{% trans "Sous-domaines illimités" %}</li>
                        <li>{% trans "Analytics et IA avancées" %}</li>
                    </ul>
                    <a href="#" class="btn btn-primary">{% trans "Accès Elite" %}</a>
                </div>
            </div>
            
            <!-- Package Compétition -->
            <div style="margin-top: 4rem;">
                <div style="background: var(--secondary); padding: 2rem; border-radius: var(--border-radius); border: 2px solid var(--accent);">
                    <h3 style="color: var(--accent); margin-bottom: 1rem; text-align: center;">
                        <i class="fas fa-trophy me-2"></i>{% trans "Package Compétition (Organisateurs Externes)" %}
                    </h3>
                    <p style="color: var(--light); text-align: center; margin-bottom: 2rem;">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>{% trans "Facturation spéciale par utilisation" %}</strong><br>
                        {% trans "Contrairement aux autres packages, le package compétition est facturé par participant et par compétition organisée." %}
                    </p>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center;">
                        <div>
                            <h5 style="color: var(--accent); margin-bottom: 1rem;">
                                <i class="fas fa-calculator me-2"></i>{% trans "Tarification Simple" %}
                            </h5>
                            <ul style="color: var(--light); list-style: none; padding: 0;">
                                <li style="margin-bottom: 0.5rem;">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <strong>{% trans "2.99€ par participant par compétition" %}</strong>
                                </li>
                                <li style="margin-bottom: 0.5rem;">
                                    <i class="fas fa-check text-success me-2"></i>
                                    {% trans "Pas d'abonnement mensuel ou annuel" %}
                                </li>
                                <li style="margin-bottom: 0.5rem;">
                                    <i class="fas fa-check text-success me-2"></i>
                                    {% trans "Paiement uniquement lors de l'organisation d'événements" %}
                                </li>
                                <li style="margin-bottom: 0.5rem;">
                                    <i class="fas fa-check text-success me-2"></i>
                                    {% trans "Accès à toutes les fonctionnalités de compétition" %}
                                </li>
                            </ul>
                        </div>
                        <div style="text-align: center;">
                            <div style="background: var(--dark); padding: 1.5rem; border-radius: var(--border-radius); border: 2px solid var(--accent);">
                                <div style="font-size: 2rem; font-weight: bold; color: var(--accent);">2.99€</div>
                                <div style="color: var(--light); font-size: 0.9rem;">{% trans "/participant" %}</div>
                                <div style="color: var(--light); opacity: 0.8; font-size: 0.8rem; margin-top: 0.5rem;">
                                    {% trans "Exemple: 100 participants" %}<br>
                                    <strong>{% trans "299€ par compétition" %}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Tarification par région -->
            <div style="margin-top: 4rem;">
                <h3 style="text-align: center; color: var(--accent); margin-bottom: 2rem;">{% trans "Tarification par Région" %}</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
                    <div style="background: var(--secondary); padding: 1.5rem; border-radius: var(--border-radius); border: 1px solid var(--accent);">
                        <h4 style="color: var(--accent); margin-bottom: 1rem;">{% trans "Afrique (Référence)" %}</h4>
                        <p style="color: var(--light); opacity: 0.8;">{% trans "Dojo Essentials: 3,99€ | Master's Circle: 7,98€ | Grand Champion: 11,97€" %}</p>
                    </div>
                    <div style="background: var(--secondary); padding: 1.5rem; border-radius: var(--border-radius); border: 1px solid var(--accent);">
                        <h4 style="color: var(--accent); margin-bottom: 1rem;">{% trans "Europe de l'Est" %}</h4>
                        <p style="color: var(--light); opacity: 0.8;">{% trans "Dojo Essentials: 5,99€ | Master's Circle: 11,98€ | Grand Champion: 17,97€" %}</p>
                    </div>
                    <div style="background: var(--secondary); padding: 1.5rem; border-radius: var(--border-radius); border: 1px solid var(--accent);">
                        <h4 style="color: var(--accent); margin-bottom: 1rem;">{% trans "Asie du Sud-Est" %}</h4>
                        <p style="color: var(--light); opacity: 0.8;">{% trans "Dojo Essentials: 6,99€ | Master's Circle: 13,98€ | Grand Champion: 20,97€" %}</p>
                    </div>
                    <div style="background: var(--secondary); padding: 1.5rem; border-radius: var(--border-radius); border: 1px solid var(--accent);">
                        <h4 style="color: var(--accent); margin-bottom: 1rem;">{% trans "Europe de l'Ouest" %}</h4>
                        <p style="color: var(--light); opacity: 0.8;">{% trans "Dojo Essentials: 7,98€ | Master's Circle: 15,96€ | Grand Champion: 23,94€" %}</p>
                    </div>
                    <div style="background: var(--secondary); padding: 1.5rem; border-radius: var(--border-radius); border: 1px solid var(--accent);">
                        <h4 style="color: var(--accent); margin-bottom: 1rem;">{% trans "Amérique du Nord" %}</h4>
                        <p style="color: var(--light); opacity: 0.8;">{% trans "Dojo Essentials: 9,98€ | Master's Circle: 19,96€ | Grand Champion: 29,94€" %}</p>
                    </div>
                    <div style="background: var(--secondary); padding: 1.5rem; border-radius: var(--border-radius); border: 1px solid var(--accent);">
                        <h4 style="color: var(--accent); margin-bottom: 1rem;">{% trans "Océanie" %}</h4>
                        <p style="color: var(--light); opacity: 0.8;">{% trans "Dojo Essentials: 9,98€ | Master's Circle: 19,96€ | Grand Champion: 29,94€" %}</p>
                    </div>
                </div>
            </div>
            
            <!-- Dégressivité par volume -->
            <div style="margin-top: 3rem; text-align: center;">
                <h3 style="color: var(--accent); margin-bottom: 1.5rem;">{% trans "Réductions par Volume" %}</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; max-width: 800px; margin: 0 auto;">
                    <div style="background: var(--dark); padding: 1rem; border-radius: var(--border-radius);">
                        <div style="font-size: 1.5rem; font-weight: bold; color: var(--success);">-5%</div>
                        <div style="color: var(--light);">{% trans "51-100 utilisateurs" %}</div>
                    </div>
                    <div style="background: var(--dark); padding: 1rem; border-radius: var(--border-radius);">
                        <div style="font-size: 1.5rem; font-weight: bold; color: var(--success);">-10%</div>
                        <div style="color: var(--light);">{% trans "101-250 utilisateurs" %}</div>
                    </div>
                    <div style="background: var(--dark); padding: 1rem; border-radius: var(--border-radius);">
                        <div style="font-size: 1.5rem; font-weight: bold; color: var(--success);">-15%</div>
                        <div style="color: var(--light);">{% trans "251+ utilisateurs" %}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Referral Section -->
    <section class="referral" id="referral">
        <div class="container">
            <div class="referral-content">
                <h2>{% trans "Programme de Commission pour Fédérations" %}</h2>
                <p>{% trans "Les fédérations affiliées bénéficient d'une commission de 7% sur les abonnements de leurs clubs membres. Un système gagnant-gagnant pour développer la communauté des arts martiaux." %}</p>
                
                <div class="referral-benefits">
                    <div class="referral-benefit">
                        <h3>{% trans "Commission de 7%" %}</h3>
                        <p>{% trans "Recevez 7% du montant payé par chaque club affilié lors de leur premier abonnement annuel." %}</p>
            </div>
            
                    <div class="referral-benefit">
                        <h3>{% trans "Portefeuille Virtuel" %}</h3>
                        <p>{% trans "Les commissions sont automatiquement créditées dans votre portefeuille virtuel pour utilisation ou retrait." %}</p>
                    </div>
                    
                    <div class="referral-benefit">
                        <h3>{% trans "Croissance Organique" %}</h3>
                        <p>{% trans "Plus vous développez votre réseau de clubs, plus vos revenus de commission augmentent naturellement." %}</p>
                    </div>
                </div>
                
                <div style="margin-top: 3rem;">
                    <a href="#" class="btn btn-primary">
                        <i class="fas fa-handshake"></i>
                        {% trans "Devenir Fédération Partenaire" %}
                    </a>
                    </div>
                    </div>
                </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq" id="faq">
        <div class="container">
            <div class="section-title">
                <h2>{% trans "Questions Fréquentes" %}</h2>
                <p>{% trans "Trouvez rapidement les réponses à vos questions" %}</p>
            </div>
            
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Comment démarrer avec MartialComp ?" %}</h3>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                    <p>{% trans "Créez votre compte, configurez votre club et invitez vos membres. Notre équipe vous accompagne dans la prise en main." %}</p>
                    </div>
                </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Puis-je migrer mes données existantes ?" %}</h3>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                    <p>{% trans "Oui, nous proposons un service de migration gratuit pour transférer vos données depuis d'autres systèmes vers MartialComp." %}</p>
                    </div>
                </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Quels sont les moyens de paiement acceptés ?" %}</h3>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                    <p>{% trans "Nous acceptons les cartes bancaires, virements SEPA, PayPal et les prélèvements automatiques pour les abonnements." %}</p>
                    </div>
                </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "La plateforme est-elle conforme RGPD ?" %}</h3>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                    <p>{% trans "Oui, MartialComp respecte strictement le RGPD avec chiffrement des données, droit à l'oubli et consentement explicite." %}</p>
                    </div>
                </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Puis-je personnaliser l'interface ?" %}</h3>
                    <i class="fas fa-chevron-down"></i>
            </div>
                <div class="faq-answer">
                    <p>{% trans "Oui, vous pouvez personnaliser les couleurs, logos, textes et même créer votre propre sous-domaine pour une expérience sur mesure." %}</p>
        </div>
                        </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Comment fonctionne la gestion multi-club et multi-fédération ?" %}</h3>
                    <i class="fas fa-chevron-down"></i>
                    </div>
                <div class="faq-answer">
                    <p>{% trans "MartialComp permet de gérer plusieurs clubs et fédérations depuis un seul compte administrateur, avec des accès et droits personnalisés." %}</p>
                    </div>
                </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Comment la sécurité de mes données est-elle assurée ?" %}</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p>{% trans "Vos données sont hébergées en Europe, chiffrées et sauvegardées quotidiennement. L'accès est protégé par authentification forte." %}</p>
                </div>
                </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Quel support est disponible ?" %}</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p>{% trans "Support par email, chat et téléphone selon votre formule. Documentation et tutoriels vidéo accessibles 24/7." %}</p>
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Comment fonctionne la facturation et les réductions ?" %}</h3>
                    <i class="fas fa-chevron-down"></i>
                    </div>
                <div class="faq-answer">
                    <p>{% trans "La facturation est annuelle, avec réductions automatiques selon le nombre de membres. Les factures sont téléchargeables depuis votre espace." %}</p>
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Puis-je accéder à la plateforme sur mobile ?" %}</h3>
                    <i class="fas fa-chevron-down"></i>
        </div>
                <div class="faq-answer">
                    <p>{% trans "Oui, une application mobile dédiée est disponible pour iOS et Android, avec toutes les fonctionnalités principales." %}</p>
                    </div>
                    </div>
            <div class="faq-item">
                <div class="faq-question">
                    <h3>{% trans "Comment parrainer un club ou une fédération ?" %}</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p>{% trans "Depuis votre espace, générez un lien de parrainage ou invitez directement un club. Les commissions sont créditées automatiquement." %}</p>
                    </div>
                    </div>
                </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" style="padding: 100px 0; background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); position: relative; overflow: hidden;">
        <div class="container">
            <div class="cta-content" style="text-align: center; position: relative; z-index: 2;">
                <h2 style="font-size: 3rem; font-weight: 700; color: var(--white); margin-bottom: 1.5rem;">{% trans "Prêt à révolutionner votre club ?" %}</h2>
                <p style="font-size: 1.2rem; color: var(--white); opacity: 0.9; margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto;">{% trans "Rejoignez des centaines de clubs qui font déjà confiance à MartialComp pour gérer leurs compétitions et leurs membres." %}</p>
                
                <div class="cta-buttons" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="#" class="btn" style="background: var(--white); color: var(--primary); font-weight: 600; padding: 1rem 2rem; border-radius: var(--border-radius); text-decoration: none; transition: all 0.3s ease;" onclick="openLoginModal(); return false;">
                        <i class="fas fa-rocket" style="margin-right: 0.5rem;"></i>
                        {% trans "Commencer gratuitement" %}
                    </a>
                    <a href="#features" class="btn" style="background: transparent; color: var(--white); border: 2px solid var(--white); font-weight: 600; padding: 1rem 2rem; border-radius: var(--border-radius); text-decoration: none; transition: all 0.3s ease;">
                        <i class="fas fa-play" style="margin-right: 0.5rem;"></i>
                        {% trans "Voir la démo" %}
                    </a>
                </div>
                
                <div class="cta-features" style="margin-top: 3rem; display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap;">
                    <div class="cta-feature" style="text-align: center; color: var(--white);">
                        <i class="fas fa-check-circle" style="font-size: 2rem; margin-bottom: 0.5rem;"></i>
                        <div style="font-weight: 600;">{% trans "Essai gratuit 30 jours" %}</div>
                    </div>
                    <div class="cta-feature" style="text-align: center; color: var(--white);">
                        <i class="fas fa-shield-alt" style="font-size: 2rem; margin-bottom: 0.5rem;"></i>
                        <div style="font-weight: 600;">{% trans "Sécurité garantie" %}</div>
                    </div>
                    <div class="cta-feature" style="text-align: center; color: var(--white);">
                        <i class="fas fa-headset" style="font-size: 2rem; margin-bottom: 0.5rem;"></i>
                        <div style="font-weight: 600;">{% trans "Support 24/7" %}</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Background decoration -->
        <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.1;">
            <div style="position: absolute; top: 20%; left: 10%; width: 100px; height: 100px; border: 2px solid var(--white); border-radius: 50%;"></div>
            <div style="position: absolute; top: 60%; right: 15%; width: 150px; height: 150px; border: 2px solid var(--white); border-radius: 50%;"></div>
            <div style="position: absolute; bottom: 20%; left: 20%; width: 80px; height: 80px; border: 2px solid var(--white); border-radius: 50%;"></div>
                </div>
    </section>

    <!-- Footer -->
