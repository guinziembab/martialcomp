# Configuration de production pour MartialComp
# Copiez ce fichier vers .env.production et modifiez les valeurs

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False

# Base de données PostgreSQL
DB_NAME=martialcomp_prod
DB_USER=martialcomp_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@martialcomp.com

# Sécurité
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Monitoring (optionnel)
SENTRY_DSN=your-sentry-dsn-if-using-sentry

# Domaine autorisé pour les emails (optionnel)
ALLOWED_EMAIL_DOMAINS=your-domain.com,partner-domain.com

# Configuration des tests
RUNNING_TESTS=False
